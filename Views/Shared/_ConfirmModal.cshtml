<div id="appConfirmModal" class="custom-modal-overlay" aria-hidden="true">
    <div class="custom-modal-card" role="dialog" aria-modal="true" aria-labelledby="appConfirmTitle">
        <div class="custom-modal-icon"><i id="appConfirmIcon"></i></div>
        <h3 id="appConfirmTitle" class="custom-modal-title"></h3>
        <p id="appConfirmMessage" class="custom-modal-desc"></p>
        <div class="custom-modal-actions">
            <button type="button" id="appConfirmCancel" class="custom-modal-btn btn-cancel">انصراف</button>
            <button type="button" id="appConfirmOk" class="custom-modal-btn btn-exit">تایید</button>
        </div>
    </div>
</div>
