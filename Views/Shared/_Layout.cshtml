@inject Resturanyar.Data.AppDbContext AppDbContext
@using Microsoft.EntityFrameworkCore
@{
    var layoutRestaurantName = RestaurantViewHelper.ResolveRestaurantName(User, AppDbContext, ViewBag.RestaurantName);
    var layoutPageTitle = PageTitleHelper.WithRestaurant(ViewData["Title"]?.ToString(), layoutRestaurantName);
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@layoutPageTitle - رستورانیار دلاویتا</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/bootstrap_rtl_min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fntawsom600.css" />
    <link rel="stylesheet" href="~/css/bootstrap-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="~/resturanyar.styles.css" asp-append-version="true" /> *@
    <link rel="stylesheet" href="~/css/share.css" asp-append-version="true" />
    <meta name="theme-color" content="#FF7A00">
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    @await RenderSectionAsync("Styles", required: false)
    <script>
        (function () {
            try {
                if (window.innerWidth > 768 && localStorage.getItem('sidebarCollapsed') === 'true') {
                    document.documentElement.classList.add('sidebar-is-collapsed');
                }
            } catch (e) { }
        })();
    </script>
</head>
<body data-restaurant-id="@(User.GetRestaurantId()?.ToString() ?? "")" data-restaurant-name="@layoutRestaurantName">

    @if (User.Identity.IsAuthenticated)
    {
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        <!-- Mobile Menu Button -->
        @* <button class="mobile-menu-btn" onclick="toggleMobileSidebar()">
            <i class="fas fa-bars"></i>
        </button> *@

        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <a href="/" class="sidebar-logo">
                    <img src="~/images/logo.png" alt="لوگو" class="sidebar-logo-img">
                    <span class="sidebar-logo-text">رستورانیار</span>
                </a>
            </div>

            <nav class="sidebar-nav">
                <a href="/home/Dashboard" class="nav-item @(currentAction == "Dashboard" ? "active" : "")">
                    <i class="fas fa-home"></i>
                    <span>داشبورد</span>
                </a>
                <a href="@Url.Action("ManageStaff", "Home")" class="nav-item @(currentAction == "ManageStaff" ? "active" : "")">
                    <i class="fas fa-users"></i>
                    <span>مدیریت کارکنان</span>
                </a>
                <a href="@Url.Action("FoodList", "Home")" class="nav-item @(currentAction == "FoodList" ? "active" : "")">
                    <i class="fas fa-utensils"></i>
                    <span>لیست غذاها</span>
                </a>
                <a href="@Url.Action("AddOrder", "Home")" class="nav-item @(currentAction == "AddOrder" ? "active" : "")">
                    <i class="fas fa-cart-plus"></i>
                    <span>ثبت سفارش جدید</span>
                </a>
                <a href="@Url.Action("ManagerOrderList", "Home")" class="nav-item @(currentAction == "ManagerOrderList" ? "active" : "")">
                    <i class="fas fa-clipboard-check"></i>
                    <span>لیست سفارشات</span>
                </a>
                <a href="@Url.Action("CategoryList", "Home")" class="nav-item @(currentAction == "CategoryList" ? "active" : "")">
                    <i class="fas fa-layer-group"></i>
                    <span>مدیریت دسته بندی ها</span>
                </a>
                <a href="@Url.Action("TableList", "Home")" class="nav-item @(currentAction == "TableList" ? "active" : "")">
                    <i class="fas fa-chair"></i>
                    <span>مدیریت میزها</span>
                </a>
                <a href="@Url.Action("CustomersList", "Home")" class="nav-item @(currentAction == "CustomersList" ? "active" : "")">
                    <i class="fas fa-address-book"></i>
                    <span>مدیریت و آنالیز مشتریان</span>
                </a>
               
                <a href="@Url.Action("RestaurantMenu", "Menu")" class="nav-item @(currentController == "Menu" && currentAction == "RestaurantMenu" ? "active" : "")">
                    <i class="fas fa-book-open"></i>
                    <span>منو</span>
                </a>
                <a href="@Url.Action("PublicMenuQRCode", "Menu")" class="nav-item @(currentController == "Menu" && currentAction == "PublicMenuQRCode" ? "active" : "")">
                    <i class="fas fa-qrcode"></i>
                    <span>منوی عمومی</span>
                </a>
                <a href="@Url.Action("ManagerReports", "Home", new { period = "month" })" class="nav-item @(currentAction == "ManagerReports" ? "active" : "")">
                    <i class="fas fa-chart-line"></i>
                    <span>گزارش گیری</span>
                </a>
                <!-- آیتم اشتراک رستوران -->
                <a href="@Url.Action("RestaurantSubscription", "Home")" class="nav-item @(currentAction == "RestaurantSubscription" ? "active" : "")">
                    <i class="fas fa-crown"></i>
                    <span>اشتراک رستوران</span>
                </a>

                <!-- آیتم پیام‌ها -->
                <a href="@Url.Action("Messages", "Home")"
                   class="nav-item @(currentAction == "Messages" ? "active" : "")"
                   id="navMessages">
                    <i class="fas fa-envelope"></i>
                    <span>پیام‌ها</span>
                    <span id="navMessagesBadge" class="nav-item-badge" hidden></span>
                </a>

                <!-- آیتم پشتیبانی -->
                <a href="@Url.Action("Support", "Home")" class="nav-item @(currentAction == "Support" ? "active" : "")">
                    <i class="fas fa-headset"></i>
                    <span>پشتیبانی</span>
                </a>
                <a href="@Url.Action("Settings", "Home")" class="nav-item @(currentAction == "Settings" ? "active" : "")">
                    <i class="fas fa-cog"></i>
                    <span>تنظیمات رستوران</span>
                </a>
                <div class="sidebar-footer">
                    <form method="post" asp-controller="Home" asp-action="Logout" id="sidebarLogoutForm">
                        <button type="submit" class="logout-btn">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>خروج</span>
                        </button>
                    </form>
                </div>
            </nav>

            
        </aside>

        <!-- Main Content -->
        <main class="main-content" id="mainContent">
            <!-- Topbar / Header -->
            <!-- Topbar / Header -->
            <header class="topbar">
                <!-- سمت چپ: عنوان صفحه + دکمه موبایل -->
                <div class="topbar-left">
                    <button type="button"
                            class="sidebar-desktop-toggle"
                            data-sidebar-toggle
                            aria-label="جمع/باز کردن منو"
                            aria-expanded="true"
                            title="جمع کردن منو">
                        <i class="fas fa-outdent"></i>
                    </button>
                    <button class="mobile-menu-btn" onclick="toggleMobileSidebar()" type="button" aria-label="باز کردن منو">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div class="page-title">
                        @* <i class="@(ViewData["PageIcon"]?.ToString() ?? "fas fa-home")"></i> *@
                        <span>@layoutPageTitle</span>
                    </div>
                </div>

                <!-- وسط: جستجو -->
              

                <!-- سمت راست: دکمه‌های عملیاتی + پروفایل -->
                <div class="topbar-actions">
                    <button id="ownerMessageBtn" class="action-btn" type="button" title="پیام‌ها">
                        <i class="fas fa-bell"></i>
                        <span id="ownerMessageBadge" class="owner-msg-badge" hidden></span>
                    </button>

                    <div class="user-profile" >
                        <div class="user-avatar icon-only">
                            <i class="fas fa-user-circle"></i>
                        </div>
                        <div>
                            <span class="user-name">@(User.Identity.Name ?? "کاربر گرامی")</span>
                            <span class="user-role">مدیر</span>
                        </div>
                        @* <i class="fas fa-chevron-down dropdown-icon"></i> *@
                    </div>

                
                </div>
            </header>

            <div class="page-wrapper">
                <div class="content-card" id="contentCard">
                    @RenderBody()
                </div>
            </div>

            <!-- Footer -->
            <footer class="footer">
                <div class="footer-content">
                    <img src="~/images/logo_circle.png" alt="لوگو" class="footer-logo">
                    <p class="footer-text">
                        با رستوران‌یار دلاویتا، مدیریت کافه | رستوران شما ساده، دقیق و لذت‌بخش است.
                    </p>
                    <p class="footer-copyright">
                        © 2026 رستورانیار دلاویتا - تمامی حقوق محفوظ است
                    </p>
                </div>
            </footer>
        </main>

        <script>
                        window.addEventListener('scroll', function() {
                const topbar = document.querySelector('.topbar');
                if (window.scrollY > 10) {
                    topbar.classList.add('scrolled');
                } else {
                    topbar.classList.remove('scrolled');
                }
            });
            function isDesktopSidebar() {
                return window.innerWidth > 768;
            }

            function updateSidebarToggleState(collapsed) {
                document.querySelectorAll('[data-sidebar-toggle]').forEach(function (btn) {
                    btn.classList.toggle('is-collapsed', collapsed);
                    btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
                    btn.setAttribute('title', collapsed ? 'باز کردن منو' : 'جمع کردن منو');
                    var icon = btn.querySelector('i');
                    if (icon) {
                        icon.className = collapsed ? 'fas fa-indent' : 'fas fa-outdent';
                    }
                });
            }

            function setSidebarCollapsed(collapsed, persist) {
                var sidebar = document.getElementById('sidebar');
                if (!sidebar || !isDesktopSidebar()) return;

                var isCollapsed = sidebar.classList.contains('collapsed');
                if (isCollapsed === collapsed) {
                    document.documentElement.classList.toggle('sidebar-is-collapsed', collapsed);
                    updateSidebarToggleState(collapsed);
                    return;
                }

                sidebar.classList.toggle('collapsed', collapsed);
                document.documentElement.classList.toggle('sidebar-is-collapsed', collapsed);
                if (persist !== false) {
                    localStorage.setItem('sidebarCollapsed', collapsed ? 'true' : 'false');
                }
                updateSidebarToggleState(collapsed);
            }

            function toggleSidebar(event) {
                if (event) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                if (!isDesktopSidebar()) return;

                var sidebar = document.getElementById('sidebar');
                if (!sidebar) return;
                setSidebarCollapsed(!sidebar.classList.contains('collapsed'));
            }

            function toggleMobileSidebar(event) {
                if (event) {
                    event.preventDefault();
                    event.stopPropagation();
                }

                var sidebar = document.getElementById('sidebar');
                var mobileBtn = document.querySelector('.mobile-menu-btn');
                if (!sidebar) return;

                sidebar.classList.toggle('open');
                var isOpen = sidebar.classList.contains('open');
                if (mobileBtn) {
                    mobileBtn.classList.toggle('open', isOpen);
                }
            }

            function loadSidebarState() {
                if (!isDesktopSidebar()) return;
                setSidebarCollapsed(localStorage.getItem('sidebarCollapsed') === 'true', false);
            }

            document.querySelectorAll('[data-sidebar-toggle]').forEach(function (btn) {
                btn.addEventListener('click', toggleSidebar);
            });

            loadSidebarState();

            var sidebarLayoutMode = isDesktopSidebar() ? 'desktop' : 'mobile';
            window.addEventListener('resize', function () {
                var sidebar = document.getElementById('sidebar');
                if (!sidebar) return;

                var desktop = isDesktopSidebar();
                var mode = desktop ? 'desktop' : 'mobile';
                if (mode === sidebarLayoutMode) return;

                sidebarLayoutMode = mode;
                if (desktop) {
                    sidebar.classList.remove('open');
                    document.querySelector('.mobile-menu-btn')?.classList.remove('open');
                    loadSidebarState();
                } else {
                    sidebar.classList.remove('collapsed');
                    document.documentElement.classList.remove('sidebar-is-collapsed');
                    updateSidebarToggleState(false);
                }
            });

            // Theme Functions
            function toggleTheme() {
                const html = document.documentElement;
                const currentTheme = html.getAttribute('data-theme');
                const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                html.setAttribute('data-theme', newTheme);
                localStorage.setItem('theme', newTheme);

                const themeIcon = document.querySelector('#themeToggle i');
                if (newTheme === 'dark') {
                    themeIcon.className = 'fas fa-sun';
                } else {
                    themeIcon.className = 'fas fa-moon';
                }
            }

            // Load saved theme
            const savedTheme = localStorage.getItem('theme');
            if (savedTheme) {
                document.documentElement.setAttribute('data-theme', savedTheme);
                const themeIcon = document.querySelector('#themeToggle i');
                if (savedTheme === 'dark') {
                    themeIcon.className = 'fas fa-sun';
                }
            }

            // Close mobile sidebar when clicking outside
            document.addEventListener('click', function (event) {
                var sidebar = document.getElementById('sidebar');
                var mobileBtn = document.querySelector('.mobile-menu-btn');

                if (!sidebar || isDesktopSidebar() || !sidebar.classList.contains('open')) return;

                if (!sidebar.contains(event.target) && !(mobileBtn && mobileBtn.contains(event.target))) {
                    sidebar.classList.remove('open');
                    mobileBtn?.classList.remove('open');
                }
            });

            // Active link highlighting (fallback for full page loads)
            document.querySelectorAll('.sidebar-nav a.nav-item').forEach(function (link) {
                try {
                    var linkPath = new URL(link.href, window.location.origin).pathname.toLowerCase();
                    var currentPath = window.location.pathname.toLowerCase();
                    link.classList.toggle('active', linkPath === currentPath);
                } catch (e) { /* ignore */ }
            });

           
            function updateClock() {
                const clockElement = document.getElementById('dashClock');
                if (clockElement) {
                    const now = new Date();
                    const timeString = now.toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit' });
                    clockElement.textContent = timeString;
                }
            }
            setInterval(updateClock, 1000);
            updateClock();


        </script>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await Html.PartialAsync("_ConfirmModal")
    <script src="~/js/confirm-modal.js" asp-append-version="true"></script>
    <script src="~/js/app-toast.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof wireLogoutConfirm === 'function') {
                wireLogoutConfirm('#sidebarLogoutForm');
            }
        });
    </script>
    <script>
                // ذخیره موقعیت اسکرول سایدبار قبل از خروج از صفحه
        window.addEventListener('beforeunload', function () {
            const sidebar = document.getElementById('sidebar');
            if (sidebar) {
                localStorage.setItem('sidebarScrollPos', sidebar.scrollTop);
            }
        });

        // بازیابی موقعیت اسکرول بعد از بارگذاری کامل صفحه
        window.addEventListener('load', function () {
            const sidebar = document.getElementById('sidebar');
            const savedPos = localStorage.getItem('sidebarScrollPos');
            if (sidebar && savedPos !== null) {
                sidebar.scrollTop = parseInt(savedPos, 10);
                localStorage.removeItem('sidebarScrollPos'); // پاک کردن بعد از استفاده
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    @if (User.Identity?.IsAuthenticated == true && User.GetRestaurantId() != null)
    {
        <script type="module">
            import { fetchWithAuth } from '/js/authentication/apiinterceptor.js';
            window.fetchWithAuth = fetchWithAuth;
        </script>
        <script type="module" src="~/js/owner-messages.js" asp-append-version="true"></script>
        <script src="~/js/sidebar-nav.js" asp-append-version="true"></script>
        <script>
            $(function () {
                if (typeof window.runSidebarPageInit === 'function') {
                    window.runSidebarPageInit();
                }
            });
        </script>
    }

</body>
</html>
