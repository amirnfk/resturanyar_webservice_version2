@model resturanyar.Models.ViewModels.ReceiptChargeSettingsViewModel
@using resturanyar.Models.Receipt
@{
    ViewData["Title"] = "تنظیمات کارمزد فاکتور";
}

@section Styles {
    <link rel="stylesheet" href="~/css/restaurant-settings.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/receipt-charge-settings.css" asp-append-version="true" />
}

<div class="settings-page receipt-charge-settings-page" data-restaurant-id="@Model.RestaurantId">
    <header class="settings-header">
        <div class="icon-circle">
            <i class="fas fa-file-invoice-dollar"></i>
        </div>
        <div>
            <h2>تنظیمات کارمزد فاکتور</h2>
            <p class="text-muted mb-0">الگوی پیش‌فرض کارمزدها برای @Model.RestaurantName — مبلغ نهایی هنگام صدور فاکتور ثبت و قفل می‌شود.</p>
        </div>
    </header>

    <div class="receipt-charge-notice">
        <i class="fas fa-circle-info"></i>
        <div>
            <strong>نحوه کار:</strong>
            این تنظیمات فقط الگوی اولیه چاپ فاکتور است. هنگام «چاپ فاکتور» در لیست سفارش‌ها می‌توانید هر مورد را فعال/غیرفعال کنید.
            پس از اولین صدور، همان مبالغ برای چاپ‌های بعدی ثابت می‌ماند.
        </div>
    </div>

    <div class="settings-card">
        <div class="settings-card__title">
            <i class="fas fa-sliders"></i>
            <span>کارمزدها و مالیات</span>
        </div>

        <div id="chargeDefinitionsList" class="charge-definitions-list">
            @for (var i = 0; i < Model.Definitions.Count; i++)
            {
                var def = Model.Definitions[i];
                <article class="charge-definition-card" data-id="@def.Id" data-index="@i">
                    <div class="charge-definition-card__head">
                        <div class="charge-definition-card__title-wrap">
                            <span class="charge-definition-card__badge @GetCategoryClass(def.ChargeCategory)">@GetCategoryLabel(def.ChargeCategory)</span>
                            <strong class="charge-definition-card__code">@def.Code</strong>
                        </div>
                        <label class="charge-toggle">
                            <input type="checkbox" class="enabled-input" @(def.IsEnabled ? "checked" : null) />
                            <span>فعال در فاکتور</span>
                        </label>
                    </div>

                    <div class="charge-definition-grid">
                        <div class="charge-field">
                            <label>عنوان نمایشی</label>
                            <input type="text" class="form-control title-input" value="@def.Title" maxlength="100" />
                        </div>
                        <div class="charge-field">
                            <label>نوع محاسبه</label>
                            <select class="form-select calc-type-input">
                                <option value="0" selected="@(def.CalculationType == ChargeCalculationType.Percentage ? "selected" : null)">درصد</option>
                                <option value="1" selected="@(def.CalculationType == ChargeCalculationType.Fixed ? "selected" : null)">مبلغ ثابت (تومان)</option>
                            </select>
                        </div>
                        <div class="charge-field">
                            <label>مقدار</label>
                            <input type="number" class="form-control value-input" value="@def.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" min="0" step="0.01" />
                        </div>
                        <div class="charge-field">
                            <label>ترتیب نمایش</label>
                            <input type="number" class="form-control order-input" value="@def.DisplayOrder" min="0" step="1" />
                        </div>
                        <div class="charge-field">
                            <label>نوع سفارش</label>
                            <select class="form-select order-types-input">
                                <option value="7" selected="@(def.AppliesToOrderTypes == OrderTypeFlags.All ? "selected" : null)">همه</option>
                                <option value="1" selected="@(def.AppliesToOrderTypes == OrderTypeFlags.DineIn ? "selected" : null)">سالن</option>
                                <option value="2" selected="@(def.AppliesToOrderTypes == OrderTypeFlags.Takeaway ? "selected" : null)">بیرون‌بر</option>
                                <option value="4" selected="@(def.AppliesToOrderTypes == OrderTypeFlags.Delivery ? "selected" : null)">ارسال</option>
                                <option value="6" selected="@(def.AppliesToOrderTypes == (OrderTypeFlags.Takeaway | OrderTypeFlags.Delivery) ? "selected" : null)">بیرون‌بر + ارسال</option>
                            </select>
                        </div>
                        <div class="charge-field charge-field--checkbox">
                            <label class="charge-checkbox">
                                <input type="checkbox" class="taxable-input" @(def.IsTaxable ? "checked" : null) />
                                <span>شامل در مبنای مالیات</span>
                            </label>
                        </div>
                    </div>

                    <input type="hidden" class="code-input" value="@def.Code" />
                    <input type="hidden" class="category-input" value="@((int)def.ChargeCategory)" />
                </article>
            }
        </div>

        <div class="settings-actions">
            <button type="button" class="btn-save" id="saveChargeDefinitionsBtn">
                <i class="fas fa-save ms-1"></i>
                ذخیره تنظیمات
            </button>
            <a href="@Url.Action("ManagerOrderList", "Home")" class="btn-outline-link">
                <i class="fas fa-receipt ms-1"></i>
                رفتن به لیست سفارش‌ها
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.receiptChargeSettings = {
            saveUrl: '@Url.Action("SaveChargeSettings", "Receipt")'
        };
    </script>
    <script src="~/js/receipt-charge-settings.js" asp-append-version="true"></script>
}

@functions {
    private static string GetCategoryLabel(ChargeCategory category) => category switch
    {
        ChargeCategory.Discount => "تخفیف",
        ChargeCategory.Tax => "مالیات",
        _ => "کارمزد"
    };

    private static string GetCategoryClass(ChargeCategory category) => category switch
    {
        ChargeCategory.Discount => "is-discount",
        ChargeCategory.Tax => "is-tax",
        _ => "is-fee"
    };
}
