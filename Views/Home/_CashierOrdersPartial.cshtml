@model resturanyar.Models.OrderListViewModel
@using resturanyar.Helpers
    @{
    string baseImageUrl = "https://resturanyar.ir/";

    }
@{
    var nextStatusMap = new Dictionary<int, int>
    {
        { 6, 7 },
        { 7, 8 },
        { 8, 11 }
    };
}

@if (Model != null && Model.Orders.Any())
{
    foreach (var order in Model.Orders)
    {
         
        <div class="order-card">
            <div class="order-header">
                <div>
                    سفارش شماره <span class="text-primary">#@order.OrderId</span>
                    <span class="mx-2">-</span>
                    @{
                        var cashierTypeLabel = order.OrderType switch
                        {
                            1 => "بیرون‌بر",
                            2 => "ارسال",
                            _ => null
                        };
                    }
                    @if (cashierTypeLabel != null)
                    {
                        <span class="badge bg-info text-dark">@cashierTypeLabel</span>
                    }
                    else
                    {
                        <text>میز <span class="text-primary">@order.TableNumber</span></text>
                    }
                    @if (order.OrderType == 2 && !string.IsNullOrWhiteSpace(order.AddressSnapshot))
                    {
                        <div class="small text-muted mt-1">
                            <i class="fa-solid fa-location-dot ms-1"></i>@order.AddressSnapshot
                            @if (!string.IsNullOrWhiteSpace(order.PhoneSnapshot))
                            {
                                <span class="ms-2"><i class="fa-solid fa-phone ms-1"></i>@order.PhoneSnapshot</span>
                            }
                        </div>
                    }
                    @if (order.OrderType == 2 && !string.IsNullOrWhiteSpace(order.DeliveryFailureReason))
                    {
                        <div class="alert alert-warning py-1 px-2 mt-1 mb-0 small">
                            <strong>تحویل ناموفق:</strong> @order.DeliveryFailureReason
                        </div>
                    }
                    @if (order.OrderType == 2)
                    {
                        <div class="small mt-1 d-flex align-items-center gap-1">
                            <img src="/images/food_delivery.png" alt="" style="width:18px;height:18px;object-fit:contain;" />
                            <span>پیک: @(string.IsNullOrWhiteSpace(order.AssignedDriverName) ? "تخصیص نشده" : order.AssignedDriverName)</span>
                        </div>
                    }
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="order-date"><i class="fa-regular fa-calendar ms-1"></i> @order.CreatedAt.ToString("yyyy/MM/dd HH:mm")</div>
                    <div class="@OrderStatusColors.ChipClass(order.StatusId)">
                        @{
                            var cashierStatusLabel = Model.StatusMap.GetValueOrDefault(order.StatusId, "نامشخص");
                        }
                        @cashierStatusLabel
                    </div>
                    <div>
                        @if (Model.StatusMap.ContainsKey(order.StatusId))
                        {
                            if (nextStatusMap.ContainsKey(order.StatusId))
                            {
                                <button class="btn btn-sm btn-primary"
                                        onclick="changeStatus(@order.OrderId, @nextStatusMap[order.StatusId])">
                                    تغییر وضعیت به @Model.StatusMap[nextStatusMap[order.StatusId]]
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(order.Description))
            {
                <div class="order-description"><i class="fa-solid fa-note-sticky ms-1"></i> @order.Description</div>
            }

            @if (order.OrderItems != null && order.OrderItems.Any())
            {
                <div>
                    @foreach (var item in order.OrderItems)
                    {
                        var imgUrl = string.IsNullOrEmpty(item.FoodImageUrl) ? (baseImageUrl + "images/default-food.jpg") : (baseImageUrl + item.FoodImageUrl.TrimStart('/'));
                        <div class="food-item">
                            <img src="@imgUrl" alt="@item.FoodName" class="food-img" />
                            <div class="food-info">
                                <div class="food-name">@item.FoodName</div>
                                <div class="food-quantity">تعداد: @item.Quantity</div>
                            </div>
                           
                        </div>
                    }
                </div>

                
            }
            else
            {
                <div class="alert alert-secondary mt-3">هیچ آیتمی در این سفارش ثبت نشده است.</div>
            }
        </div>
    }
}
else
{
    <div class="alert alert-warning text-center fs-5">هیچ سفارشی یافت نشد.</div>
}
