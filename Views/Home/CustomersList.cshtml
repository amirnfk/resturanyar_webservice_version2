      $("#btnSaveCustomer").click(function () {
        const id = $("#customerId").val();
        let fullName = $("#fullName").val().trim();
        let mobile = $("#mobile").val().trim();
        const description = $("#description").val().trim();

        // منطق جدید فقط برای ثبت مشتری جدید (نه ویرایش)
        if (id === "0") {
            if (fullName !== "") {
                // کاربر نام وارد کرده است
                if (mobile === "") {
                    // شماره وارد نکرده → تولید خودکار
                    mobile = generateAutoMobile();
                }
                // اگر شماره هم وارد کرده باشد، همان شماره حفظ می‌شود
            } else {
                // نام خالی: شماره موبایل الزامی است
                if (!mobile) {
                    toastr.warning("شماره موبایل الزامی است");
                    $("#mobile").focus();
                    return;
                }
                if (!/^09[0-9]{9}$/.test(mobile)) {
                    toastr.warning("شماره موبایل معتبر (11 رقم، شروع با 09) وارد کنید");
                    $("#mobile").focus();
                    return;
                }
                fullName = "مشتری مهمان";
            }
        } else {
            // ویرایش مشتری موجود: شماره موبایل الزامی و معتبر (در صورت تغییر)
            if (!mobile) {
                toastr.warning("شماره موبایل الزامی است");
                $("#mobile").focus();
                return;
            }
            if (!/^09[0-9]{9}$/.test(mobile)) {
                toastr.warning("شماره موبایل معتبر (11 رقم، شروع با 09) وارد کنید");
                $("#mobile").focus();
                return;
            }
            if (!fullName) {
                fullName = "مشتری مهمان";
            }
        }

        const url = id === "0" ? "/api/Customers/addcustomer" : "/api/Customers/editcustomer";
        const payload = id === "0" ? {
            restaurantId: restaurantId,
            fullName: fullName,
            mobile: mobile,
            description: description
        } : {
            customerId: parseInt(id),
            restaurantId: restaurantId,
            fullName: fullName,
            mobile: mobile,
            description: description
        };

        $.ajax({
            url: url,
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(payload),
            success: function (res) {
                if (res.success) {
                    toastr.success(res.message);
                    $("#customerModal").modal("hide");
                    loadCustomers(currentPage, currentSearch);
                    loadDashboardStats();
                } else {
                    toastr.error(res.message);
                }
            },
            error: function () {
                toastr.error("خطا در برقراری ارتباط با سرور");
            }
        });
    });
      function generateAutoMobile() {
        const prefix = '991';
        const timestamp = Date.now().toString();
        const eightDigits = timestamp.slice(2, 10);
        const random = Math.floor(Math.random() * 10);
        return prefix + eightDigits + random;
    }
