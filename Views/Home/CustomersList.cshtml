                    const orangeGradient = ctx.createLinearGradient(0, 0, 0, 200);
                    orangeGradient.addColorStop(0, 'rgba(255, 122, 0, 0.25)');
                    orangeGradient.addColorStop(1, 'rgba(255, 122, 0, 0.00)');

                    const emeraldGradient = ctx.createLinearGradient(0, 0, 0, 200);
                    emeraldGradient.addColorStop(0, 'rgba(16, 185, 129, 0.25)');
                    emeraldGradient.addColorStop(1, 'rgba(16, 185, 129, 0.00)');

                    trendChart = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: s.last7DaysStats.map(d => d.persianDate),
                            datasets: [
                                {
                                    label: 'مشتریان جدید',
                                    data: s.last7DaysStats.map(d => d.newCustomers),
                                    borderColor: '#ff7a00',
                                    backgroundColor: orangeGradient,
                                    borderWidth: 3,
                                    pointRadius: 4,
                                    pointHoverRadius: 6,
                                    pointBackgroundColor: '#ff7a00',
                                    pointBorderColor: '#ffffff',
                                    pointBorderWidth: 1.5,
                                    tension: 0.4, // خمیدگی سافت و زیبا
                                    fill: true,
                                    yAxisID: 'y'
                                },
                                {
                                    label: 'فروش (هزار تومان)',
                                    data: s.last7DaysStats.map(d => d.revenue / 1000),
                                    borderColor: '#10b981',
                                    backgroundColor: emeraldGradient,
                                    borderWidth: 3,
                                    pointRadius: 4,
                                    pointHoverRadius: 6,
                                    pointBackgroundColor: '#10b981',
                                    pointBorderColor: '#ffffff',
                                    pointBorderWidth: 1.5,
                                    tension: 0.4,
                                    fill: true,
                                    yAxisID: 'y1'
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    backgroundColor: '#1e293b',
                                    titleColor: '#ffffff',
                                    bodyColor: '#e2e8f0',
                                    padding: 12,
                                    cornerRadius: 8,
                                    rtl: true,
                                    callbacks: {
                                        label: (ctx) => `${ctx.dataset.label}: ${ctx.raw.toLocaleString('fa-IR')}`
                                    }
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    grid: { color: 'rgba(226, 232, 240, 0.4)' },
                                    ticks: { color: '#94a3b8', font: { size: 10 } }
                                },
                                y1: {
                                    position: 'right',
                                    beginAtZero: true,
                                    grid: { display: false },
                                    ticks: { color: '#94a3b8', callback: (val) => val.toLocaleString('fa-IR'), font: { size: 10 } }
                                },
                                x: {
                                    grid: { display: false },
                                    ticks: { color: '#94a3b8', font: { size: 11 } }
                                }
                            }
                        }
                    });
                } else {
                    toastr.error(response.message);
                }
            },
            error: function() {
                toastr.error("خطا در دریافت اطلاعات داشبورد");
            }
        });
    }

