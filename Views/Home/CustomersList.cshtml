    function escapeHtml(str) {
        if (!str) return "";
        return str.replace(/[&<>]/g, function (m) {
            if (m === "&") return "&amp;";
            if (m === "<") return "&lt;";
            if (m === ">") return "&gt;";
            return m;
        });
    }

    function toEnglishDigits(str) {
        if (!str) return "";
        const arabicMap = { '٠':'0','١':'1','٢':'2','٣':'3','٤':'4','٥':'5','٦':'6','٧':'7','٨':'8','٩':'9' };
        const persianMap = { '۰':'0','۱':'1','۲':'2','۳':'3','۴':'4','۵':'5','۶':'6','۷':'7','۸':'8','۹':'9' };
        let result = str;
        for (let [key, value] of Object.entries(persianMap)) result = result.split(key).join(value);
        for (let [key, value] of Object.entries(arabicMap)) result = result.split(key).join(value);
        return result;
    }
    
    $(document).ready(function () {
        if (restaurantId > 0) {
            loadCustomers(1, "", "all", "TotalSpent");
            loadDashboardStats();
            loadInsightsCards();
        } else {
            $("#customersList").html('<div class="alert alert-danger text-center">شناسه رستوران نامعتبر است</div>');
        }
    });
</script>