                <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal" style="border-radius: var(--radius-sm);">لغو عملیات</button>
                <button type="button" id="confirmDelete" class="btn btn-danger px-4" style="border-radius: var(--radius-sm);">بله، حذف شود</button>
            </div>
        </div>
    </div>
</div>

<!-- پنل مدیریت آدرس‌های مشتری -->
<div class="offcanvas offcanvas-end addr-offcanvas" tabindex="-1" id="addressesOffcanvas" aria-labelledby="addressesOffcanvasLabel">
    <div class="offcanvas-header">
        <div class="addr-offcanvas-heading">
            <h5 class="offcanvas-title fw-bold mb-0" id="addressesOffcanvasLabel">
                <i class="fas fa-map-location-dot text-primary me-1"></i> مدیریت آدرس‌ها
            </h5>
            <div class="addr-customer-chip">
                <div class="chip-avatar"><i class="fas fa-user"></i></div>
                <div>
                    <div class="chip-name" id="addrCustomerName">—</div>
                    <div class="chip-mobile" id="addrCustomerMobile">—</div>
                </div>
            </div>
        </div>
        <button type="button" class="btn-close" id="btnCloseAddressesOffcanvas" data-bs-dismiss="offcanvas" aria-label="بستن"></button>
    </div>
    <div class="offcanvas-body addr-offcanvas-body">
        <div class="addr-toolbar">
            <span class="fw-bold" style="font-size:0.9rem;">آدرس‌های ذخیره‌شده</span>
            <button type="button" class="btn btn-sm btn-primary" id="btnNewAddress" style="border-radius:var(--radius-sm);">
                <i class="fas fa-plus me-1"></i> آدرس جدید
            </button>
        </div>

        <div id="addrListLoading" class="text-center py-4 text-muted flex-shrink-0" style="display:none;">
            <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
            در حال دریافت آدرس‌ها...
        </div>
        <div id="addrListContainer" class="addr-list-scroll"></div>
    </div>
</div>

<!-- مودال افزودن / ویرایش آدرس -->
<div class="modal fade" id="addressFormModal" tabindex="-1" aria-labelledby="addrFormHeading" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="addrFormHeading">
                    <i class="fas fa-pen-to-square text-primary me-1"></i> ثبت آدرس جدید
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
