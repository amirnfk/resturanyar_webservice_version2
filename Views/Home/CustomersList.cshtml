@{
    ViewData["Title"] = "باشگاه مشتریان";
}

@section Styles {
    <link rel="stylesheet" href="~/css/brand-scrollbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/customers-list.css" asp-append-version="true" />
}

<div class="container customers-page py-4">
    <div id="exportLoadingOverlay" class="cl-overlay" aria-hidden="true">
        <div class="cl-overlay__box">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">در حال بارگذاری...</span>
            </div>
            <p class="cl-overlay__text">در حال آماده‌سازی گزارش...</p>
        </div>
    </div>

    <!-- ========== نوار عنوان و اقدام اصلی ========== -->
    <header class="cl-actionbar">
        <div class="cl-actionbar__text">
            <span class="cl-actionbar__badge" aria-hidden="true"><i class="fas fa-crown"></i></span>
            <div>
                <h1 class="cl-actionbar__title">باشگاه مشتریان</h1>
                <p class="cl-actionbar__sub">پروفایل مشتریان، آدرس‌ها و تحلیل رفتار خرید در یک نگاه</p>
            </div>
        </div>
        <div class="cl-actionbar__actions">
            <button type="button" class="cl-btn cl-btn--primary" id="btnAddCustomer">
                <i class="fas fa-plus"></i>
                <span>مشتری جدید</span>
            </button>
        </div>
    </header>

    <!-- ========== شاخص‌های کلیدی ========== -->
    <section class="cl-hero" aria-label="شاخص‌های کلیدی مشتریان">
        <div class="cl-total">
            <div class="cl-total__top">
                <span class="cl-total__label"><i class="fas fa-users"></i> کل مشتریان فعال</span>
                <span class="cl-total__chip">پروفایل‌های ثبت‌شده</span>
            </div>
            <p class="cl-total__value">
                <span id="totalCustomers">0</span><span class="cl-total__unit">نفر</span>
            </p>
            <div class="cl-total__breakdown">
                <div class="cl-total__cell">
                    <span>امروز</span>
                    <strong id="newToday">0</strong>
                </div>
                <div class="cl-total__cell">
                    <span>این هفته</span>
                    <strong id="newWeek">0</strong>
                </div>
                <div class="cl-total__cell">
                    <span>این ماه</span>
                    <strong id="newMonth">0</strong>
                </div>
            </div>
        </div>

        <article class="cl-panel cl-top">
            <header class="cl-panel__head">
                <span class="cl-panel__icon cl-panel__icon--top" aria-hidden="true"><i class="fas fa-crown"></i></span>
                <div class="cl-panel__heading">
                    <h2 class="cl-panel__title">مشتری ویژه ماه</h2>
                    <p class="cl-panel__hint">بیشترین مبلغ خرید در ماه جاری</p>
                </div>
            </header>
            <div class="cl-top__body">
                <h3 class="cl-top__name" id="topCustomerName">-</h3>
                <span class="cl-top__amount cl-money" id="topCustomerAmount">0 تومان</span>
                <div class="cl-top__foot">
                    <span>تعداد سفارش</span>
                    <strong id="topCustomerOrders">0</strong>
                </div>
            </div>
        </article>
    </section>

    <!-- ========== کارت‌های تحلیلی ========== -->
    <section class="cl-insights" aria-label="تحلیل رفتار مشتریان">
        <article class="cl-panel">
            <header class="cl-panel__head">
                <span class="cl-panel__icon cl-panel__icon--growth" aria-hidden="true"><i class="fas fa-chart-line"></i></span>
                <div class="cl-panel__heading">
                    <h2 class="cl-panel__title">رشد جدید</h2>
                    <p class="cl-panel__hint">پرخریدترین‌های ۷ روز اخیر</p>
                </div>
            </header>
            <div class="cl-panel__body cl-panel__body--scroll scrollable-list" id="growthCustomersList">
                <div class="cl-panel__loading"><i class="fas fa-spinner fa-spin"></i> بارگذاری...</div>
            </div>
        </article>

        <article class="cl-panel">
            <header class="cl-panel__head">
                <span class="cl-panel__icon cl-panel__icon--return" aria-hidden="true"><i class="fas fa-repeat"></i></span>
                <div class="cl-panel__heading">
                    <h2 class="cl-panel__title">نرخ بازگشت مشتری</h2>
                    <p class="cl-panel__hint">سهم مشتریان تکرارشونده</p>
                </div>
            </header>
            <div class="cl-panel__body cl-panel__body--scroll scrollable-list" id="returnRatesList">
                <div class="cl-panel__loading"><i class="fas fa-spinner fa-spin"></i> بارگذاری...</div>
            </div>
        </article>

        <article class="cl-panel">
            <header class="cl-panel__head">
                <span class="cl-panel__icon cl-panel__icon--best" aria-hidden="true"><i class="fas fa-award"></i></span>
                <div class="cl-panel__heading">
                    <h2 class="cl-panel__title">بهترین مشتریان</h2>
                    <p class="cl-panel__hint">بیشترین خرید کل</p>
                </div>
            </header>
            <div class="cl-panel__body cl-panel__body--scroll scrollable-list" id="bestCustomersList">
                <div class="cl-panel__loading"><i class="fas fa-spinner fa-spin"></i> بارگذاری...</div>
            </div>
        </article>
    </section>

    <!-- ========== نمودار روند هفتگی ========== -->
    <section class="cl-panel cl-chart" aria-label="روند هفتگی فروش و جذب مشتری">
        <header class="cl-chart__head">
            <div class="cl-panel__heading">
                <h2 class="cl-panel__title">روند هفتگی فروش و جذب مشتری</h2>
                <p class="cl-panel__hint">فروش رستوران و مشتریان جدید در ۷ روز اخیر</p>
            </div>
            <div class="cl-chart__legend">
                <span class="cl-legend">
                    <span class="cl-legend__dot cl-legend__dot--customers" aria-hidden="true"></span> مشتریان جدید
                </span>
                <span class="cl-legend">
                    <span class="cl-legend__dot cl-legend__dot--revenue" aria-hidden="true"></span> مجموع فروش (هزار تومان)
                </span>
            </div>
        </header>
        <div class="cl-chart__canvas">
            <canvas id="trendChart"></canvas>
        </div>
    </section>

    <!-- ========== فهرست مشتریان ========== -->
    <section class="cl-directory" aria-label="فهرست مشتریان">
        <header class="cl-directory__head">
            <div class="cl-panel__heading">
                <h2 class="cl-panel__title">فهرست مشتریان</h2>
                <p class="cl-panel__hint">جستجو، فیلتر بازه و مرتب‌سازی بر اساس خرید</p>
            </div>
            <div id="totalRecordsInfo" class="cl-count d-none" aria-live="polite"></div>
        </header>

        <div class="cl-toolbar" aria-label="جستجو و فیلتر مشتریان">
            <div class="cl-field cl-field--search">
                <label class="cl-label" for="searchInput">جستجو در مشتریان</label>
                <div class="cl-search">
                    <div class="cl-search__field">
                        <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                        <input type="text" id="searchInput" class="form-control" placeholder="نام، شماره موبایل، توضیحات..." autocomplete="off" />
                    </div>
                    <button type="button" id="btnSearch" class="cl-btn cl-btn--primary cl-search__btn">
                        <i class="fas fa-search"></i>
                        <span>جستجو</span>
                    </button>
                </div>
            </div>

            <div class="cl-field">
                <label class="cl-label" for="periodSelect">بازه زمانی سفارش‌ها</label>
                <select id="periodSelect" class="form-select">
                    <option value="all">همه زمان‌ها</option>
                    <option value="today">امروز</option>
                    <option value="week">هفته گذشته</option>
                    <option value="month">ماه جاری</option>
                    <option value="year">سال گذشته</option>
                </select>
            </div>

            <div class="cl-field">
                <label class="cl-label" for="sortBySelect">مرتب‌سازی بر اساس</label>
                <select id="sortBySelect" class="form-select">
                    <option value="TotalSpent">بیشترین مبلغ خرید</option>
                    <option value="TotalOrders">بیشترین تعداد سفارش</option>
                    <option value="TotalDistinctDays">بیشترین روزهای حضور</option>
                </select>
            </div>

            <div class="cl-toolbar__actions">
                <button type="button" id="btnApplyFilter" class="cl-btn cl-btn--dark">
                    <i class="fas fa-sliders"></i>
                    <span>اعمال فیلتر</span>
                </button>
                <button type="button" id="btnResetSearch" class="cl-btn cl-btn--ghost">
                    <i class="fas fa-rotate-left"></i>
                    <span>بازنشانی</span>
                </button>
                <button type="button" id="exportBtn" class="cl-btn">
                    <i class="bi bi-download"></i>
                    <span>دانلود گزارش</span>
                </button>
            </div>
        </div>

        <p class="cl-note">
            <i class="fas fa-circle-info" aria-hidden="true"></i>
            <span>آمار خرید فقط بر اساس سفارش‌های بسته‌شده محاسبه می‌شود.</span>
        </p>

        <div id="loadingSpinner" class="d-none" role="status" aria-live="polite">
            <span class="visually-hidden">در حال بارگذاری لیست مشتریان...</span>
            <div class="cl-skeleton" aria-hidden="true">
                @for (var i = 0; i < 6; i++)
                {
                    <div class="cl-skeleton__row">
                        <div class="cl-skeleton__avatar"></div>
                        <div class="cl-skeleton__body">
                            <div class="cl-skeleton__line cl-skeleton__line--title"></div>
                            <div class="cl-skeleton__line cl-skeleton__line--sub"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div id="customersList"></div>
        <nav id="paginationContainer" class="cl-pagination" aria-label="صفحه‌بندی مشتریان"></nav>
    </section>
</div>

<!-- مودال افزودن/ویرایش مشتری -->
<div class="modal fade" id="customerModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div class="cl-modal-heading">
                    <span class="cl-modal-heading__icon" aria-hidden="true"><i class="fas fa-user-plus"></i></span>
                    <div>
                        <h5 class="modal-title" id="modalTitle">افزودن مشتری جدید</h5>
                        <p class="cl-modal-heading__sub">اطلاعات پایه مشتری را ثبت کنید</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <form id="customerForm" autocomplete="off">
                    <input type="hidden" id="customerId" value="0" />
                    <div class="mb-3">
                        <label class="cl-label" for="fullName">نام کامل</label>
                        <input type="text" id="fullName" class="form-control" placeholder="مثال: علیرضا شایان" required />
                    </div>
                    <div class="mb-3">
                        <label class="cl-label" for="mobile">شماره موبایل</label>
                        <input type="tel" id="mobile" class="form-control cl-num" placeholder="09123456789" inputmode="numeric" required dir="ltr" />
                        <span class="cl-help">۱۱ رقم و با ۰۹ شروع شود. برای مشتری جدید اگر خالی بماند، شماره موقت ساخته می‌شود.</span>
                    </div>
                    <div>
                        <label class="cl-label" for="description">توضیحات (اختیاری)</label>
                        <textarea id="description" class="form-control" placeholder="یادداشت در خصوص ترجیحات مشتری..." rows="3"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn cl-btn-cancel" data-bs-dismiss="modal">انصراف</button>
                <button type="button" id="btnSaveCustomer" class="btn btn-primary">
                    <i class="fas fa-check me-1"></i> ذخیره اطلاعات
                </button>
            </div>
        </div>
    </div>
</div>

<!-- مودال تأیید حذف مشتری -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div class="cl-modal-heading">
                    <span class="cl-modal-heading__icon" aria-hidden="true"><i class="fas fa-triangle-exclamation"></i></span>
                    <div>
                        <h5 class="modal-title" id="deleteModalTitle">حذف مشتری</h5>
                        <p class="cl-modal-heading__sub">این عملیات قابل بازگشت نیست</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                آیا از حذف این مشتری و کل تاریخچه اطلاعات او اطمینان دارید؟
                <p class="cl-warning">
                    <i class="fas fa-circle-exclamation" aria-hidden="true"></i>
                    <span>آدرس‌ها و سابقه حساب این مشتری هم از دسترس خارج می‌شود.</span>
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn cl-btn-cancel" data-bs-dismiss="modal">لغو عملیات</button>
                <button type="button" id="confirmDelete" class="btn btn-danger">بله، حذف شود</button>
            </div>
        </div>
    </div>
</div>

<!-- پنل مدیریت آدرس‌های مشتری -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="addressesOffcanvas" aria-labelledby="addressesOffcanvasLabel">
    <div class="offcanvas-header">
        <div class="cl-addr__heading">
            <h5 class="offcanvas-title" id="addressesOffcanvasLabel">
                <i class="fas fa-map-location-dot" aria-hidden="true"></i> مدیریت آدرس‌ها
            </h5>
            <div class="cl-addr__chip">
                <span class="cl-addr__avatar" aria-hidden="true"><i class="fas fa-user"></i></span>
                <div>
                    <div class="cl-addr__name" id="addrCustomerName">—</div>
                    <span class="cl-addr__mobile cl-num" id="addrCustomerMobile">—</span>
                </div>
            </div>
        </div>
        <button type="button" class="btn-close" id="btnCloseAddressesOffcanvas" data-bs-dismiss="offcanvas" aria-label="بستن"></button>
    </div>
    <div class="offcanvas-body">
        <div class="cl-addr__toolbar">
            <span class="cl-addr__toolbar-title">آدرس‌های ذخیره‌شده</span>
            <button type="button" class="cl-addr__add" id="btnNewAddress">
                <i class="fas fa-plus"></i> آدرس جدید
            </button>
        </div>

        <div id="addrListLoading" class="cl-addr__loading" style="display:none;" role="status">
            <div class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></div>
            در حال دریافت آدرس‌ها...
        </div>
        <div id="addrListContainer" class="cl-addr__scroll"></div>
    </div>
</div>

<!-- مودال افزودن / ویرایش آدرس -->
<div class="modal fade" id="addressFormModal" tabindex="-1" aria-labelledby="addrFormHeading" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div class="cl-modal-heading">
                    <span class="cl-modal-heading__icon" aria-hidden="true"><i class="fas fa-map-pin"></i></span>
                    <div>
                        <h5 class="modal-title" id="addrFormHeading">ثبت آدرس جدید</h5>
                        <p class="cl-modal-heading__sub">آدرس دقیق برای ارسال سفارش</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <form id="addressForm" autocomplete="off">
                    <input type="hidden" id="addrId" value="0" />
                    <input type="hidden" id="addrCustomerId" value="0" />

                    <div class="mb-3">
                        <label class="cl-label" for="addrTitle">عنوان آدرس</label>
                        <input type="text" id="addrTitle" class="form-control" placeholder="مثلاً خانه، محل کار، شعبه شمال" maxlength="100" />
                        <span class="cl-help">اگر خالی بماند، عنوان «آدرس» ثبت می‌شود.</span>
                    </div>

                    <div class="mb-3">
                        <label class="cl-label" for="addrText">متن آدرس <span class="text-danger">*</span></label>
                        <textarea id="addrText" class="form-control" rows="3" placeholder="خیابان، کوچه، پلاک و جزئیات کامل..." required></textarea>
                    </div>

                    <div class="row g-2">
                        <div class="col-4">
                            <label class="cl-label" for="addrPlate">پلاک</label>
                            <input type="text" id="addrPlate" class="form-control" placeholder="—" maxlength="10" />
                        </div>
                        <div class="col-4">
                            <label class="cl-label" for="addrFloor">طبقه</label>
                            <input type="text" id="addrFloor" class="form-control" placeholder="—" maxlength="10" />
                        </div>
                        <div class="col-4">
                            <label class="cl-label" for="addrUnit">واحد</label>
                            <input type="text" id="addrUnit" class="form-control" placeholder="—" maxlength="10" />
                        </div>
                    </div>

                    <div class="row g-2 mt-2 d-none" aria-hidden="true">
                        <div class="col-6">
                            <label class="cl-label" for="addrLat">عرض جغرافیایی</label>
                            <input type="number" step="any" id="addrLat" class="form-control" placeholder="اختیاری" dir="ltr" />
                        </div>
                        <div class="col-6">
                            <label class="cl-label" for="addrLng">طول جغرافیایی</label>
                            <input type="number" step="any" id="addrLng" class="form-control" placeholder="اختیاری" dir="ltr" />
                        </div>
                    </div>

                    <div class="cl-form-section">
                        <label class="cl-label" for="addrDescription">یادداشت (اختیاری)</label>
                        <input type="text" id="addrDescription" class="form-control" placeholder="مثلاً زنگ طبقه ۲ را بزنید" maxlength="200" />
                    </div>

                    <div class="form-check form-switch cl-switch mt-3">
                        <input class="form-check-input" type="checkbox" id="addrIsDefault" role="switch" />
                        <span class="cl-switch__text">
                            <label class="cl-switch__title" for="addrIsDefault">آدرس پیش‌فرض مشتری</label>
                            <span class="cl-switch__hint">در ثبت سفارش به‌صورت خودکار انتخاب می‌شود.</span>
                        </span>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn cl-btn-cancel" id="btnCancelAddressForm" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" id="btnSaveAddress">
                    <i class="fas fa-check me-1"></i> ذخیره آدرس
                </button>
            </div>
        </div>
    </div>
</div>

<!-- مودال انتخاب فرمت گزارش -->
<div class="modal fade" id="exportFormatModal" tabindex="-1" aria-labelledby="exportFormatModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" dir="rtl">
            <div class="modal-header">
                <h5 class="modal-title" id="exportFormatModalLabel">نوع گزارش</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p class="cl-export-lead">فرمت دانلود گزارش را انتخاب کنید. مبالغ در هر دو فایل به تومان است.</p>
                <div class="cl-export-options">
                    <button type="button" id="exportFormatExcel" class="cl-export-option cl-export-option--excel">
                        <span class="cl-export-option__icon" aria-hidden="true"><i class="bi bi-file-earmark-excel-fill"></i></span>
                        <span class="cl-export-option__text">
                            <strong>اکسل</strong>
                            <small>جدول کامل مشتریان به تومان (.xlsx)</small>
                        </span>
                    </button>
                    <button type="button" id="exportFormatPdf" class="cl-export-option cl-export-option--pdf">
                        <span class="cl-export-option__icon" aria-hidden="true"><i class="bi bi-file-earmark-pdf-fill"></i></span>
                        <span class="cl-export-option__text">
                            <strong>PDF</strong>
                            <small>گزارش چاپی مشتریان به تومان (.pdf)</small>
                        </span>
                    </button>
                    <button type="button" class="btn cl-export-cancel" data-bs-dismiss="modal">انصراف</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- مودال نتیجه خالی گزارش -->
<div class="modal fade" id="exportNoOrdersModal" tabindex="-1" aria-labelledby="exportNoOrdersModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" dir="rtl">
            <div class="modal-header">
                <h5 class="modal-title" id="exportNoOrdersModalLabel">توجه</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <div class="cl-notice">
                    <span class="cl-notice__icon" aria-hidden="true"><i class="fas fa-circle-exclamation"></i></span>
                    <p id="exportNoOrdersMessage">هیچ مشتری‌ای با این فیلتر یافت نشد.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary px-4" data-bs-dismiss="modal">متوجه شدم</button>
            </div>
        </div>
    </div>
</div>

<!-- مودال تأیید حذف آدرس -->
<div class="modal fade" id="deleteAddressModal" tabindex="-1" aria-labelledby="deleteAddressTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div class="cl-modal-heading">
                    <span class="cl-modal-heading__icon" aria-hidden="true"><i class="fas fa-trash"></i></span>
                    <div>
                        <h5 class="modal-title" id="deleteAddressTitle">حذف آدرس</h5>
                        <p class="cl-modal-heading__sub">حذف از پروفایل مشتری</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                این آدرس از پروفایل مشتری حذف می‌شود. ادامه می‌دهید؟
            </div>
            <div class="modal-footer">
                <button type="button" class="btn cl-btn-cancel" data-bs-dismiss="modal">لغو</button>
                <button type="button" class="btn btn-danger" id="btnConfirmDeleteAddress">حذف آدرس</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/chart.umd.min.js" asp-append-version="true"></script>
<script>
    var API_BASE = "/api/v2/UserApi";
    var restaurantId = @(ViewBag.RestaurantId ?? 0);
    var exportCustomersExcelUrl = "@Url.Action("ExportCustomersToExcel", "Home")";
    var exportCustomersPdfUrl = "@Url.Action("ExportCustomersToPdf", "Home")";
    var currentPage = 1;
    var pageSize = 12;
    var currentSearch = "";
    var editingCustomerId = 0;
    var currentPeriod = "all";
    var currentSortBy = "TotalSpent";
    var customersListPageId = 0;
    var trendChart = null;
    var addressCustomerId = 0;
    var deleteAddressId = 0;
    var addressesCache = [];
    var addressesOffcanvas = null;

    function isCustomersListPageCurrent(pageId) {
        return pageId === customersListPageId;
    }

    function destroyCustomersListPage() {
        customersListPageId++;
        if (trendChart) {
            trendChart.destroy();
            trendChart = null;
        }
        hideCustomersExportLoading();
    }
    window.destroyCustomersListPage = destroyCustomersListPage;

    async function loadInsightsCards() {
        const pageId = customersListPageId;
        try {
            const response = await window.fetchWithAuth(`${API_BASE}/getcustomerinsights/${restaurantId}`);
            if (!isCustomersListPageCurrent(pageId)) return;
            if (!response.ok) throw new Error('Failed to load insights');
            const responseData = await response.json();
            if (!isCustomersListPageCurrent(pageId)) return;
            if (responseData.success) {
                const data = responseData.data;

                // ۱. رشد مشتریان جدید (۷ روز اخیر)
                let growthHtml = '';
                data.growthCustomers.forEach(c => {
                    growthHtml += `
                        <div class="cl-mini">
                            <div class="cl-mini__main">
                                <span class="cl-mini__name" title="${escapeHtml(c.name)}">${escapeHtml(c.name)}</span>
                                <span class="cl-mini__meta">${c.orderCount} سفارش</span>
                            </div>
                            <span class="cl-mini__value">${c.amount.toLocaleString('fa-IR')} ت</span>
                        </div>
                    `;
                });
                if (growthHtml === '') growthHtml = '<div class="cl-panel__empty">خریدی در ۷ روز اخیر ثبت نشده</div>';
                $("#growthCustomersList").html(growthHtml);

                // ۲. نرخ بازگشت مشتریان
                const rates = data.returnRates;
                const returnHtml = `
                    <div class="cl-rate">
                        <div class="cl-rate__top">
                            <span>حداقل ۲ بار خرید</span>
                            <span class="cl-rate__pct">${Math.round(rates.rate2)}%</span>
                        </div>
                        <div class="cl-rate__track" role="progressbar" aria-label="حداقل ۲ بار خرید" aria-valuenow="${Math.round(rates.rate2)}" aria-valuemin="0" aria-valuemax="100">
                            <span class="cl-rate__fill" style="width: ${rates.rate2}%"></span>
                        </div>
                    </div>
                    <div class="cl-rate">
                        <div class="cl-rate__top">
                            <span>حداقل ۳ بار خرید</span>
                            <span class="cl-rate__pct">${Math.round(rates.rate3)}%</span>
                        </div>
                        <div class="cl-rate__track" role="progressbar" aria-label="حداقل ۳ بار خرید" aria-valuenow="${Math.round(rates.rate3)}" aria-valuemin="0" aria-valuemax="100">
                            <span class="cl-rate__fill cl-rate__fill--3" style="width: ${rates.rate3}%"></span>
                        </div>
                    </div>
                    <div class="cl-rate">
                        <div class="cl-rate__top">
                            <span>خرید وفادار (حداقل ۵ بار)</span>
                            <span class="cl-rate__pct">${Math.round(rates.rate5)}%</span>
                        </div>
                        <div class="cl-rate__track" role="progressbar" aria-label="خرید وفادار" aria-valuenow="${Math.round(rates.rate5)}" aria-valuemin="0" aria-valuemax="100">
                            <span class="cl-rate__fill cl-rate__fill--5" style="width: ${rates.rate5}%"></span>
                        </div>
                    </div>
                `;
                $("#returnRatesList").html(returnHtml);

                // ۳. بهترین مشتریان کل
                let bestHtml = '';
                data.bestCustomers.forEach((c, index) => {
                    bestHtml += `
                        <div class="cl-mini">
                            <span class="cl-mini__rank cl-mini__rank--${index + 1}">${(index + 1).toLocaleString('fa-IR')}</span>
                            <div class="cl-mini__main">
                                <span class="cl-mini__name" title="${escapeHtml(c.name)}">${escapeHtml(c.name)}</span>
                                <span class="cl-mini__amount">${c.amount.toLocaleString('fa-IR')} تومان</span>
                            </div>
                        </div>
                    `;
                });
                if (bestHtml === '') bestHtml = '<div class="cl-panel__empty">مشتری دارای سفارش یافت نشد</div>';
                $("#bestCustomersList").html(bestHtml);
            } else {
                showToast(responseData.message, 'error');
            }
        } catch (error) {
            if (!isCustomersListPageCurrent(pageId)) return;
            showToast("خطا در دریافت اطلاعات کارت‌ها", 'error');
        }
    }

    async function loadCustomers(page, search, period, sortBy) {
        const pageId = customersListPageId;
        currentPage = page || 1;
        currentSearch = search !== undefined ? search : currentSearch;
        currentPeriod = period !== undefined ? period : currentPeriod;
        currentSortBy = sortBy !== undefined ? sortBy : currentSortBy;
        $("#loadingSpinner").removeClass("d-none");
        $("#customersList").empty();

        try {
            const params = new URLSearchParams({
                page: currentPage,
                pageSize: pageSize,
                search: currentSearch,
                period: currentPeriod,
                sortBy: currentSortBy
            });
            const response = await window.fetchWithAuth(`${API_BASE}/getcustomerswithstats/${restaurantId}?${params}`);
            if (!isCustomersListPageCurrent(pageId)) return;
            if (!response.ok) throw new Error('Failed to load customers');
            const responseData = await response.json();
            if (!isCustomersListPageCurrent(pageId)) return;
            if (responseData.success) {
                if (responseData.data && responseData.data.length > 0) {
                    renderCustomersWithStats(responseData.data);
                    renderPagination(responseData.currentPage, responseData.totalPages);
                    renderTotalRecords(responseData.totalCount, responseData.data.length);
                } else {
                    $("#customersList").html(`
                        <div class="cl-empty">
                            <div class="cl-empty__icon"><i class="fas fa-user-slash"></i></div>
                            <strong>مشتری‌ای یافت نشد</strong>
                            <p>با این جستجو و بازه زمانی نتیجه‌ای وجود ندارد. فیلترها را تغییر دهید یا بازنشانی کنید.</p>
                        </div>`);
                    $("#paginationContainer").empty();
                    $("#totalRecordsInfo").addClass("d-none");
                }
            } else {
                showToast(responseData.message, 'error');
            }
        } catch (error) {
            if (!isCustomersListPageCurrent(pageId)) return;
            showToast("خطا در دریافت لیست مشتریان", 'error');
        } finally {
            if (isCustomersListPageCurrent(pageId)) {
                $("#loadingSpinner").addClass("d-none");
            }
        }
    }

    async function loadDashboardStats() {
        const pageId = customersListPageId;
        try {
            const response = await window.fetchWithAuth(`${API_BASE}/getdashboardstats/${restaurantId}`);
            if (!isCustomersListPageCurrent(pageId)) return;
            if (!response.ok) throw new Error('Failed to load dashboard stats');
            const responseData = await response.json();
            if (!isCustomersListPageCurrent(pageId)) return;
            if (responseData.success) {
                const s = responseData.data;
                $("#totalCustomers").text(s.totalActiveCustomers.toLocaleString('fa-IR'));
                $("#newToday").text(s.newCustomersToday.toLocaleString('fa-IR'));
                $("#newWeek").text(s.newCustomersThisWeek.toLocaleString('fa-IR'));
                $("#newMonth").text(s.newCustomersThisMonth.toLocaleString('fa-IR'));
                $("#topCustomerName").text(s.topCustomerName || "ثبت نشده");
                $("#topCustomerAmount").text(s.topCustomerTotalSpent.toLocaleString('fa-IR') + " تومان");
                $("#topCustomerOrders").text(s.topCustomerOrders.toLocaleString('fa-IR'));

                const chartCanvas = document.getElementById('trendChart');
                if (!chartCanvas) return;

                if (trendChart) trendChart.destroy();
                const ctx = chartCanvas.getContext('2d');

                // ایجاد گرادینت زیر خطوط نمودار برای زیبایی دوچندان محیط گراف
                const orangeGradient = ctx.createLinearGradient(0, 0, 0, 200);
                orangeGradient.addColorStop(0, 'rgba(255, 122, 0, 0.25)');
                orangeGradient.addColorStop(1, 'rgba(255, 122, 0, 0.00)');

                const emeraldGradient = ctx.createLinearGradient(0, 0, 0, 200);
                emeraldGradient.addColorStop(0, 'rgba(16, 185, 129, 0.25)');
                emeraldGradient.addColorStop(1, 'rgba(16, 185, 129, 0.00)');

                trendChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: s.last7DaysStats.map(d => d.persianDate),
                        datasets: [
                            {
                                label: 'مشتریان جدید',
                                data: s.last7DaysStats.map(d => d.newCustomers),
                                borderColor: '#ff7a00',
                                backgroundColor: orangeGradient,
                                borderWidth: 3,
                                pointRadius: 4,
                                pointHoverRadius: 6,
                                pointBackgroundColor: '#ff7a00',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 1.5,
                                tension: 0.4, // خمیدگی سافت و زیبا
                                fill: true,
                                yAxisID: 'y'
                            },
                            {
                                label: 'فروش (هزار تومان)',
                                data: s.last7DaysStats.map(d => d.revenue / 1000),
                                borderColor: '#10b981',
                                backgroundColor: emeraldGradient,
                                borderWidth: 3,
                                pointRadius: 4,
                                pointHoverRadius: 6,
                                pointBackgroundColor: '#10b981',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 1.5,
                                tension: 0.4,
                                fill: true,
                                yAxisID: 'y1'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: '#1e293b',
                                titleColor: '#ffffff',
                                bodyColor: '#e2e8f0',
                                padding: 12,
                                cornerRadius: 8,
                                rtl: true,
                                callbacks: {
                                    label: (ctx) => `${ctx.dataset.label}: ${ctx.raw.toLocaleString('fa-IR')}`
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: 'rgba(226, 232, 240, 0.4)' },
                                ticks: { color: '#94a3b8', font: { size: 10 } }
                            },
                            y1: {
                                position: 'right',
                                beginAtZero: true,
                                grid: { display: false },
                                ticks: { color: '#94a3b8', callback: (val) => val.toLocaleString('fa-IR'), font: { size: 10 } }
                            },
                            x: {
                                grid: { display: false },
                                ticks: { color: '#94a3b8', font: { size: 11 } }
                            }
                        }
                    }
                });
            } else {
                showToast(responseData.message, 'error');
            }
        } catch (error) {
            if (!isCustomersListPageCurrent(pageId)) return;
            showToast("خطا در دریافت اطلاعات داشبورد", 'error');
        }
    }

    function renderTotalRecords(totalCount, shownCount) {
        var $info = $("#totalRecordsInfo");
        if (typeof totalCount !== "number") {
            $info.addClass("d-none").empty();
            return;
        }
        $info
            .html(`<i class="fas fa-user-group" aria-hidden="true"></i>
                   <span>نمایش ${shownCount.toLocaleString('fa-IR')} مشتری از مجموع <strong>${totalCount.toLocaleString('fa-IR')}</strong></span>`)
            .removeClass("d-none");
    }

    function renderCustomersWithStats(customers) {
        let html = `<div class="cl-table-wrap">
            <table class="cl-table">
                <thead>
                    <tr>
                        <th>مشتری</th>
                        <th>سفارش‌ها</th>
                        <th>مجموع خرید</th>
                        <th>میانگین خرید</th>
                        <th>روزهای حضور</th>
                        <th>عضویت</th>
                        <th>آخرین تراکنش</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>`;
        customers.forEach(c => {
            const noOrdersHint = c.totalOrders === 0
                ? `<span class="cl-card__hint"><i class="fas fa-circle-exclamation" aria-hidden="true"></i> بدون سفارش بسته</span>`
                : '';
            const descriptionNote = c.description
                ? `<span class="cl-card__note" title="${escapeHtml(c.description)}">
                        <i class="fas fa-note-sticky" aria-hidden="true"></i>
                        <span>${escapeHtml(c.description)}</span>
                   </span>`
                : '';
            html += `
                <tr>
                    <td data-label="مشتری">
                        <div class="cl-card__head">
                            <span class="cl-card__avatar" aria-hidden="true">${escapeHtml(getNameInitial(c.fullName))}</span>
                            <div class="cl-card__ident">
                                <h3 class="cl-card__name" title="${escapeHtml(c.fullName)}">${escapeHtml(c.fullName)}</h3>
                                <span class="cl-card__mobile cl-num">${escapeHtml(c.mobile)}</span>
                                ${descriptionNote}
                                ${noOrdersHint}
                            </div>
                        </div>
                    </td>
                    <td data-label="سفارش‌ها">
                        <span class="cl-statbox__value cl-statbox--orders">${c.totalOrders.toLocaleString('fa-IR')} بار</span>
                    </td>
                    <td data-label="مجموع خرید">
                        <span class="cl-statbox__value cl-statbox--money">${c.totalSpent.toLocaleString('fa-IR')} ت</span>
                    </td>
                    <td data-label="میانگین خرید">
                        <span class="cl-statbox__value">${Math.round(c.averageOrderValue).toLocaleString('fa-IR')} ت</span>
                    </td>
                    <td data-label="روزهای حضور">
                        <span class="cl-statbox__value">${c.totalDistinctDays.toLocaleString('fa-IR')} روز</span>
                    </td>
                    <td data-label="عضویت">
                        <span class="cl-num">${escapeHtml(c.createdAtShamsi)}</span>
                    </td>
                    <td data-label="آخرین تراکنش">
                        <span class="cl-num">${escapeHtml(c.lastOrderDateShamsi)}</span>
                    </td>
                    <td data-label="">
                        <div class="cl-card__actions">
                            <button type="button" class="cl-act cl-act--account open-customer-account" data-id="${c.customerId}" title="گردش حساب">
                                <i class="fas fa-wallet"></i> <span>گردش حساب</span>
                            </button>
                            <button type="button" class="cl-act cl-act--address manage-addresses"
                                    data-id="${c.customerId}"
                                    data-name="${escapeHtml(c.fullName)}"
                                    data-mobile="${escapeHtml(c.mobile)}"
                                    title="آدرس‌ها">
                                <i class="fas fa-map-location-dot"></i> <span>آدرس‌ها</span>
                            </button>
                            <button type="button" class="cl-act cl-act--edit edit-customer"
                                    data-id="${c.customerId}"
                                    data-name="${escapeHtml(c.fullName)}"
                                    data-mobile="${escapeHtml(c.mobile)}"
                                    data-desc="${escapeHtml(c.description || '')}"
                                    title="ویرایش">
                                <i class="fas fa-pen"></i> <span>ویرایش</span>
                            </button>
                            <button type="button" class="cl-act cl-act--delete delete-customer" data-id="${c.customerId}" title="حذف">
                                <i class="fas fa-trash"></i> <span>حذف</span>
                            </button>
                        </div>
                    </td>
                </tr>
            `;
        });
        html += '</tbody></table></div>';
        $("#customersList").html(html);
    }

    function renderPagination(current, total) {
        if (total <= 1) {
            $("#paginationContainer").empty();
            return;
        }
        let html = '<ul class="pagination">';

        // دکمه قبلی
        if (current > 1) {
            html += `<li class="page-item">
                        <a class="page-link" href="#" data-page="${current - 1}"><i class="fas fa-chevron-right me-1"></i> قبلی</a>
                     </li>`;
        } else {
            html += `<li class="page-item disabled"><span class="page-link"><i class="fas fa-chevron-right me-1"></i> قبلی</span></li>`;
        }

        let startPage = Math.max(1, current - 2);
        let endPage = Math.min(total, current + 2);

        if (startPage > 1) {
            html += `<li class="page-item"><a class="page-link" href="#" data-page="1">${(1).toLocaleString('fa-IR')}</a></li>`;
            if (startPage > 2) {
                html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
        }

        for (let i = startPage; i <= endPage; i++) {
            if (i === current) {
                html += `<li class="page-item active" aria-current="page"><span class="page-link">${i.toLocaleString('fa-IR')}</span></li>`;
            } else {
                html += `<li class="page-item"><a class="page-link" href="#" data-page="${i}">${i.toLocaleString('fa-IR')}</a></li>`;
            }
        }

        if (endPage < total) {
            if (endPage < total - 1) {
                html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
            html += `<li class="page-item"><a class="page-link" href="#" data-page="${total}">${total.toLocaleString('fa-IR')}</a></li>`;
        }

        if (current < total) {
            html += `<li class="page-item">
                        <a class="page-link" href="#" data-page="${current + 1}">بعدی <i class="fas fa-chevron-left ms-1"></i></a>
                     </li>`;
        } else {
            html += `<li class="page-item disabled"><span class="page-link">بعدی <i class="fas fa-chevron-left ms-1"></i></span></li>`;
        }

        html += '</ul>';
        $("#paginationContainer").html(html);
    }

    var deleteId = 0;

    function generateAutoMobile() {
        var prefix = '991';
        var timestamp = Date.now().toString();
        var eightDigits = timestamp.slice(2, 10);
        var random = Math.floor(Math.random() * 10);
        return prefix + eightDigits + random;
    }

    function escapeHtml(str) {
        if (!str) return "";
        return String(str).replace(/[&<>"']/g, function (m) {
            if (m === "&") return "&amp;";
            if (m === "<") return "&lt;";
            if (m === ">") return "&gt;";
            if (m === '"') return "&quot;";
            if (m === "'") return "&#39;";
            return m;
        });
    }

    function getNameInitial(name) {
        var trimmed = (name || "").trim();
        return trimmed ? trimmed.charAt(0) : "؟";
    }

    function parseOptionalNumber(val) {
        if (val === null || val === undefined || String(val).trim() === "") return null;
        var n = parseFloat(String(val).trim());
        return isNaN(n) ? null : n;
    }

    function resetAddressForm() {
        $("#addrId").val("0");
        $("#addrTitle").val("");
        $("#addrText").val("");
        $("#addrUnit").val("");
        $("#addrFloor").val("");
        $("#addrPlate").val("");
        $("#addrLat").val("");
        $("#addrLng").val("");
        $("#addrDescription").val("");
        $("#addrIsDefault").prop("checked", false);
        setAddressFormTitle(false);
    }

    function setAddressFormTitle(isEdit) {
        $("#addrFormHeading").text(isEdit ? "ویرایش آدرس" : "ثبت آدرس جدید");
    }

    function getAddressFormModal() {
        var el = document.getElementById("addressFormModal");
        if (!el || !window.bootstrap) return null;
        return bootstrap.Modal.getOrCreateInstance(el);
    }

    function showAddressForm(isEdit) {
        setAddressFormTitle(!!isEdit);
        var inst = getAddressFormModal();
        if (inst) inst.show();
    }

    function hideAddressForm() {
        var el = document.getElementById("addressFormModal");
        var inst = el && window.bootstrap ? bootstrap.Modal.getInstance(el) : null;
        if (inst) inst.hide();
        resetAddressForm();
    }

    function renderAddressList(addresses) {
        addressesCache = Array.isArray(addresses) ? addresses : [];
        if (!addressesCache.length) {
            $("#addrListContainer").html(`
                <div class="cl-addr__empty">
                    <span class="cl-addr__empty-icon"><i class="fas fa-location-dot"></i></span>
                    <strong>هنوز آدرسی ثبت نشده است</strong>
                    <p>با دکمه «آدرس جدید» اولین آدرس این مشتری را اضافه کنید.</p>
                </div>`);
            return;
        }

        let html = '<div class="cl-addr__list">';
        addressesCache.forEach(a => {
            const id = a.addressId ?? a.AddressId;
            const title = a.title ?? a.Title ?? "آدرس";
            const text = a.addressText ?? a.AddressText ?? "";
            const unit = a.unit ?? a.Unit;
            const floor = a.floor ?? a.Floor;
            const plate = a.plateNumber ?? a.PlateNumber;
            const isDefault = !!(a.isDefault ?? a.IsDefault);
            const desc = a.description ?? a.Description;

            let meta = "";
            if (unit) meta += `<span class="cl-addr-chip">واحد ${escapeHtml(unit)}</span>`;
            if (floor) meta += `<span class="cl-addr-chip">طبقه ${escapeHtml(floor)}</span>`;
            if (plate) meta += `<span class="cl-addr-chip">پلاک ${escapeHtml(plate)}</span>`;
            if (desc) meta += `<span class="cl-addr-chip" title="${escapeHtml(desc)}"><i class="fas fa-sticky-note"></i> یادداشت</span>`;

            html += `
                <div class="addr-card ${isDefault ? "is-default" : ""}" data-address-id="${id}">
                    <div class="cl-addr-card__top">
                        <h6 class="cl-addr-card__title">
                            <i class="fas fa-location-dot" aria-hidden="true"></i>
                            <span>${escapeHtml(title)}</span>
                        </h6>
                        ${isDefault ? '<span class="cl-addr-card__badge">پیش‌فرض</span>' : ""}
                    </div>
                    <div class="cl-addr-card__text">${escapeHtml(text)}</div>
                    ${meta ? `<div class="cl-addr-card__meta">${meta}</div>` : ""}
                    <div class="cl-addr-card__actions">
                        <button type="button" class="cl-addr-btn cl-addr-btn--edit btn-edit-address" data-id="${id}">
                            <i class="fas fa-pen"></i> ویرایش
                        </button>
                        <button type="button" class="cl-addr-btn cl-addr-btn--delete btn-delete-address" data-id="${id}">
                            <i class="fas fa-trash"></i> حذف
                        </button>
                    </div>
                </div>`;
        });
        html += "</div>";
        $("#addrListContainer").html(html);
    }

    async function loadCustomerAddresses(customerId) {
        $("#addrListLoading").show();
        $("#addrListContainer").empty();
        try {
            const response = await window.fetchWithAuth(`${API_BASE}/getaddresses/${customerId}`);
            const res = await response.json();
            if (res.success) {
                renderAddressList(res.data || []);
            } else {
                showToast(res.message || "خطا در دریافت آدرس‌ها", "error");
                renderAddressList([]);
            }
        } catch (e) {
            showToast("خطا در ارتباط با سرور برای دریافت آدرس‌ها", "error");
            renderAddressList([]);
        } finally {
            $("#addrListLoading").hide();
        }
    }

    function cleanupAddressesOffcanvasArtifacts() {
        document.querySelectorAll('.offcanvas-backdrop').forEach(function (backdrop) {
            // Keep backdrops that still belong to another open offcanvas
            var openPanels = document.querySelectorAll('.offcanvas.show');
            if (!openPanels.length) backdrop.remove();
        });
        if (!document.querySelector('.offcanvas.show') && !document.querySelector('.modal.show')) {
            document.body.classList.remove('offcanvas-open', 'modal-open');
            document.body.style.removeProperty('overflow');
            document.body.style.removeProperty('padding-right');
        }
    }

    function getAddressesOffcanvasEl() {
        var nodes = Array.from(document.querySelectorAll('#addressesOffcanvas'));
        if (!nodes.length) return null;

        // Soft-nav can leave an old body-mounted panel + a new one in page HTML
        var preferred = document.querySelector('.customers-page #addressesOffcanvas')
            || nodes[nodes.length - 1];

        nodes.forEach(function (el) {
            if (el === preferred) return;
            try {
                if (window.bootstrap && bootstrap.Offcanvas) {
                    var oldInst = bootstrap.Offcanvas.getInstance(el);
                    if (oldInst) oldInst.dispose();
                }
            } catch (_) { /* ignore */ }
            el.remove();
        });

        if (preferred.parentElement !== document.body) {
            document.body.appendChild(preferred);
        }
        return preferred;
    }

    function ensureAddressModalsOnBody() {
        ['addressFormModal', 'deleteAddressModal'].forEach(function (id) {
            var nodes = Array.from(document.querySelectorAll('#' + id));
            if (!nodes.length) return;
            var preferred = document.querySelector('.customers-page #' + id) || nodes[nodes.length - 1];
            nodes.forEach(function (el) {
                if (el === preferred) return;
                try {
                    if (window.bootstrap && bootstrap.Modal) {
                        var oldInst = bootstrap.Modal.getInstance(el);
                        if (oldInst) oldInst.dispose();
                    }
                } catch (_) { /* ignore */ }
                el.remove();
            });
            if (preferred.parentElement !== document.body) {
                document.body.appendChild(preferred);
            }
        });
    }

    function getAddressesOffcanvas() {
        var el = getAddressesOffcanvasEl();
        if (!el || !window.bootstrap || !bootstrap.Offcanvas) return null;
        addressesOffcanvas = bootstrap.Offcanvas.getOrCreateInstance(el, {
            backdrop: true,
            keyboard: true,
            scroll: false
        });
        return addressesOffcanvas;
    }

    function closeAddressesPanel() {
        var el = getAddressesOffcanvasEl();
        var inst = el && window.bootstrap && bootstrap.Offcanvas
            ? (bootstrap.Offcanvas.getInstance(el) || getAddressesOffcanvas())
            : null;
        if (inst) {
            inst.hide();
        } else if (el) {
            el.classList.remove('show');
            el.style.visibility = '';
            cleanupAddressesOffcanvasArtifacts();
        }
        hideAddressForm();
    }

    function openAddressesPanel(customerId, name, mobile) {
        addressCustomerId = parseInt(customerId, 10) || 0;
        $("#addrCustomerId").val(addressCustomerId);
        $("#addrCustomerName").text(name || "—");
        $("#addrCustomerMobile").text(mobile || "—");
        hideAddressForm();

        var inst = getAddressesOffcanvas();
        if (inst) {
            inst.show();
        } else {
            var el = getAddressesOffcanvasEl();
            if (el) {
                el.classList.add('show');
                el.style.visibility = 'visible';
            }
        }
        loadCustomerAddresses(addressCustomerId);
    }

    function fillAddressForm(address) {
        if (!address) return;
        $("#addrId").val(address.addressId ?? address.AddressId ?? 0);
        $("#addrTitle").val(address.title ?? address.Title ?? "");
        $("#addrText").val(address.addressText ?? address.AddressText ?? "");
        $("#addrUnit").val(address.unit ?? address.Unit ?? "");
        $("#addrFloor").val(address.floor ?? address.Floor ?? "");
        $("#addrPlate").val(address.plateNumber ?? address.PlateNumber ?? "");
        var lat = address.latitude ?? address.Latitude;
        var lng = address.longitude ?? address.Longitude;
        $("#addrLat").val(lat != null ? lat : "");
        $("#addrLng").val(lng != null ? lng : "");
        $("#addrDescription").val(address.description ?? address.Description ?? "");
        $("#addrIsDefault").prop("checked", !!(address.isDefault ?? address.IsDefault));
        showAddressForm(true);
    }

    function toEnglishDigits(str) {
        if (!str) return "";
        var arabicMap = { '٠':'0','١':'1','٢':'2','٣':'3','٤':'4','٥':'5','٦':'6','٧':'7','٨':'8','٩':'9' };
        var persianMap = { '۰':'0','۱':'1','۲':'2','۳':'3','۴':'4','۵':'5','۶':'6','۷':'7','۸':'8','۹':'9' };
        var result = str;
        for (var key in persianMap) result = result.split(key).join(persianMap[key]);
        for (var key in arabicMap) result = result.split(key).join(arabicMap[key]);
        return result;
    }

    function bindCustomersListEvents() {
        var ns = '.customersList';

        $("#btnApplyFilter").off('click' + ns).on('click' + ns, function () {
            currentPeriod = $("#periodSelect").val();
            currentSortBy = $("#sortBySelect").val();
            loadCustomers(1, currentSearch, currentPeriod, currentSortBy);
        });

        $("#btnResetSearch").off('click' + ns).on('click' + ns, function () {
            $("#searchInput").val("");
            $("#periodSelect").val("all");
            $("#sortBySelect").val("TotalSpent");
            currentSearch = "";
            currentPeriod = "all";
            currentSortBy = "TotalSpent";
            loadCustomers(1, "", "all", "TotalSpent");
            showToast("فیلترها و مرتب‌سازی بازنشانی شدند", 'info');
        });

        $("#btnSearch").off('click' + ns).on('click' + ns, function () {
            var rawSearch = $("#searchInput").val().trim();
            currentSearch = toEnglishDigits(rawSearch);
            loadCustomers(1, currentSearch);
        });

        $("#searchInput").off('keypress' + ns).on('keypress' + ns, function (e) {
            if (e.which === 13) {
                $("#btnSearch").click();
            }
        });

        $("#btnAddCustomer").off('click' + ns).on('click' + ns, function () {
            editingCustomerId = 0;
            $("#modalTitle").text("افزودن مشتری جدید");
            $("#customerId").val("0");
            $("#fullName").val("");
            $("#mobile").val("");
            $("#description").val("");
            $("#customerModal").modal("show");
        });

        $(document).off('click' + ns, '.edit-customer').on('click' + ns, '.edit-customer', function () {
            editingCustomerId = $(this).data("id");
            $("#modalTitle").text("ویرایش حساب مشتری");
            $("#customerId").val(editingCustomerId);
            $("#fullName").val($(this).data("name"));
            $("#mobile").val($(this).data("mobile"));
            $("#description").val($(this).data("desc"));
            $("#customerModal").modal("show");
        });

        $(document).off('click' + ns, '.open-customer-account').on('click' + ns, '.open-customer-account', function () {
            var id = parseInt($(this).data('id'), 10) || 0;
            if (!id) return;
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '/Home/CustomerAccount';
            form.style.display = 'none';
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'customerId';
            input.value = String(id);
            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        });

        $("#btnSaveCustomer").off('click' + ns).on('click' + ns, async function () {
            var id = $("#customerId").val();
            var fullName = $("#fullName").val().trim();
            var mobile = $("#mobile").val().trim();
            var description = $("#description").val().trim();

            if (id === "0") {
                if (fullName !== "") {
                    if (mobile === "") {
                        mobile = generateAutoMobile();
                    }
                } else {
                    if (!mobile) {
                        showToast("شماره موبایل الزامی است", 'info');
                        $("#mobile").focus();
                        return;
                    }
                    if (!/^09[0-9]{9}$/.test(mobile)) {
                        showToast("شماره موبایل معتبر (11 رقم، شروع با 09) وارد کنید", 'info');
                        $("#mobile").focus();
                        return;
                    }
                    fullName = "مشتری مهمان";
                }
            } else {
                if (!mobile) {
                    showToast("شماره موبایل الزامی است", 'info');
                    $("#mobile").focus();
                    return;
                }
                if (!/^09[0-9]{9}$/.test(mobile)) {
                    showToast("شماره موبایل معتبر (11 رقم، شروع با 09) وارد کنید", 'info');
                    $("#mobile").focus();
                    return;
                }
                if (!fullName) {
                    fullName = "مشتری مهمان";
                }
            }

            var payload = id === "0" ? {
                restaurantId: restaurantId,
                fullName: fullName,
                mobile: mobile,
                description: description
            } : {
                customerId: parseInt(id),
                restaurantId: restaurantId,
                fullName: fullName,
                mobile: mobile,
                description: description
            };

            var url = API_BASE + "/addcustomer";
            var method = "POST";
            if (id !== "0") {
                url = API_BASE + "/editcustomer";
                method = "PUT";
            }

            try {
                var response = await window.fetchWithAuth(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                var res = await response.json();
                if (res.success) {
                    showToast(res.message, 'success');
                    $("#customerModal").modal("hide");
                    loadCustomers(currentPage, currentSearch);
                    loadDashboardStats();
                    loadInsightsCards();
                } else {
                    showToast(res.message, 'error');
                }
            } catch (error) {
                showToast("خطا در برقراری ارتباط با سرور", 'error');
            }
        });

        $(document).off('click' + ns, '.delete-customer').on('click' + ns, '.delete-customer', function () {
            deleteId = $(this).data("id");
            $("#deleteModal").modal("show");
        });

        $(document).off('click' + ns, '.manage-addresses').on('click' + ns, '.manage-addresses', function () {
            openAddressesPanel($(this).data("id"), $(this).data("name"), $(this).data("mobile"));
        });

        $("#btnCloseAddressesOffcanvas").off('click' + ns).on('click' + ns, function (e) {
            e.preventDefault();
            e.stopPropagation();
            closeAddressesPanel();
        });

        var addrEl = getAddressesOffcanvasEl();
        if (addrEl) {
            $(addrEl).off('hidden.bs.offcanvas' + ns).on('hidden.bs.offcanvas' + ns, function () {
                hideAddressForm();
                addressCustomerId = 0;
                addressesCache = [];
                $("#addrListContainer").empty();
                cleanupAddressesOffcanvasArtifacts();
            });
        }

        $("#btnNewAddress").off('click' + ns).on('click' + ns, function () {
            resetAddressForm();
            $("#addrCustomerId").val(addressCustomerId);
            if (!addressesCache.length) $("#addrIsDefault").prop("checked", true);
            showAddressForm(false);
        });

        var addrFormEl = document.getElementById("addressFormModal");
        if (addrFormEl) {
            $(addrFormEl).off('shown.bs.modal' + ns).on('shown.bs.modal' + ns, function () {
                var backdrops = document.querySelectorAll('.modal-backdrop');
                if (backdrops.length) {
                    backdrops[backdrops.length - 1].classList.add('address-form-backdrop');
                }
            });
            $(addrFormEl).off('hidden.bs.modal' + ns).on('hidden.bs.modal' + ns, function () {
                resetAddressForm();
                if (addressCustomerId) {
                    $("#addrCustomerId").val(addressCustomerId);
                }
            });
        }

        $(document).off('click' + ns, '.btn-edit-address').on('click' + ns, '.btn-edit-address', function () {
            var id = parseInt($(this).data("id"), 10);
            var found = addressesCache.find(a => (a.addressId ?? a.AddressId) == id);
            if (found) fillAddressForm(found);
        });

        $(document).off('click' + ns, '.btn-delete-address').on('click' + ns, '.btn-delete-address', function () {
            deleteAddressId = parseInt($(this).data("id"), 10) || 0;
            $("#deleteAddressModal").modal("show");
        });

        $("#btnConfirmDeleteAddress").off('click' + ns).on('click' + ns, async function () {
            if (!deleteAddressId || !addressCustomerId) return;
            try {
                const response = await window.fetchWithAuth(`${API_BASE}/deleteaddress`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        addressId: deleteAddressId,
                        customerId: addressCustomerId
                    })
                });
                const res = await response.json();
                if (res.success) {
                    showToast(res.message || "آدرس حذف شد", "success");
                    $("#deleteAddressModal").modal("hide");
                    if (parseInt($("#addrId").val(), 10) === deleteAddressId) hideAddressForm();
                    await loadCustomerAddresses(addressCustomerId);
                } else {
                    showToast(res.message || "حذف آدرس ناموفق بود", "error");
                }
            } catch (e) {
                showToast("خطا در حذف آدرس", "error");
            }
        });

        $("#btnSaveAddress").off('click' + ns).on('click' + ns, async function () {
            var customerId = parseInt($("#addrCustomerId").val(), 10) || addressCustomerId;
            var addressText = ($("#addrText").val() || "").trim();
            if (!customerId) {
                showToast("مشتری مشخص نیست.", "error");
                return;
            }
            if (!addressText) {
                showToast("متن آدرس الزامی است.", "error");
                return;
            }

            var addressId = parseInt($("#addrId").val(), 10) || 0;
            var payload = {
                customerId: customerId,
                title: ($("#addrTitle").val() || "").trim() || "آدرس",
                addressText: addressText,
                unit: ($("#addrUnit").val() || "").trim().substring(0, 10) || "",
                floor: ($("#addrFloor").val() || "").trim().substring(0, 10) || "",
                plateNumber: ($("#addrPlate").val() || "").trim().substring(0, 10) || "",
                isDefault: $("#addrIsDefault").prop("checked") === true,
                description: ($("#addrDescription").val() || "").trim() || ""
            };
            var lat = parseOptionalNumber($("#addrLat").val());
            var lng = parseOptionalNumber($("#addrLng").val());
            if (lat != null) payload.latitude = lat;
            if (lng != null) payload.longitude = lng;

            var url = `${API_BASE}/addaddress`;
            if (addressId > 0) {
                url = `${API_BASE}/editaddress`;
                payload.addressId = addressId;
            }

            var $btn = $("#btnSaveAddress").prop("disabled", true);
            try {
                const response = await window.fetchWithAuth(url, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                });
                let res = {};
                try { res = await response.json(); } catch (_) { res = {}; }
                if (response.ok && res.success) {
                    showToast(res.message || "آدرس ذخیره شد", "success");
                    hideAddressForm();
                    await loadCustomerAddresses(customerId);
                } else {
                    showToast(res.message || res.detail || ("ذخیره آدرس ناموفق بود" + (response.status ? ` (${response.status})` : "")), "error");
                }
            } catch (e) {
                showToast("خطا در ذخیره آدرس", "error");
            } finally {
                $btn.prop("disabled", false);
            }
        });

        $("#confirmDelete").off('click' + ns).on('click' + ns, async function () {
            try {
                var response = await window.fetchWithAuth(API_BASE + "/deletecustomer", {
                    method: "DELETE",
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        customerId: deleteId,
                        restaurantId: restaurantId
                    })
                });
                var res = await response.json();
                if (res.success) {
                    showToast(res.message, 'success');
                    $("#deleteModal").modal("hide");
                    loadCustomers(currentPage, currentSearch);
                    loadDashboardStats();
                    loadInsightsCards();
                } else {
                    showToast(res.message, 'error');
                }
            } catch (error) {
                showToast("خطا در حذف اطلاعات مشتری", 'error');
            }
        });

        $(document).off('click' + ns, '.page-link').on('click' + ns, '.page-link', function (e) {
            e.preventDefault();
            var page = $(this).data("page");
            if (page) loadCustomers(page, currentSearch, currentPeriod, currentSortBy);
        });

        $("#exportBtn").off('click' + ns).on('click' + ns, openCustomersExportFormatModal);
        $("#exportFormatExcel").off('click' + ns).on('click' + ns, function (e) { handleCustomersExportClick(e, 'excel'); });
        $("#exportFormatPdf").off('click' + ns).on('click' + ns, function (e) { handleCustomersExportClick(e, 'pdf'); });
    }

    function getCustomersExportQuery() {
        var rawSearch = ($("#searchInput").val() || "").trim();
        var params = new URLSearchParams({
            search: toEnglishDigits(rawSearch),
            period: $("#periodSelect").val() || "all",
            sortBy: $("#sortBySelect").val() || "TotalSpent"
        });
        return params.toString();
    }

    function showCustomersExportLoading(format) {
        var overlay = document.getElementById('exportLoadingOverlay');
        if (!overlay) return;
        var textEl = overlay.querySelector('.cl-overlay__text');
        if (textEl) {
            textEl.textContent = format === 'pdf'
                ? 'در حال آماده‌سازی فایل PDF...'
                : 'در حال آماده‌سازی فایل اکسل...';
        }
        overlay.style.display = 'flex';
        overlay.setAttribute('aria-hidden', 'false');
    }

    function hideCustomersExportLoading() {
        var overlay = document.getElementById('exportLoadingOverlay');
        if (!overlay) return;
        overlay.style.display = 'none';
        overlay.setAttribute('aria-hidden', 'true');
    }

    function openCustomersExportFormatModal(e) {
        if (e) e.preventDefault();
        var modalEl = document.getElementById('exportFormatModal');
        if (!modalEl || typeof bootstrap === 'undefined') {
            handleCustomersExportClick(e || { preventDefault: function () {} }, 'excel');
            return;
        }
        bootstrap.Modal.getOrCreateInstance(modalEl).show();
    }

    function showCustomersExportEmptyModal(message) {
        var modalEl = document.getElementById('exportNoOrdersModal');
        if (!modalEl || typeof bootstrap === 'undefined') {
            showToast(message || 'هیچ مشتری‌ای با این فیلتر یافت نشد.', 'error');
            return;
        }
        var msgEl = document.getElementById('exportNoOrdersMessage');
        if (msgEl) {
            msgEl.textContent = message || 'هیچ مشتری‌ای با این فیلتر یافت نشد.';
        }
        bootstrap.Modal.getOrCreateInstance(modalEl).show();
    }

    function getExportFileName(contentDisposition, fallbackName) {
        if (!contentDisposition) return fallbackName;
        var utf8Match = contentDisposition.match(/filename\*=UTF-8''([^;]+)/i);
        if (utf8Match && utf8Match[1]) {
            try {
                return decodeURIComponent(utf8Match[1].trim());
            } catch (err) {
                return utf8Match[1].trim();
            }
        }
        var match = contentDisposition.match(/filename="?([^";]+)"?/i);
        return match && match[1] ? match[1].trim() : fallbackName;
    }

    async function handleCustomersExportClick(e, format) {
        if (e) e.preventDefault();

        var isPdf = format === 'pdf';
        var baseUrl = isPdf ? exportCustomersPdfUrl : exportCustomersExcelUrl;
        if (!baseUrl) return;

        var formatModalEl = document.getElementById('exportFormatModal');
        if (formatModalEl && typeof bootstrap !== 'undefined') {
            var formatModal = bootstrap.Modal.getInstance(formatModalEl);
            if (formatModal) formatModal.hide();
        }

        var exportBtn = document.getElementById('exportBtn');
        if (exportBtn) {
            exportBtn.classList.add('disabled');
            exportBtn.setAttribute('aria-disabled', 'true');
            exportBtn.disabled = true;
        }
        showCustomersExportLoading(format);

        try {
            var res = await fetch(baseUrl + '?' + getCustomersExportQuery(), { credentials: 'same-origin' });
            if (!res.ok) {
                var message = (await res.text()).trim() || 'هیچ مشتری‌ای با این فیلتر یافت نشد.';
                showCustomersExportEmptyModal(message);
                return;
            }

            var blob = await res.blob();
            var fileName = getExportFileName(
                res.headers.get('Content-Disposition'),
                isPdf ? 'CustomersReport.pdf' : 'CustomersReport.xlsx'
            );
            var url = URL.createObjectURL(blob);
            var link = document.createElement('a');
            link.href = url;
            link.download = fileName;
            document.body.appendChild(link);
            link.click();
            link.remove();
            URL.revokeObjectURL(url);
        } catch (error) {
            showCustomersExportEmptyModal(
                isPdf
                    ? 'خطا در دانلود فایل PDF. لطفا دوباره تلاش کنید.'
                    : 'خطا در دانلود فایل اکسل. لطفا دوباره تلاش کنید.'
            );
        } finally {
            hideCustomersExportLoading();
            if (exportBtn) {
                exportBtn.classList.remove('disabled');
                exportBtn.removeAttribute('aria-disabled');
                exportBtn.disabled = false;
            }
        }
    }

    function initCustomersListPage() {
        if (!document.querySelector('.customers-page')) return;

        customersListPageId++;
        if (trendChart) {
            trendChart.destroy();
            trendChart = null;
        }

        currentPage = 1;
        pageSize = 12;
        currentSearch = "";
        editingCustomerId = 0;
        currentPeriod = "all";
        currentSortBy = "TotalSpent";
        deleteId = 0;
        deleteAddressId = 0;
        addressCustomerId = 0;
        addressesCache = [];
        addressesOffcanvas = null;

        // Mount once under body so Bootstrap close/backdrop is reliable
        getAddressesOffcanvasEl();
        ensureAddressModalsOnBody();
        cleanupAddressesOffcanvasArtifacts();

        bindCustomersListEvents();

        if (restaurantId > 0) {
            loadCustomers(1, "", "all", "TotalSpent");
            loadDashboardStats();
            loadInsightsCards();
        } else {
            $("#customersList").html(`
                <div class="cl-empty">
                    <div class="cl-empty__icon"><i class="fas fa-triangle-exclamation"></i></div>
                    <strong>شناسه رستوران نامعتبر است</strong>
                    <p>برای مشاهده باشگاه مشتریان، ابتدا رستوران خود را انتخاب کنید.</p>
                </div>`);
        }
    }

    window.initCustomersListPage = initCustomersListPage;
</script>
