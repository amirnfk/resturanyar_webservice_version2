    function loadCustomers(page, search, period, sortBy) {
        currentPage = page || 1;
        currentSearch = search !== undefined ? search : currentSearch;
        currentPeriod = period !== undefined ? period : currentPeriod;
        currentSortBy = sortBy !== undefined ? sortBy : currentSortBy;
        $("#loadingSpinner").removeClass("d-none");
        $("#customersList").empty();

        $.ajax({
            url: `/api/Customers/getcustomerswithstats/${restaurantId}`,
            type: "GET",
            data: {
                page: currentPage,
                pageSize: pageSize,
                search: currentSearch,
                period: currentPeriod,
                sortBy: currentSortBy
            },
            success: function(response) {
                if (response.success) {
                    if (response.data && response.data.length > 0) {
                        renderCustomersWithStats(response.data);
                        renderPagination(response.currentPage, response.totalPages);
