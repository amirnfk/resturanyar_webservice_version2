@{
    ViewData["Title"] = "مدیریت و آنالیز مشتریان";
    var placeholder = Url.Content("~/images/customer_placeholder.png");
}
<link href="~/css/bootstrap_rtl_min.css" rel="stylesheet" />

<link rel="stylesheet" href="~/css/toastr.min.css" />
<style>
    :root {
        --primary: #ff7a00;
        --primary-hover: #e66900;
        --primary-light: rgba(255, 122, 0, 0.08);
        --bg-page: #f4f6fa;
        --card-bg: #ffffff;
        --card-border: #eef2f6;
        --shadow-sm: 0 4px 10px rgba(15, 23, 42, 0.03);
        --shadow-md: 0 10px 25px rgba(15, 23, 42, 0.05);
        --shadow-lg: 0 20px 35px rgba(15, 23, 41, 0.08);
        --text-dark: #0f172a;
        --text-muted: #64748b;
        --radius-sm: 12px;
        --radius-md: 18px;
        --radius-lg: 24px;
        --radius-pill: 999px;
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body {
        background: var(--bg-page);
        direction: rtl;
        font-family: "IRANYekan", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: var(--text-dark);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    /* استایل‌های کارت‌های بالایی */
    .insights-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm);
        transition: var(--transition);
        overflow: hidden;
    }

        .insights-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg);
        }

    .insights-card-header {
        font-weight: 800;
        font-size: 0.95rem;
        color: var(--text-dark);
        border-bottom: 1px solid #f1f5f9;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .icon-box-primary {
        width: 48px;
        height: 48px;
        border-radius: var(--radius-sm);
        background: var(--primary-light);
        color: var(--primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        transition: var(--transition);
    }

    .insights-card:hover .icon-box-primary {
        background: var(--primary);
        color: white;
    }

    .icon-box-warning {
        width: 48px;
        height: 48px;
        border-radius: var(--radius-sm);
        background: rgba(245, 158, 11, 0.1);
        color: #f59e0b;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        transition: var(--transition);
    }

    .insights-card:hover .icon-box-warning {
        background: #f59e0b;
        color: white;
    }

    /* لیست‌های داخل کارتها */
    .scrollable-list {
        max-height: 210px;
        overflow-y: auto;
        padding: 8px 16px 16px 16px;
    }

        .scrollable-list::-webkit-scrollbar {
            width: 5px;
        }

        .scrollable-list::-webkit-scrollbar-track {
            background: #f8fafc;
        }

        .scrollable-list::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: var(--radius-pill);
        }

    .list-item-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #f1f5f9;
        transition: var(--transition);
    }

        .list-item-row:last-child {
            border-bottom: none;
        }

    /* پیشرفت بار سفارشی در نرخ بازگشت */
    .progress-wrapper {
        padding: 10px 0;
        border-bottom: 1px solid #f1f5f9;
    }

        .progress-wrapper:last-child {
            border-bottom: none;
        }

    .progress-item-label {
        font-size: 0.82rem;
        color: var(--text-muted);
        display: flex;
        justify-content: space-between;
        margin-bottom: 6px;
        font-weight: 500;
    }

    .progress {
        height: 8px;
        background-color: #f1f5f9;
        border-radius: var(--radius-pill);
    }

    .progress-bar {
        border-radius: var(--radius-pill);
        background: linear-gradient(90deg, #ff9e43, var(--primary));
    }

    /* نمودار پرمیوم */
    .premium-chart-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm);
        padding: 24px;
        transition: var(--transition);
    }

        .premium-chart-card:hover {
            box-shadow: var(--shadow-md);
        }

    .chart-legend-indicator {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8rem;
        color: var(--text-muted);
        font-weight: 600;
    }

    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    /* نوار ابزار */
    .customers-toolbar {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm);
        padding: 24px;
        margin-bottom: 28px;
    }

        .customers-toolbar .form-control,
        .customers-toolbar .form-select {
            border-radius: var(--radius-sm);
            border: 1px solid #e2e8f0;
            padding: 10px 14px;
            font-size: 0.9rem;
            transition: var(--transition);
        }

            .customers-toolbar .form-control:focus,
            .customers-toolbar .form-select:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 4px rgba(255,122,0,0.12);
            }

    .btn-primary {
        background: linear-gradient(135deg, var(--primary), #ff9100);
        border: none;
        border-radius: var(--radius-sm);
        font-weight: 700;
        padding: 10px 24px;
        box-shadow: 0 8px 20px rgba(255, 122, 0, 0.2);
        transition: var(--transition);
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #ff9100, var(--primary-hover));
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(255, 122, 0, 0.3);
        }

    .btn-outline-primary {
        border-color: var(--primary);
        color: var(--primary);
        border-radius: var(--radius-sm);
        transition: var(--transition);
    }

        .btn-outline-primary:hover {
            background-color: var(--primary);
            border-color: var(--primary);
            color: white;
        }

    /* کارت‌های تکی مشتریان */
    .customer-card {
        border: 1px solid var(--card-border);
        border-radius: var(--radius-md);
        background: var(--card-bg);
        box-shadow: var(--shadow-sm);
        transition: var(--transition);
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

        .customer-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-lg);
        }

    .customer-header {
        background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
        padding: 24px 20px 16px 20px;
        text-align: center;
        border-bottom: 1px solid var(--card-border);
    }

    .avatar-icon {
        width: 76px;
        height: 76px;
        background: linear-gradient(135deg, var(--primary-light), rgba(255,122,0,0.2));
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        font-size: 2.2rem;
        color: var(--primary);
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
    }

    .customer-name {
        font-weight: 900;
        font-size: 1.15rem;
        margin-bottom: 6px;
        color: var(--text-dark);
    }

    .customer-mobile {
        color: var(--text-muted);
        font-size: 0.85rem;
        direction: ltr;
        letter-spacing: 0.5px;
        display: inline-block;
    }

    .customer-body {
        padding: 16px 20px;
        flex: 1;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        font-size: 0.85rem;
        border-bottom: 1px dashed #f1f5f9;
        padding-bottom: 8px;
    }

        .info-row:last-child {
            margin-bottom: 0;
            border-bottom: none;
            padding-bottom: 0;
        }

    .info-label {
        font-weight: 600;
        color: var(--text-muted);
    }

    .info-value {
        font-weight: 700;
        color: var(--text-dark);
    }

    .customer-footer {
        padding: 16px 20px;
        background: #fafdff;
        border-top: 1px solid var(--card-border);
        display: flex;
        gap: 10px;
    }

        .customer-footer .btn {
            flex: 1;
            font-size: 0.82rem;
            padding: 8px 0;
            border-radius: var(--radius-sm);
            font-weight: 600;
        }

    /* مخفی کردن نوار اسکرول در لیست‌های کشویی (رشد جدید و بهترین مشتریان) */
    .scrollable-list {
        overflow-y: auto; /* قابلیت اسکرول حفظ می‌شود */
        scrollbar-width: none; /* برای فایرفاکس: نوار اسکرول مخفی */
        -ms-overflow-style: none; /* برای اینترنت اکسپلورر و اج قدیم */
    }

        /* برای مرورگرهای وب‌کیت (کروم، اج جدید، سافاری) */
        .scrollable-list::-webkit-scrollbar {
            display: none;
        }
</style>

<div class="container py-4">
    <!-- هدر صفحه -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0 fw-black">   </h4>
        <button class="btn btn-primary" id="btnAddCustomer">
            <i class="fas fa-plus me-1"></i> مشتری جدید
        </button>
    </div>

    <!-- ========== بخش اینفوگرافیک پرمیوم ========== -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-5 g-4 mb-4" id="infographicsRow">
        <!-- کارت ۱: کل مشتریان فعال -->
        <div class="col">
            <div class="insights-card h-100 d-flex flex-column justify-content-between p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="text-muted small fw-semibold">کل مشتریان فعال</span>
                        <h1 class="mb-0 fw-black mt-2 text-dark" id="totalCustomers">0</h1>
                    </div>
                    <div class="icon-box-primary">
                        <i class="fas fa-users"></i>
                    </div>
                </div>
                <div>
                    <hr class="my-2" style="opacity: 0.08;">
                    <div class="d-flex justify-content-between small text-muted">
                        <span>امروز: <strong class="text-dark" id="newToday">0</strong></span>
                        <span>این هفته: <strong class="text-dark" id="newWeek">0</strong></span>
                        <span>این ماه: <strong class="text-dark" id="newMonth">0</strong></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- کارت ۲: مشتری ویژه ماه -->
        <div class="col">
            <div class="insights-card h-100 d-flex flex-column justify-content-between p-4">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="text-muted small fw-semibold">مشتری ویژه ماه</span>
                        <h6 class="mb-0 fw-bold mt-2 text-truncate" id="topCustomerName" style="max-width: 130px;">-</h6>
                        <span class="small fw-black text-primary mt-1 d-block" id="topCustomerAmount">0 تومان</span>
                    </div>
                    <div class="icon-box-warning">
                        <i class="fas fa-crown"></i>
                    </div>
                </div>
                <div>
                    <hr class="my-2" style="opacity: 0.08;">
                    <div class="small text-muted d-flex justify-content-between">
                        <span>تعداد سفارش:</span>
                        <strong class="text-dark" id="topCustomerOrders">0</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- کارت ۳: رشد مشتریان ۷ روزه -->
        <div class="col">
            <div class="insights-card h-100">
                <div class="insights-card-header">
                    <i class="fas fa-chart-line text-success"></i> رشد جدید (۷ روز اخیر)
                </div>
                <div class="scrollable-list" id="growthCustomersList">
                    <div class="text-center py-5 text-muted small"><i class="fas fa-spinner fa-spin"></i> بارگذاری...</div>
                </div>
            </div>
        </div>

        <!-- کارت ۴: نرخ بازگشت مشتری -->
        <div class="col">
            <div class="insights-card h-100">
                <div class="insights-card-header">
                    <i class="fas fa-history text-info"></i> نرخ بازگشت مشتری
                </div>
                <div class="scrollable-list" id="returnRatesList" style="padding: 12px 16px;">
                    <div class="text-center py-5 text-muted small"><i class="fas fa-spinner fa-spin"></i> بارگذاری...</div>
                </div>
            </div>
        </div>

        <!-- کارت ۵: بهترین مشتریان -->
        <div class="col">
            <div class="insights-card h-100">
                <div class="insights-card-header">
                    <i class="fas fa-award text-warning"></i> بهترین مشتریان 
                </div>
                <div class="scrollable-list" id="bestCustomersList">
                    <div class="text-center py-5 text-muted small"><i class="fas fa-spinner fa-spin"></i> بارگذاری...</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== نمودار روند جدید پرمیوم ========== -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="premium-chart-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h6 class="mb-1 fw-bold text-dark"><i class="far fa-chart-bar text-primary me-1"></i> روند هفتگی فروش و جذب جذب مشتری</h6>
                        <span class="text-muted small">فروش رستوران و مشتریان جدید در ۷ روز اخیر</span>
                    </div>
                    <div class="d-flex gap-3">
                        <span class="chart-minimal-card chart-legend-indicator">
                            <span class="legend-dot" style="background: #ff7a00;"></span> مشتریان جدید
                        </span>
                        <span class="chart-minimal-card chart-legend-indicator">
                            <span class="legend-dot" style="background: #10b981;"></span> مجموع فروش (هزار تومان)
                        </span>
                    </div>
                </div>
                <div style="position: relative; width: 100%;">
                    <canvas id="trendChart" height="90" style="max-height: 220px; width: 100%;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- نوار ابزار جستجو و فیلتر -->
    <div class="customers-toolbar">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-bold text-dark small">جستجو عمومی</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" id="searchInput" class="form-control border-start-0" placeholder="نام، شماره موبایل  ..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold text-dark small">&nbsp;</label>
                <button id="btnSearch" class="btn btn-primary w-100">
                    اعمال فیلتر جستجو
                </button>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold text-dark small">&nbsp;</label>
                <button id="btnResetSearch" class="btn btn-outline-secondary w-100" style="padding: 10px 0; border-radius: var(--radius-sm);">
                    <i class="fas fa-undo-alt me-1"></i> بازنشانی کامل
                </button>
            </div>
        </div>
        <hr class="my-4" style="opacity: 0.1;">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-bold text-dark small">بازه زمانی ثبت سفارش</label>
                <select id="periodSelect" class="form-select">
                    <option value="all">همه زمان‌ها</option>
                    <option value="today">امروز</option>
                    <option value="week">هفته گذشته</option>
                    <option value="month">ماه جاری</option>
                    <option value="year">سال گذشته</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold text-dark small">مرتب‌سازی بر اساس</label>
                <select id="sortBySelect" class="form-select">
                    <option value="TotalSpent">بیشترین مبلغ خرید</option>
                    <option value="TotalOrders">بیشترین تعداد سفارش</option>
                    <option value="TotalDistinctDays">بیشترین روزهای حضور</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold text-dark small">&nbsp;</label>
                <button id="btnApplyFilter" class="btn btn-dark w-100" style="padding: 10px 0; border-radius: var(--radius-sm); font-weight: 700;">
                    <i class="fas fa-sliders-h me-1"></i> اعمال فیلتر و رتبه‌بندی
                </button>
            </div>
        </div>
    </div>

    <!-- بارگذاری و نشانگر لودینگ -->
    <div id="loadingSpinner" class="text-center py-5 d-none">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">در حال بارگذاری...</span>
        </div>
    </div>

    <!-- لیست مشتریان -->
    <div id="customersList"></div>
    <div id="totalRecordsInfo" class="text-muted text-center mt-3 mb-2" style="display: none; font-weight: 600;"></div>

    <!-- صفحه‌بندی -->
    <div id="paginationContainer" class="d-flex justify-content-center mt-5"></div>
</div>

<!-- مودال افزودن/ویرایش مشتری -->
<div class="modal fade" id="customerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">افزودن مشتری جدید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body p-4">
                <form id="customerForm">
                    <input type="hidden" id="customerId" value="0" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">نام کامل</label>
                        <input type="text" id="fullName" class="form-control" placeholder="مثال: علیرضا شایان" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">شماره موبایل</label>
                        <input type="tel" id="mobile" class="form-control" placeholder="۰۹۱۲۳۴۵۶۷۸۹" required dir="ltr" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">توضیحات (اختیاری)</label>
                        <textarea id="description" class="form-control" placeholder="یادداشت در خصوص ترجیحات مشتری..." rows="3"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer" style="background: #f8fafc;">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal" style="border-radius: var(--radius-sm);">انصراف</button>
                <button type="button" id="btnSaveCustomer" class="btn btn-primary px-4">ذخیره اطلاعات</button>
            </div>
        </div>
    </div>
</div>

<!-- مودال تأیید حذف -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="fas fa-exclamation-triangle me-1"></i> حذف مشتری</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 text-center">
                آیا از حذف این مشتری و کل تاریخچه اطلاعات او اطمینان دارید؟
            </div>
            <div class="modal-footer justify-content-center border-0 pt-0" style="background: #ffffff;">
                <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal" style="border-radius: var(--radius-sm);">لغو عملیات</button>
                <button type="button" id="confirmDelete" class="btn btn-danger px-4" style="border-radius: var(--radius-sm);">بله، حذف شود</button>
            </div>
        </div>
    </div>
</div>

<script src="~/js/jquery_3.6.0.min.js"></script>
<script src="~/js/bootstrap.bundle.min.js"></script>
<script src="~/js/toastr.min.js"></script>
<script src="~/js/chart.umd.min.js"></script>
<script>
    toastr.options = {
        "positionClass": "toast-top-left",
        "timeOut": "3000",
        "closeButton": true,
        "progressBar": true,
        "rtl": true
    };
    var restaurantId = @(ViewBag.RestaurantId ?? 0);
    var currentPage = 1;
    var pageSize = 12;
    var currentSearch = "";
    var editingCustomerId = 0;
    var currentPeriod = "all";
    var currentSortBy = "TotalSpent";

    function loadInsightsCards() {
        $.ajax({
            url: `/api/Customers/getcustomerinsights/${restaurantId}`,
            type: "GET",
            success: function(response) {
                if (response.success) {
                    const data = response.data;

                    // ۱. رشد مشتریان جدید (۷ روز اخیر)
                    let growthHtml = '';
                    data.growthCustomers.forEach(c => {
                        growthHtml += `
                            <div class="list-item-row">
                                <div>
                                    <strong class="text-dark d-block" style="font-size:0.87rem;">${escapeHtml(c.name)}</strong>
                                    <span class="small text-muted">${c.orderCount} سفارش در هفته</span>
                                </div>
                                <div class="fw-black text-primary small">${c.amount.toLocaleString('fa-IR')} ت</div>
                            </div>
                        `;
                    });
