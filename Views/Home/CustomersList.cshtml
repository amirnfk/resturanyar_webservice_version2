@{
    ViewData["Title"] = "مدیریت و آنالیز مشتریان";
    var placeholder = Url.Content("~/images/customer_placeholder.png");
}

@section Styles {
    <link rel="stylesheet" href="~/css/brand-scrollbar.css" asp-append-version="true" />
}

<style>
    :root {
        --primary: #ff7a00;
        --primary-hover: #e66900;
        --primary-light: rgba(255, 122, 0, 0.08);
        --bg-page: #f4f6fa;
        --card-bg: #ffffff;
        --card-border: #eef2f6;
        --shadow-sm: 0 4px 10px rgba(15, 23, 42, 0.03);
        --shadow-md: 0 10px 25px rgba(15, 23, 42, 0.05);
        --shadow-lg: 0 20px 35px rgba(15, 23, 41, 0.08);
        --text-dark: #0f172a;
        --text-muted: #64748b;
        --radius-sm: 12px;
        --radius-md: 18px;
        --radius-lg: 24px;
        --radius-pill: 999px;
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .customers-page {
        direction: rtl;
        font-family: "IRANYekan", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: var(--text-dark);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    /* استایل‌های کارت‌های بالایی */
    .insights-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm);
        transition: var(--transition);
        overflow: hidden;
    }

        .insights-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg);
        }

    .insights-card-header {
        font-weight: 800;
        font-size: 0.95rem;
        color: var(--text-dark);
        border-bottom: 1px solid #f1f5f9;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .icon-box-primary {
        width: 48px;
        height: 48px;
        border-radius: var(--radius-sm);
        background: var(--primary-light);
        color: var(--primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        transition: var(--transition);
    }

    .insights-card:hover .icon-box-primary {
        background: var(--primary);
        color: white;
    }

    .icon-box-warning {
        width: 48px;
        height: 48px;
        border-radius: var(--radius-sm);
        background: rgba(245, 158, 11, 0.1);
        color: #f59e0b;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        transition: var(--transition);
    }

    .insights-card:hover .icon-box-warning {
        background: #f59e0b;
        color: white;
    }

    /* لیست‌های داخل کارتها */
    .scrollable-list {
        max-height: 210px;
        overflow-y: auto;
        padding: 8px 16px 16px 16px;
    }

    .list-item-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #f1f5f9;
        transition: var(--transition);
        gap: 8px;
    }

        .list-item-row:last-child {
            border-bottom: none;
        }

    /* رشد جدید — فشرده و خوانا در موبایل */
    #growthCustomersList {
        padding: 4px 12px 10px;
    }

    .growth-item {
        align-items: center;
        padding: 6px 0;
        min-width: 0;
    }

    .growth-item__main {
        min-width: 0;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 1px;
    }

    .growth-item__name {
        font-size: 0.8rem;
        font-weight: 800;
        color: var(--text-dark);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.3;
    }

    .growth-item__meta {
        font-size: 0.68rem;
        color: var(--text-muted);
        line-height: 1.2;
    }

    .growth-item__amount {
        flex-shrink: 0;
        font-size: 0.72rem;
        font-weight: 800;
        color: var(--primary);
        white-space: nowrap;
        direction: ltr;
        unicode-bidi: isolate;
    }

    @@media (max-width: 991.98px) {
        #growthCustomersList {
            max-height: 168px;
            padding: 2px 10px 8px;
        }

        .insights-card:has(#growthCustomersList) .insights-card-header {
            padding: 10px 12px;
            font-size: 0.8rem;
            gap: 6px;
        }

        .growth-item {
            padding: 5px 0;
        }

        .growth-item__name {
            font-size: 0.76rem;
        }

        .growth-item__meta {
            font-size: 0.64rem;
        }

        .growth-item__amount {
            font-size: 0.68rem;
        }
    }

    @@media (max-width: 575.98px) {
        #growthCustomersList {
            max-height: 148px;
        }

        .growth-item {
            padding: 4px 0;
            gap: 6px;
        }

        .growth-item__name {
            font-size: 0.74rem;
            max-width: 9.5rem;
        }

        .growth-item__amount {
            font-size: 0.66rem;
            letter-spacing: -0.01em;
        }
    }

    /* پیشرفت بار سفارشی در نرخ بازگشت */
    .progress-wrapper {
        padding: 10px 0;
        border-bottom: 1px solid #f1f5f9;
    }

        .progress-wrapper:last-child {
            border-bottom: none;
        }

    .progress-item-label {
        font-size: 0.82rem;
        color: var(--text-muted);
        display: flex;
        justify-content: space-between;
        margin-bottom: 6px;
        font-weight: 500;
    }

    .progress {
        height: 8px;
        background-color: #f1f5f9;
        border-radius: var(--radius-pill);
    }

    .progress-bar {
        border-radius: var(--radius-pill);
        background: linear-gradient(90deg, #ff9e43, var(--primary));
    }

    /* نمودار پرمیوم */
    .premium-chart-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm);
        padding: 24px;
        transition: var(--transition);
    }

        .premium-chart-card:hover {
            box-shadow: var(--shadow-md);
        }

    .chart-legend-indicator {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8rem;
        color: var(--text-muted);
        font-weight: 600;
    }

    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    /* نوار ابزار */
    .customers-toolbar {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm);
        padding: 24px;
        margin-bottom: 28px;
    }

        .customers-toolbar .form-control,
        .customers-toolbar .form-select {
            border-radius: var(--radius-sm);
            border: 1px solid #e2e8f0;
            padding: 10px 14px;
            font-size: 0.9rem;
            transition: var(--transition);
        }

            .customers-toolbar .form-control:focus,
            .customers-toolbar .form-select:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 4px rgba(255,122,0,0.12);
            }

    .btn-primary {
        background: linear-gradient(135deg, var(--primary), #ff9100);
        border: none;
        border-radius: var(--radius-sm);
        font-weight: 700;
        padding: 10px 24px;
        box-shadow: 0 8px 20px rgba(255, 122, 0, 0.2);
        transition: var(--transition);
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #ff9100, var(--primary-hover));
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(255, 122, 0, 0.3);
        }

    .btn-outline-primary {
        border-color: var(--primary);
        color: var(--primary);
        border-radius: var(--radius-sm);
        transition: var(--transition);
    }

        .btn-outline-primary:hover {
            background-color: var(--primary);
            border-color: var(--primary);
            color: white;
        }

    /* کارت‌های تکی مشتریان */
    .customer-card {
        border: 1px solid var(--card-border);
        border-radius: var(--radius-md);
        background: var(--card-bg);
        box-shadow: var(--shadow-sm);
        transition: var(--transition);
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

        .customer-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-lg);
        }

    .customer-header {
        background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
        padding: 24px 20px 16px 20px;
        text-align: center;
        border-bottom: 1px solid var(--card-border);
    }

    .avatar-icon {
        width: 76px;
        height: 76px;
        background: linear-gradient(135deg, var(--primary-light), rgba(255,122,0,0.2));
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        font-size: 2.2rem;
        color: var(--primary);
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
    }

    .customer-name {
        font-weight: 900;
        font-size: 1.15rem;
        margin-bottom: 6px;
        color: var(--text-dark);
    }

    .customer-mobile {
        color: var(--text-muted);
        font-size: 0.85rem;
        direction: ltr;
        letter-spacing: 0.5px;
        display: inline-block;
    }

    .customer-body {
        padding: 16px 20px;
        flex: 1;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        font-size: 0.85rem;
        border-bottom: 1px dashed #f1f5f9;
        padding-bottom: 8px;
    }

        .info-row:last-child {
            margin-bottom: 0;
            border-bottom: none;
            padding-bottom: 0;
        }

    .info-label {
        font-weight: 600;
        color: var(--text-muted);
    }

    .info-value {
        font-weight: 700;
        color: var(--text-dark);
    }

    .customer-footer {
        padding: 16px 20px;
        background: #fafdff;
        border-top: 1px solid var(--card-border);
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

        .customer-footer .btn {
            flex: 1 1 calc(50% - 4px);
            min-width: 0;
            font-size: 0.8rem;
            padding: 8px 6px;
            border-radius: var(--radius-sm);
            font-weight: 600;
        }

        .customer-footer .btn-addresses {
            flex: 1 1 100%;
            background: var(--primary-light);
            border-color: rgba(255, 122, 0, 0.25);
            color: var(--primary);
        }

            .customer-footer .btn-addresses:hover {
                background: var(--primary);
                border-color: var(--primary);
                color: #fff;
            }

    /* پنل مدیریت آدرس */
    .addr-offcanvas {
        width: min(520px, 100vw) !important;
        height: 100% !important;
        max-height: 100vh !important;
        display: flex;
        flex-direction: column;
    }

    .addr-offcanvas .offcanvas-header {
        background: linear-gradient(135deg, #fff7ed 0%, #ffffff 70%);
        border-bottom: 1px solid var(--card-border);
        padding: 1.25rem 1.5rem;
        align-items: flex-start;
        gap: 0.75rem;
        flex-shrink: 0;
    }

    .addr-offcanvas-heading {
        flex: 1;
        min-width: 0;
    }

    .addr-offcanvas .offcanvas-header .btn-close {
        flex-shrink: 0;
        margin-top: 0.15rem;
        z-index: 2;
    }

    .addr-offcanvas-body {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        min-height: 0;
        height: 100%;
        overflow: hidden;
        padding: 1rem 1.25rem 1.25rem !important;
    }

    .addr-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
        flex-shrink: 0;
    }

    .addr-list-scroll {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        padding-left: 2px;
        margin: 0 -2px 0 0;
    }

    .addr-customer-chip {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 8px;
    }

    .addr-customer-chip .chip-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--primary-light);
        color: var(--primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .addr-customer-chip .chip-name {
        font-weight: 800;
        font-size: 0.95rem;
        color: var(--text-dark);
        line-height: 1.2;
    }

    .addr-customer-chip .chip-mobile {
        font-size: 0.8rem;
        color: var(--text-muted);
        direction: ltr;
        display: inline-block;
    }

    .addr-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 0;
        max-height: none;
        overflow: visible;
        padding-left: 0;
        padding-bottom: 8px;
    }

    .addr-card {
        border: 1px solid var(--card-border);
        border-radius: var(--radius-sm);
        background: #fff;
        padding: 14px 16px;
        transition: var(--transition);
        position: relative;
    }

        .addr-card:hover {
            border-color: rgba(255, 122, 0, 0.35);
            box-shadow: var(--shadow-sm);
        }

        .addr-card.is-default {
            border-color: rgba(255, 122, 0, 0.4);
            background: linear-gradient(180deg, #fffaf5 0%, #ffffff 100%);
        }

    .addr-card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 8px;
    }

    .addr-title {
        font-weight: 800;
        font-size: 0.92rem;
        color: var(--text-dark);
        margin: 0;
    }

    .addr-default-badge {
        font-size: 0.7rem;
        font-weight: 700;
        background: var(--primary);
        color: #fff;
        border-radius: var(--radius-pill);
        padding: 3px 10px;
        white-space: nowrap;
    }

    .addr-text {
        font-size: 0.86rem;
        color: var(--text-muted);
        line-height: 1.6;
        margin-bottom: 8px;
    }

    .addr-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 10px;
    }

    .addr-meta-chip {
        font-size: 0.72rem;
        font-weight: 600;
        color: #475569;
        background: #f1f5f9;
        border-radius: var(--radius-pill);
        padding: 3px 10px;
    }

    .addr-actions {
        display: flex;
        gap: 8px;
    }

        .addr-actions .btn {
            font-size: 0.78rem;
            font-weight: 600;
            border-radius: var(--radius-sm);
            padding: 5px 12px;
        }

    .addr-empty {
        text-align: center;
        padding: 2.5rem 1rem;
        color: var(--text-muted);
        background: #f8fafc;
        border: 1px dashed #e2e8f0;
        border-radius: var(--radius-sm);
        margin: 0;
        min-height: 220px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        .addr-empty i {
            font-size: 1.8rem;
            color: var(--primary);
            opacity: 0.7;
            margin-bottom: 8px;
            display: block;
        }

    .addr-form-panel {
        border: 0;
        border-radius: 0;
        background: transparent;
        padding: 0;
        box-shadow: none;
    }

    .addr-form-panel .form-label {
        font-weight: 700;
        font-size: 0.82rem;
        color: var(--text-dark);
        margin-bottom: 6px;
    }

    .addr-form-panel .form-control,
    .addr-form-panel .form-select {
        border-radius: var(--radius-sm);
        border-color: #e2e8f0;
        font-size: 0.9rem;
    }

        .addr-form-panel .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 0.2rem rgba(255, 122, 0, 0.15);
        }

    #addressFormModal {
        z-index: 1065;
    }

    .modal-backdrop.address-form-backdrop {
        z-index: 1060;
    }

    #addressFormModal .modal-content {
        border: 0;
        border-radius: var(--radius-md);
        overflow: hidden;
    }

    #addressFormModal .modal-header {
        background: linear-gradient(135deg, #fff7ed 0%, #ffffff 80%);
        border-bottom: 1px solid var(--card-border);
    }

    #addressFormModal .modal-body {
        max-height: min(70vh, 640px);
        overflow-y: auto;
    }

    .addr-form-title {
        font-weight: 800;
        font-size: 0.95rem;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .addr-form-title i {
            color: var(--primary);
        }

    .addr-coords-hint {
        font-size: 0.75rem;
        color: var(--text-muted);
        margin-top: 4px;
    }

    .stats-hint {
        background: var(--primary-light);
        border: 1px solid rgba(255, 122, 0, 0.15);
        border-radius: var(--radius-sm);
        padding: 12px 16px;
        font-size: 0.85rem;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
    }

        .stats-hint i {
            color: var(--primary);
            flex-shrink: 0;
        }

    .no-closed-orders-hint {
        font-size: 0.78rem;
        color: var(--text-muted);
        background: #f8fafc;
        border-radius: var(--radius-sm);
        padding: 8px 10px;
        margin-top: 4px;
        text-align: center;
        border: 1px dashed #e2e8f0;
    }
</style>

<div class="container customers-page py-4">
    <!-- هدر صفحه -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0 fw-black">   </h4>
        <button class="btn btn-primary" id="btnAddCustomer">
            <i class="fas fa-plus me-1"></i> مشتری جدید
        </button>
    </div>

    <!-- ========== بخش اینفوگرافیک پرمیوم ========== -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-5 g-4 mb-4" id="infographicsRow">
        <!-- کارت ۱: کل مشتریان فعال -->
        <div class="col">
            <div class="insights-card h-100 d-flex flex-column justify-content-between p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="text-muted small fw-semibold">کل مشتریان فعال</span>
                        <h1 class="mb-0 fw-black mt-2 text-dark" id="totalCustomers">0</h1>
                    </div>
                    <div class="icon-box-primary">
                        <i class="fas fa-users"></i>
                    </div>
                </div>
                <div>
                    <hr class="my-2" style="opacity: 0.08;">
                    <div class="d-flex justify-content-between small text-muted">
                        <span>امروز: <strong class="text-dark" id="newToday">0</strong></span>
                        <span>این هفته: <strong class="text-dark" id="newWeek">0</strong></span>
                        <span>این ماه: <strong class="text-dark" id="newMonth">0</strong></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- کارت ۲: مشتری ویژه ماه -->
        <div class="col">
            <div class="insights-card h-100 d-flex flex-column justify-content-between p-4">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="text-muted small fw-semibold">مشتری ویژه ماه</span>
                        <h6 class="mb-0 fw-bold mt-2 text-truncate" id="topCustomerName" style="max-width: 130px;">-</h6>
                        <span class="small fw-black text-primary mt-1 d-block" id="topCustomerAmount">0 تومان</span>
                    </div>
                    <div class="icon-box-warning">
                        <i class="fas fa-crown"></i>
                    </div>
                </div>
                <div>
                    <hr class="my-2" style="opacity: 0.08;">
                    <div class="small text-muted d-flex justify-content-between">
                        <span>تعداد سفارش:</span>
                        <strong class="text-dark" id="topCustomerOrders">0</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- کارت ۳: رشد مشتریان ۷ روزه -->
        <div class="col">
            <div class="insights-card h-100">
                <div class="insights-card-header">
                    <i class="fas fa-chart-line text-success"></i> رشد جدید (۷ روز اخیر)
                </div>
                <div class="scrollable-list" id="growthCustomersList">
                    <div class="text-center py-5 text-muted small"><i class="fas fa-spinner fa-spin"></i> بارگذاری...</div>
                </div>
            </div>
        </div>

        <!-- کارت ۴: نرخ بازگشت مشتری -->
        <div class="col">
            <div class="insights-card h-100">
                <div class="insights-card-header">
                    <i class="fas fa-history text-info"></i> نرخ بازگشت مشتری
                </div>
                <div class="scrollable-list" id="returnRatesList" style="padding: 12px 16px;">
                    <div class="text-center py-5 text-muted small"><i class="fas fa-spinner fa-spin"></i> بارگذاری...</div>
                </div>
            </div>
        </div>

        <!-- کارت ۵: بهترین مشتریان -->
        <div class="col">
            <div class="insights-card h-100">
                <div class="insights-card-header">
                    <i class="fas fa-award text-warning"></i> بهترین مشتریان 
                </div>
                <div class="scrollable-list" id="bestCustomersList">
                    <div class="text-center py-5 text-muted small"><i class="fas fa-spinner fa-spin"></i> بارگذاری...</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== نمودار روند جدید پرمیوم ========== -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="premium-chart-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h6 class="mb-1 fw-bold text-dark"><i class="far fa-chart-bar text-primary me-1"></i> روند هفتگی فروش و جذب جذب مشتری</h6>
                        <span class="text-muted small">فروش رستوران و مشتریان جدید در ۷ روز اخیر</span>
                    </div>
                    <div class="d-flex gap-3">
                        <span class="chart-minimal-card chart-legend-indicator">
                            <span class="legend-dot" style="background: #ff7a00;"></span> مشتریان جدید
                        </span>
                        <span class="chart-minimal-card chart-legend-indicator">
                            <span class="legend-dot" style="background: #10b981;"></span> مجموع فروش (هزار تومان)
                        </span>
                    </div>
                </div>
                <div style="position: relative; width: 100%;">
                    <canvas id="trendChart" height="90" style="max-height: 220px; width: 100%;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- نوار ابزار جستجو و فیلتر -->
    <div class="customers-toolbar">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-bold text-dark small">جستجو عمومی</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" id="searchInput" class="form-control border-start-0" placeholder="نام، شماره موبایل، توضیحات..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold text-dark small">&nbsp;</label>
                <button id="btnSearch" class="btn btn-primary w-100">
                    اعمال فیلتر جستجو
                </button>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold text-dark small">&nbsp;</label>
                <button id="btnResetSearch" class="btn btn-outline-secondary w-100" style="padding: 10px 0; border-radius: var(--radius-sm);">
                    <i class="fas fa-undo-alt me-1"></i> بازنشانی کامل
                </button>
            </div>
        </div>
        <hr class="my-4" style="opacity: 0.1;">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-bold text-dark small">بازه زمانی ثبت سفارش</label>
                <select id="periodSelect" class="form-select">
                    <option value="all">همه زمان‌ها</option>
                    <option value="today">امروز</option>
                    <option value="week">هفته گذشته</option>
                    <option value="month">ماه جاری</option>
                    <option value="year">سال گذشته</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold text-dark small">مرتب‌سازی بر اساس</label>
                <select id="sortBySelect" class="form-select">
                    <option value="TotalSpent">بیشترین مبلغ خرید</option>
                    <option value="TotalOrders">بیشترین تعداد سفارش</option>
                    <option value="TotalDistinctDays">بیشترین روزهای حضور</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold text-dark small">&nbsp;</label>
                <button id="btnApplyFilter" class="btn btn-dark w-100" style="padding: 10px 0; border-radius: var(--radius-sm); font-weight: 700;">
                    <i class="fas fa-sliders-h me-1"></i> اعمال فیلتر و رتبه‌بندی
                </button>
            </div>
        </div>
    </div>

    <div class="stats-hint">
        <i class="fas fa-info-circle"></i>
        <span>آمار خرید فقط بر اساس سفارش‌های بسته‌شده محاسبه می‌شود.</span>
    </div>

    <!-- بارگذاری و نشانگر لودینگ -->
    <div id="loadingSpinner" class="text-center py-5 d-none">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">در حال بارگذاری...</span>
        </div>
    </div>

    <!-- لیست مشتریان -->
    <div id="customersList"></div>
    <div id="totalRecordsInfo" class="text-muted text-center mt-3 mb-2" style="display: none; font-weight: 600;"></div>

    <!-- صفحه‌بندی -->
    <div id="paginationContainer" class="d-flex justify-content-center mt-5"></div>
</div>

<!-- مودال افزودن/ویرایش مشتری -->
<div class="modal fade" id="customerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">افزودن مشتری جدید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body p-4">
                <form id="customerForm">
                    <input type="hidden" id="customerId" value="0" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">نام کامل</label>
                        <input type="text" id="fullName" class="form-control" placeholder="مثال: علیرضا شایان" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">شماره موبایل</label>
                        <input type="tel" id="mobile" class="form-control" placeholder="۰۹۱۲۳۴۵۶۷۸۹" required dir="ltr" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">توضیحات (اختیاری)</label>
                        <textarea id="description" class="form-control" placeholder="یادداشت در خصوص ترجیحات مشتری..." rows="3"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer" style="background: #f8fafc;">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal" style="border-radius: var(--radius-sm);">انصراف</button>
                <button type="button" id="btnSaveCustomer" class="btn btn-primary px-4">ذخیره اطلاعات</button>
            </div>
        </div>
    </div>
</div>

<!-- مودال تأیید حذف -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="fas fa-exclamation-triangle me-1"></i> حذف مشتری</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 text-center">
