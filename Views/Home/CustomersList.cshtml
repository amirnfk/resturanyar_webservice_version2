    function cleanupAddressesOffcanvasArtifacts() {
        document.querySelectorAll('.offcanvas-backdrop').forEach(function (backdrop) {
            // Keep backdrops that still belong to another open offcanvas
            var openPanels = document.querySelectorAll('.offcanvas.show');
            if (!openPanels.length) backdrop.remove();
        });
        if (!document.querySelector('.offcanvas.show') && !document.querySelector('.modal.show')) {
            document.body.classList.remove('offcanvas-open', 'modal-open');
            document.body.style.removeProperty('overflow');
            document.body.style.removeProperty('padding-right');
        }
    }

    function getAddressesOffcanvasEl() {
        var nodes = Array.from(document.querySelectorAll('#addressesOffcanvas'));
        if (!nodes.length) return null;

        // Soft-nav can leave an old body-mounted panel + a new one in page HTML
        var preferred = document.querySelector('.customers-page #addressesOffcanvas')
            || nodes[nodes.length - 1];

        nodes.forEach(function (el) {
            if (el === preferred) return;
            try {
                if (window.bootstrap && bootstrap.Offcanvas) {
                    var oldInst = bootstrap.Offcanvas.getInstance(el);
                    if (oldInst) oldInst.dispose();
                }
            } catch (_) { /* ignore */ }
            el.remove();
        });

        if (preferred.parentElement !== document.body) {
            document.body.appendChild(preferred);
        }
        return preferred;
    }

    function ensureAddressModalsOnBody() {
        ['addressFormModal', 'deleteAddressModal'].forEach(function (id) {
            var nodes = Array.from(document.querySelectorAll('#' + id));
            if (!nodes.length) return;
            var preferred = document.querySelector('.customers-page #' + id) || nodes[nodes.length - 1];
            nodes.forEach(function (el) {
                if (el === preferred) return;
                try {
                    if (window.bootstrap && bootstrap.Modal) {
                        var oldInst = bootstrap.Modal.getInstance(el);
                        if (oldInst) oldInst.dispose();
                    }
                } catch (_) { /* ignore */ }
                el.remove();
            });
            if (preferred.parentElement !== document.body) {
                document.body.appendChild(preferred);
            }
        });
    }

    function getAddressesOffcanvas() {
        var el = getAddressesOffcanvasEl();
        if (!el || !window.bootstrap || !bootstrap.Offcanvas) return null;
        addressesOffcanvas = bootstrap.Offcanvas.getOrCreateInstance(el, {
            backdrop: true,
            keyboard: true,
            scroll: false
        });
        return addressesOffcanvas;
