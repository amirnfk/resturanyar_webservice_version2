@{
    ViewData["Title"] = "پیام‌ها";
}

@section Styles {
    <link rel="stylesheet" href="~/css/messages.css" asp-append-version="true" />
}

<div class="container messages-page py-4" data-restaurant-id="@(ViewBag.RestaurantId ?? 0)">
    <div class="messages-header">
        <div class="messages-header__text">
            <h4 class="messages-title mb-1">پیام‌ها</h4>
            <p class="messages-subtitle mb-0">پیام‌های ارسالی از طرف پشتیبانی رستورانیار</p>
        </div>
        <div class="messages-header__actions">
            <span id="messagesUnreadStat" class="messages-stat-pill d-none">
                <i class="fas fa-circle-dot"></i>
                <span id="messagesUnreadCount">0</span> پیام خوانده‌نشده
            </span>
            <button type="button" id="btnMarkAllRead" class="btn btn-outline-primary btn-sm d-none">
                <i class="fas fa-check-double me-1"></i>
                علامت‌گذاری همه به عنوان خوانده‌شده
            </button>
        </div>
    </div>

    <div class="messages-toolbar">
        <div class="messages-filter-tabs" role="tablist">
            <button type="button" class="messages-filter-tab active" data-filter="all">
                همه
            </button>
            <button type="button" class="messages-filter-tab" data-filter="unread">
                خوانده‌نشده
                <span id="messagesFilterBadge" class="messages-filter-badge d-none">0</span>
            </button>
        </div>
    </div>

    <div id="messagesLoading" class="messages-loading">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">در حال بارگذاری...</span>
        </div>
        <p class="mt-3 text-muted mb-0">در حال بارگذاری پیام‌ها...</p>
    </div>

    <div id="messagesList" class="messages-list d-none"></div>

    <div id="messagesEmpty" class="messages-empty d-none">
        <div class="messages-empty__icon">
            <i class="fas fa-envelope-open-text"></i>
        </div>
        <h5 id="messagesEmptyTitle" class="messages-empty__title">پیامی وجود ندارد</h5>
        <p id="messagesEmptyDesc" class="messages-empty__desc">وقتی پیام جدیدی دریافت کنید، اینجا نمایش داده می‌شود.</p>
    </div>
</div>

<!-- Message detail modal -->
<div id="messageDetailModal" class="custom-modal-overlay">
    <div class="custom-modal-card messages-detail-modal">
        <button type="button" id="messageDetailClose" class="messages-detail-modal__close" aria-label="بستن">&times;</button>
        <div class="messages-detail-modal__meta">
            <span id="messageDetailType" class="message-type-chip"></span>
            <span id="messageDetailDate" class="message-detail-date"></span>
        </div>
        <h3 id="messageDetailTitle" class="messages-detail-modal__title"></h3>
        <div id="messageDetailBody" class="messages-detail-modal__body"></div>
        <div class="messages-detail-modal__actions">
            <button type="button" id="messageDetailMarkRead" class="btn btn-primary d-none">
                <i class="fas fa-check me-1"></i>
                علامت به عنوان خوانده‌شده
            </button>
            <button type="button" id="messageDetailCloseBtn" class="btn btn-light">بستن</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/messages.js" asp-append-version="true"></script>
}
