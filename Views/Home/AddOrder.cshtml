    async function saveOrderCustomerAddress() {
        if (!selectedCustomerId) {
            showToast('ابتدا مشتری را انتخاب کنید.', 'error');
            return;
        }
        var addressText = ($('#orderAddrText').val() || '').trim();
        if (!addressText) {
            showToast('متن آدرس الزامی است.', 'error');
            return;
        }

        var payload = {
            customerId: parseInt(selectedCustomerId, 10),
            title: ($('#orderAddrTitle').val() || '').trim() || 'آدرس',
            addressText: addressText,
            unit: ($('#orderAddrUnit').val() || '').trim().substring(0, 10) || '',
            floor: ($('#orderAddrFloor').val() || '').trim().substring(0, 10) || '',
            plateNumber: ($('#orderAddrPlate').val() || '').trim().substring(0, 10) || '',
            isDefault: $('#orderAddrIsDefault').prop('checked') === true,
            description: ($('#orderAddrDescription').val() || '').trim() || ''
        };
        var lat = parseOptionalNumber($('#orderAddrLat').val());
        var lng = parseOptionalNumber($('#orderAddrLng').val());
        if (lat != null) payload.latitude = lat;
        if (lng != null) payload.longitude = lng;

        var $btn = $('#btnSaveOrderAddress').prop('disabled', true);
        try {
            const response = await window.fetchWithAuth(`${API_BASE}/addaddress`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            var res = {};
            try { res = await response.json(); } catch (_) { res = {}; }
            if (response.ok && res.success) {
                showToast(res.message || 'آدرس ذخیره شد', 'success');
                selectedAddressId = res.addressId ? String(res.addressId) : selectedAddressId;
                selectedAddressText = null;
                if (orderAddressModalInstance) orderAddressModalInstance.hide();
                await loadCustomerAddresses(selectedCustomerId);
            } else {
                showToast(res.message || res.detail || ('ذخیره آدرس ناموفق بود' + (response.status ? ` (${response.status})` : '')), 'error');
            }
        } catch (e) {
            showToast('خطا در ذخیره آدرس', 'error');
        } finally {
            $btn.prop('disabled', false);
        }
    }

