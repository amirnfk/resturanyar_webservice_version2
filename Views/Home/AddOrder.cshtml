@model List<FoodItemViewModel>
@{
    ViewData["Title"] = "ثبت سفارش جدید";
    var placeholder = Url.Content("~/images/food_placeholder.jpg");
}

@section Styles {
    <link rel="stylesheet" href="~/css/add-order.css" asp-append-version="true" />
}

<div class="container-fluid food-page order-page order-page--v2 px-3 px-xl-4 py-3">
    <div class="row order-layout-row g-3 g-xl-4">

        <!-- Food List Column -->
        <div class="col-lg-8 order-food-col">
            <div class="food-toolbar">
                <div class="food-toolbar__search">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                    <input id="searchBox" type="text" class="form-control" placeholder="جستجوی غذا..." autocomplete="off" />
                </div>
                <div class="food-toolbar__filters">
                    <select id="filterCategory" class="form-select">
                        <option value="">همه دسته‌ها</option>
                    </select>
                    <select id="filterAvailability" class="form-select">
                        <option value="">همه</option>
                        <option value="true">موجود</option>
                        <option value="false">ناموجود</option>
                    </select>
                    <select id="sortBy" class="form-select">
                        <option value="newest">جدیدترین</option>
                        <option value="name-asc">نام (الف تا ی)</option>
                        <option value="name-desc">نام (ی تا الف)</option>
                        <option value="price-asc">قیمت ↑</option>
                        <option value="price-desc">قیمت ↓</option>
                        <option value="discount-desc">تخفیف</option>
                    </select>
                </div>
            </div>

            @if (!Model.Any())
            {
                <div class="order-empty-state">
                    <i class="fa-solid fa-utensils" aria-hidden="true"></i>
                    <p>غذایی برای نمایش وجود ندارد.</p>
                </div>
            }
            else
            {
                <div class="row g-2 g-md-3" id="foodList">
                    @foreach (var item in Model)
                    {
                        var hasDiscount = item.DiscountPrice > 0 && item.DiscountPrice != item.Price;
                        var discountPercent = hasDiscount ? (int)Math.Round(((item.Price - item.DiscountPrice) / item.Price) * 100) : 0;
                        var unavailableClass = item.IsAvailable ? "" : "is-unavailable";
                        var sellPrice = item.DiscountPrice > 0 ? item.DiscountPrice : item.Price;
                        <div class="col-6 col-md-4 col-xl-3 food-card-item"
                             data-id="@item.FoodItemId"
                             data-name="@item.Name"
                             data-description="@item.Description"
                             data-category="@item.CategoryId"
                             data-categoryname="@item.CategoryName"
                             data-price="@item.Price"
                             data-discountprice="@item.DiscountPrice"
                             data-isavailable="@item.IsAvailable"
                             data-image="@(item.ImageUrl ?? "")">
                            <div class="food-card @unavailableClass"
                                 role="button"
                                 tabindex="@(item.IsAvailable ? "0" : "-1")"
                                 data-id="@item.FoodItemId"
                                 data-name="@item.Name"
                                 data-price="@sellPrice">
                                <div class="food-img-wrap">
                                    <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? placeholder : item.ImageUrl)"
                                         class="food-img" loading="lazy" alt=""
                                         onerror="this.onerror=null;this.src='@placeholder';" />
                                    @if (hasDiscount)
                                    {
                                        <span class="ribbon">@discountPercent٪</span>
                                    }
                                    @if (!item.IsAvailable)
                                    {
                                        <div class="unavailable-overlay">
                                            <span>ناموجود</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button" class="food-quick-add add-to-cart-btn"
                                                data-id="@item.FoodItemId"
                                                data-name="@item.Name"
                                                data-price="@sellPrice"
                                                aria-label="افزودن @item.Name">
                                            <i class="fa-solid fa-plus" aria-hidden="true"></i>
                                        </button>
                                    }
                                </div>
                                <div class="food-body">
                                    <span class="food-cat">@item.CategoryName</span>
                                    <h5 class="food-title">@item.Name</h5>
                                    <div class="food-meta">
                                        <div class="price-area">
                                            @if (hasDiscount)
                                            {
                                                <span class="price-old">@item.Price.ToString("N0")</span>
                                                <span class="price-new">@sellPrice.ToString("N0") <small>تومان</small></span>
                                            }
                                            else
                                            {
                                                <span class="price-new">@sellPrice.ToString("N0") <small>تومان</small></span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Desktop cart sidebar -->
        <div class="col-lg-4 order-cart-col d-none d-lg-block">
            <aside class="cart-sidebar">
                <div class="cart-sidebar__head">
                    <div>
                        <h4 class="cart-title">سفارش جاری</h4>
                        <p class="cart-subtitle">آیتم‌ها را انتخاب کنید و ثبت کنید</p>
                    </div>
                    <span class="cart-count-pill" id="desktopCartCount">۰</span>
                </div>

                <div id="cart-items-container" class="cart-items-panel">
                    <div class="empty-cart">
                        <i class="fa-solid fa-basket-shopping" aria-hidden="true"></i>
                        <span>سبد خالی است</span>
                        <small>از لیست غذاها اضافه کنید</small>
                    </div>
                </div>

                <div class="cart-checkout">
                    <div class="cart-checkout__title">جزئیات سفارش</div>

                    <div class="mb-3" id="orderTypeSection">
                        <label class="form-label">نوع سفارش</label>
                        <div class="order-type-chips" id="orderTypeChips" role="radiogroup" aria-label="نوع سفارش">
                            <button type="button" class="order-type-chip is-active" data-order-type="0" aria-pressed="true">
                                <span class="order-type-chip__icon"><i class="fa-solid fa-utensils" aria-hidden="true"></i></span>
                                <span class="order-type-chip__title">سالن</span>
                            </button>
                            <button type="button" class="order-type-chip d-none" data-order-type="1" data-requires="takeaway" aria-pressed="false">
                                <span class="order-type-chip__icon"><i class="fa-solid fa-bag-shopping" aria-hidden="true"></i></span>
                                <span class="order-type-chip__title">بیرون‌بر</span>
                            </button>
                            <button type="button" class="order-type-chip d-none" data-order-type="2" data-requires="delivery" aria-pressed="false">
                                <span class="order-type-chip__icon"><i class="fa-solid fa-motorcycle" aria-hidden="true"></i></span>
                                <span class="order-type-chip__title">ارسال</span>
                            </button>
                        </div>
                        <select id="orderTypeSelect" class="visually-hidden" tabindex="-1" aria-hidden="true">
                            <option value="0" selected>سالن</option>
                        </select>
                    </div>

                    <div class="mb-3" id="tableSelectSection">
                        <label class="form-label">میز <span class="text-danger" id="tableRequiredMark">*</span></label>
                        <select id="tableSelect" class="form-select" required>
                            <option value="">انتخاب میز</option>
                        </select>
                        <small class="text-muted" id="tableSeatsInfo"></small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">مشتری <span class="text-danger d-none" id="customerRequiredMark">*</span></label>
                        <div class="customer-search-wrapper">
                            <div class="input-group">
                                <input type="text" id="desktopCustomerSearch" class="form-control"
                                       placeholder="موبایل یا نام..." autocomplete="off">
                                <button class="btn btn-new-customer" type="button"
                                        data-bs-toggle="modal" data-bs-target="#newCustomerModal"
                                        data-context="desktop" title="مشتری جدید">
                                    <i class="bi bi-person-plus"></i>
                                </button>
                            </div>
                            <div class="search-spinner" id="desktopSearchSpinner"></div>
                            <div id="desktopCustomerSearchResults" class="customer-search-results"></div>
                        </div>
                        <input type="hidden" id="desktopSelectedCustomerId">
                        <div id="desktopSelectedCustomerInfo" class="mt-2"></div>
                    </div>

                    <div class="mb-3 d-none" id="addressSection">
                        <label class="form-label">آدرس ارسال <span class="text-danger">*</span></label>
                        <div id="selectedAddressInfo" class="d-none"></div>
                        <div id="addressPickerPanel">
                            <select id="addressSelect" class="form-select mb-2">
                                <option value="">انتخاب آدرس ذخیره‌شده</option>
                            </select>
                            <button type="button" class="btn btn-sm btn-primary w-100 mb-2" id="btnOpenAddressForm">
                                <i class="fa-solid fa-plus ms-1"></i> ثبت آدرس جدید برای مشتری
                            </button>
                            <div class="address-or-divider"><span>یا فقط برای این سفارش</span></div>
                            <textarea id="addressText" class="form-control mb-2" rows="2" placeholder="خیابان، کوچه، پلاک..."></textarea>
                            <button type="button" class="btn btn-sm btn-outline-primary w-100" id="btnUseCustomAddress">
                                <i class="fa-solid fa-check ms-1"></i> انتخاب این آدرس
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">توضیحات</label>
                        <textarea id="orderDescription" class="form-control" rows="2" placeholder="اختیاری..."></textarea>
                    </div>
                </div>

                <div class="cart-sidebar__footer">
                    <button id="submitOrderBtn" class="btn btn-primary w-100 btn-submit-order">
                        <i class="fa-solid fa-circle-check ms-1"></i> ثبت سفارش
                    </button>
                    <div id="orderEstimateBox" class="order-estimate-card" style="display:none;" aria-live="polite">
                        <div class="order-estimate-card__icon" aria-hidden="true">
                            <i class="fa-solid fa-receipt"></i>
                        </div>
                        <div class="order-estimate-card__content">
                            <span class="order-estimate-card__label">برآورد مبلغ نهایی</span>
                            <strong id="orderEstimateAmount" class="order-estimate-card__amount"></strong>
                            <span id="orderEstimateMeta" class="order-estimate-card__meta"></span>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</div>

<!-- Mobile FAB -->
<button class="cart-fab d-lg-none" type="button"
        data-bs-toggle="offcanvas" data-bs-target="#cartOffcanvas">
    <i class="bi bi-bag"></i>
    <span>سبد سفارش</span>
    <span class="badge" id="mobileCartCount">0</span>
    <span id="mobileCartTotal">0</span> تومان
</button>

<!-- Mobile offcanvas -->
<div class="offcanvas offcanvas-end cart-offcanvas" tabindex="-1" id="cartOffcanvas">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title"><i class="fa-solid fa-cart-shopping ms-1"></i> سفارش جاری</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column">
        <div id="offcanvas-cart-items-container">
            <div class="empty-cart">
                <i class="fa-solid fa-basket-shopping" aria-hidden="true"></i>
                <span>سبد خالی است</span>
                <small>از لیست غذاها اضافه کنید</small>
            </div>
        </div>
        <div class="mt-3 mb-3" id="offcanvasOrderTypeSection">
            <label class="form-label fw-semibold">نوع سفارش</label>
            <div class="order-type-chips" id="offcanvasOrderTypeChips" role="radiogroup" aria-label="نوع سفارش">
                <button type="button" class="order-type-chip is-active" data-order-type="0" aria-pressed="true">
                    <span class="order-type-chip__icon"><i class="fa-solid fa-utensils" aria-hidden="true"></i></span>
                    <span class="order-type-chip__title">سالن</span>
                    <span class="order-type-chip__hint">صرف در رستوران</span>
                </button>
                <button type="button" class="order-type-chip d-none" data-order-type="1" data-requires="takeaway" aria-pressed="false">
                    <span class="order-type-chip__icon"><i class="fa-solid fa-bag-shopping" aria-hidden="true"></i></span>
                    <span class="order-type-chip__title">بیرون‌بر</span>
                    <span class="order-type-chip__hint">تحویل حضوری</span>
                </button>
                <button type="button" class="order-type-chip d-none" data-order-type="2" data-requires="delivery" aria-pressed="false">
                    <span class="order-type-chip__icon"><i class="fa-solid fa-motorcycle" aria-hidden="true"></i></span>
                    <span class="order-type-chip__title">ارسال</span>
                    <span class="order-type-chip__hint">پیک / ارسال</span>
                </button>
            </div>
            <select id="offcanvasOrderTypeSelect" class="visually-hidden" tabindex="-1" aria-hidden="true">
                <option value="0" selected>سالن</option>
            </select>
        </div>
        <div class="mt-3 mb-3" id="offcanvasTableSelectSection">
            <label class="form-label">انتخاب میز <span class="text-danger" id="offcanvasTableRequiredMark">*</span></label>
            <select id="offcanvasTableSelect" class="form-select" required>
                <option value="">-- انتخاب میز --</option>
            </select>
            <small class="text-muted" id="offcanvasTableSeatsInfo"></small>
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">مشتری (اختیاری) <span class="text-danger d-none" id="offcanvasCustomerRequiredMark">*</span></label>
            <div class="customer-search-wrapper">
                <div class="input-group">
                    <input type="text" id="offcanvasCustomerSearch" class="form-control"
                           placeholder="شماره موبایل یا نام ..." autocomplete="off">
                    <button class="btn btn-new-customer" type="button"
                            data-bs-toggle="modal" data-bs-target="#newCustomerModal"
                            data-context="offcanvas">
                        <i class="bi bi-person-plus"></i> مشتری جدید
                    </button>
                </div>
                <div class="search-spinner" id="offcanvasSearchSpinner"></div>
                <div id="offcanvasCustomerSearchResults" class="customer-search-results"></div>
            </div>
            <input type="hidden" id="offcanvasSelectedCustomerId">
            <div id="offcanvasSelectedCustomerInfo" class="mt-2"></div>
        </div>
        <div class="mb-3 d-none" id="offcanvasAddressSection">
            <label class="form-label fw-semibold">آدرس ارسال <span class="text-danger">*</span></label>

            <div id="offcanvasSelectedAddressInfo" class="d-none"></div>

            <div id="offcanvasAddressPickerPanel">
                <select id="offcanvasAddressSelect" class="form-select mb-2">
                    <option value="">انتخاب آدرس ذخیره‌شده</option>
                </select>
                <button type="button" class="btn btn-sm btn-primary w-100 mb-2" id="offcanvasBtnOpenAddressForm">
                    <i class="fa-solid fa-plus ms-1"></i> ثبت آدرس جدید برای مشتری
                </button>
                <div class="address-or-divider"><span>یا فقط برای این سفارش</span></div>
                <textarea id="offcanvasAddressText" class="form-control mb-2" rows="2" placeholder="خیابان، کوچه، پلاک..."></textarea>
                <button type="button" class="btn btn-sm btn-outline-primary w-100" id="offcanvasBtnUseCustomAddress">
                    <i class="fa-solid fa-check ms-1"></i> انتخاب این آدرس
                </button>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">توضیحات (اختیاری)</label>
            <textarea id="offcanvasOrderDescription" class="form-control" rows="2" placeholder="درخواست ویژه..."></textarea>
        </div>
        <button id="offcanvasSubmitOrderBtn" class="btn btn-primary w-100 py-2 mt-auto"><i class="fa-solid fa-circle-check ms-1"></i> نهایی کردن سفارش</button>
    </div>
</div>

<!-- New customer modal -->
<div class="modal fade" id="newCustomerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">ثبت مشتری جدید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">شماره موبایل <span class="text-danger">*</span></label>
                    <input type="tel" id="newCustomerMobile" class="form-control" dir="ltr">
                </div>
                <div class="mb-3">
                    <label class="form-label">نام کامل</label>
                    <input type="text" id="newCustomerFullName" class="form-control">
                </div>
                <div class="mb-3">
                    <label class="form-label">توضیحات (اختیاری)</label>
                    <textarea id="newCustomerDesc" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" id="saveNewCustomerBtn">ذخیره و انتخاب</button>
            </div>
        </div>
    </div>
</div>

<!-- ثبت آدرس مشتری (همان جزئیات CustomersList) -->
<div class="modal fade" id="orderAddressModal" tabindex="-1" aria-labelledby="orderAddressModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content order-addr-modal">
            <div class="modal-header order-addr-modal__header">
                <div class="flex-grow-1 pe-2">
                    <h5 class="modal-title fw-bold mb-1" id="orderAddressModalLabel">
                        <i class="fas fa-map-location-dot text-primary me-1"></i> ثبت آدرس جدید
                    </h5>
                    <div class="order-addr-customer-chip">
                        <div class="chip-avatar"><i class="fas fa-user"></i></div>
                        <div>
                            <div class="chip-name" id="orderAddrCustomerName">—</div>
                            <div class="chip-mobile" id="orderAddrCustomerMobile">—</div>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <div class="addr-form-panel order-addr-form-panel">
                    <div class="addr-form-title">
                        <i class="fas fa-pen-to-square"></i>
                        <span>جزئیات آدرس</span>
                    </div>
                    <form id="orderAddressForm" autocomplete="off">
                        <div class="mb-3">
                            <label class="form-label" for="orderAddrTitle">عنوان آدرس</label>
                            <input type="text" id="orderAddrTitle" class="form-control" placeholder="مثلاً خانه، محل کار، شعبه شمال" maxlength="100" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="orderAddrText">متن آدرس <span class="text-danger">*</span></label>
                            <textarea id="orderAddrText" class="form-control" rows="3" placeholder="خیابان، کوچه، پلاک و جزئیات کامل..." required></textarea>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-4">
                                <label class="form-label" for="orderAddrPlate">پلاک</label>
                                <input type="text" id="orderAddrPlate" class="form-control" placeholder="—" maxlength="10" />
                            </div>
                            <div class="col-4">
                                <label class="form-label" for="orderAddrFloor">طبقه</label>
                                <input type="text" id="orderAddrFloor" class="form-control" placeholder="—" maxlength="10" />
                            </div>
                            <div class="col-4">
                                <label class="form-label" for="orderAddrUnit">واحد</label>
                                <input type="text" id="orderAddrUnit" class="form-control" placeholder="—" maxlength="10" />
                            </div>
                        </div>

                        <div class="row g-2 mb-2 d-none" aria-hidden="true">
                            <div class="col-6">
                                <label class="form-label" for="orderAddrLat">عرض جغرافیایی</label>
                                <input type="number" step="any" id="orderAddrLat" class="form-control" placeholder="اختیاری" dir="ltr" />
                            </div>
                            <div class="col-6">
                                <label class="form-label" for="orderAddrLng">طول جغرافیایی</label>
                                <input type="number" step="any" id="orderAddrLng" class="form-control" placeholder="اختیاری" dir="ltr" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="orderAddrDescription">یادداشت (اختیاری)</label>
                            <input type="text" id="orderAddrDescription" class="form-control" placeholder="مثلاً زنگ طبقه ۲ را بزنید" maxlength="200" />
                        </div>

                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" id="orderAddrIsDefault" />
                            <label class="form-check-label fw-semibold" for="orderAddrIsDefault">آدرس پیش‌فرض مشتری</label>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer order-addr-modal__footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" id="btnSaveOrderAddress">
                    <i class="fas fa-check me-1"></i> ذخیره آدرس
                </button>
            </div>
        </div>
    </div>
</div>

<div class="toast-container" id="toastContainer"></div>

@section Scripts {
<script>
    // ══════════════════════════════════════════════════════════
    //  CONSTANTS & STATE (V2 endpoints)
    // ══════════════════════════════════════════════════════════
    var API_BASE      = "/api/v2/UserApi";
    var   restaurantId  = @(ViewBag.RestaurantId ?? 0);
    var receiptChargesEnabled = @(ViewBag.ReceiptChargesEnabled == true ? "true" : "false");
    var enableTakeaway = @(ViewBag.EnableTakeaway == true ? "true" : "false");
    var enableDelivery = @(ViewBag.EnableDelivery == true ? "true" : "false");
    var fulfillmentGlobalEnabled = @(ViewBag.FulfillmentOrdersGlobalEnabled == true ? "true" : "false");

    var cart               = [];
    var selectedCustomerId = null;
    var selectedCustomerMobile = null;
    var selectedCustomerName = null;
    var selectedAddressId  = null;
    var selectedAddressText = null;
    var addressesCache = [];
    var activeModalContext = 'desktop';
    var isSubmittingOrder  = false;
    var isSubmittingCustomer = false;
    var currentSearchXhr   = null;
    var orderAddressModalInstance = null;

    function getSelectedOrderType() {
        return parseInt($('#orderTypeSelect').val() || '0', 10) || 0;
    }

    function setOrderTypeChipActive(type) {
        type = String(type);
        $('.order-type-chip').each(function() {
            var isActive = String($(this).data('order-type')) === type;
            $(this).toggleClass('is-active', isActive).attr('aria-pressed', isActive ? 'true' : 'false');
        });
    }

    function syncOrderTypeControls(sourceId) {
        var val = $(sourceId).val();
        $('#orderTypeSelect, #offcanvasOrderTypeSelect').val(val);
        setOrderTypeChipActive(val);
        applyOrderTypeUi();
    }

    function applyOrderTypeUi() {
        var type = getSelectedOrderType();
        var isDineIn = type === 0;
        var isDelivery = type === 2;

        setOrderTypeChipActive(type);
        $('#tableSelectSection, #offcanvasTableSelectSection').toggle(isDineIn);
        $('#tableSelect, #offcanvasTableSelect').prop('required', isDineIn);
        $('#addressSection, #offcanvasAddressSection').toggleClass('d-none', !isDelivery);
        $('#customerRequiredMark, #offcanvasCustomerRequiredMark').toggleClass('d-none', !isDelivery);

        if (!isDineIn) {
