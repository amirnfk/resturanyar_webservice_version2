    function buildSelectedAddressCardHtml(title, text, isCustom, metaHtml) {
        var badge = isCustom
            ? '<span class="selected-address-badge">دستی</span>'
            : '<span class="selected-address-badge is-saved">ذخیره‌شده</span>';
        return `<div class="selected-address-card">
            <div class="selected-address-card__icon" aria-hidden="true"><i class="fa-solid fa-location-dot"></i></div>
            <div class="selected-address-card__body">
                <div class="selected-address-card__top">
                    <strong class="selected-address-card__title">${escapeHtml(title || 'آدرس')}</strong>
                    ${badge}
                </div>
                <div class="selected-address-card__text">${escapeHtml(text || '')}</div>
                ${metaHtml || ''}
                <div class="small text-muted mt-1"><i class="fa-solid fa-circle-check ms-1"></i> انتخاب شده</div>
            </div>
            <button type="button" class="btn-change-address">تغییر</button>
        </div>`;
    }

    function buildAddressMetaHtml(addr) {
        if (!addr) return '';
        var chips = [];
        var unit = addr.unit ?? addr.Unit;
        var floor = addr.floor ?? addr.Floor;
        var plate = addr.plateNumber ?? addr.PlateNumber;
        if (unit) chips.push(`<span class="addr-meta-chip">واحد ${escapeHtml(unit)}</span>`);
        if (floor) chips.push(`<span class="addr-meta-chip">طبقه ${escapeHtml(floor)}</span>`);
        if (plate) chips.push(`<span class="addr-meta-chip">پلاک ${escapeHtml(plate)}</span>`);
        if (addr.isDefault ?? addr.IsDefault) {
            chips.push('<span class="addr-meta-chip addr-meta-chip--default">پیش‌فرض</span>');
        }
        if (!chips.length) return '';
        return `<div class="addr-meta selected-address-card__meta">${chips.join('')}</div>`;
    }

    function parseOptionalNumber(val) {
        if (val == null || String(val).trim() === '') return null;
        var n = Number(val);
        return Number.isFinite(n) ? n : null;
    }

