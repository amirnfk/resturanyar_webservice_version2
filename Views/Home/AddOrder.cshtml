    async function loadCustomerAddresses(customerId) {
        if (!customerId) return;
        var keepId = selectedAddressId;
        var options = '<option value="">انتخاب آدرس ذخیره‌شده</option>';
        addressesCache = [];
        $('#addressSelect, #offcanvasAddressSelect').html(options);
        clearSelectedAddress(true);
        try {
            const response = await window.fetchWithAuth(`${API_BASE}/getaddresses/${customerId}`);
            const res = await response.json();
            if (res.success && Array.isArray(res.data) && res.data.length) {
                addressesCache = res.data;
                res.data.forEach(function(a) {
                    var id = a.addressId ?? a.AddressId;
                    var title = a.title ?? a.Title ?? '';
                    var text = a.addressText ?? a.AddressText ?? '';
                    var bits = [];
                    if (title) bits.push(title);
                    if (text) bits.push(text);
                    var unit = a.unit ?? a.Unit;
                    var floor = a.floor ?? a.Floor;
                    var plate = a.plateNumber ?? a.PlateNumber;
                    var extras = [];
                    if (unit) extras.push('واحد ' + unit);
                    if (floor) extras.push('طبقه ' + floor);
                    if (plate) extras.push('پلاک ' + plate);
                    var label = bits.join(' — ');
                    if (extras.length) label += ' (' + extras.join('، ') + ')';
                    if (a.isDefault ?? a.IsDefault) label = '★ ' + label;
                    options += `<option value="${id}">${escapeHtml(label)}</option>`;
                });
                $('#addressSelect, #offcanvasAddressSelect').html(options);

                var defaultAddr = res.data.find(function(a) { return !!(a.isDefault ?? a.IsDefault); });
                if (keepId && res.data.some(function(a) { return String(a.addressId ?? a.AddressId) === String(keepId); })) {
                    applySelectedSavedAddress(keepId);
                } else if (defaultAddr) {
                    applySelectedSavedAddress(defaultAddr.addressId ?? defaultAddr.AddressId);
                }
            } else if (!res.success) {
                console.warn('getaddresses failed', res.message || response.status);
            }
        } catch (e) {
            console.warn('load addresses failed', e);
        }
    }

