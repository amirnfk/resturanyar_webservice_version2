@model List<FoodItemViewModel>
@{
    ViewData["Title"] = "ثبت سفارش جدید";
    var placeholder = Url.Content("~/images/food_placeholder.jpg");
}

@section Styles {
    <link rel="stylesheet" href="~/css/add-order.css" asp-append-version="true" />
}

<div class="container food-page order-page mt-4">
    <div class="row">

        <!-- Food List Column -->
        <div class="col-lg-8">
            <div class="food-toolbar mb-3">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-4">
                        <input id="searchBox" type="text" class="form-control form-control-sm" placeholder="جستجو..." />
                    </div>
                    <div class="col-6 col-md-3">
                        <select id="filterCategory" class="form-select form-select-sm">
                            <option value="">همه دسته‌ها</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <select id="filterAvailability" class="form-select form-select-sm">
                            <option value="">همه وضعیت‌ها</option>
                            <option value="true">موجود</option>
                            <option value="false">ناموجود</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <select id="sortBy" class="form-select form-select-sm">
                            <option value="newest">جدیدترین</option>
                            <option value="name-asc">نام (الف تا ی)</option>
                            <option value="name-desc">نام (ی تا الف)</option>
                            <option value="price-asc">قیمت (کم به زیاد)</option>
                            <option value="price-desc">قیمت (زیاد به کم)</option>
                            <option value="discount-desc">بیشترین تخفیف</option>
                        </select>
                    </div>
                </div>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-warning text-center">غذایی برای نمایش وجود ندارد.</div>
            }
            else
            {
                <div class="row" id="foodList">
                    @foreach (var item in Model)
                    {
                        var hasDiscount = item.DiscountPrice > 0 && item.DiscountPrice != item.Price;
                        var discountPercent = hasDiscount ? (int)Math.Round(((item.Price - item.DiscountPrice) / item.Price) * 100) : 0;
                        var unavailableClass = item.IsAvailable ? "" : "is-unavailable";
                        <div class="col-6 col-md-4 col-lg-3 mb-3 food-card-item"
                             data-id="@item.FoodItemId"
                             data-name="@item.Name"
                             data-description="@item.Description"
                             data-category="@item.CategoryId"
                             data-categoryname="@item.CategoryName"
                             data-price="@item.Price"
                             data-discountprice="@item.DiscountPrice"
                             data-isavailable="@item.IsAvailable"
                             data-image="@(item.ImageUrl ?? "")">
                            <div class="food-card h-100 @unavailableClass">
                                <div class="food-img-wrap">
                                    <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? placeholder : item.ImageUrl)"
                                         class="food-img" loading="lazy"
                                         onerror="this.onerror=null;this.src='@placeholder';" />
                                    @if (hasDiscount)
                                    {
                                        <span class="ribbon">@discountPercent% تخفیف</span>
                                    }
                                    @if (!item.IsAvailable)
                                    {
                                        <div class="unavailable-overlay">
                                            <i class="fa-solid fa-circle-xmark"></i>
                                            <span>ناموجود</span>
                                        </div>
                                    }
                                </div>
                                <div class="food-body">
                                    <h5 class="food-title">@item.Name</h5>
                                    <p class="food-desc">@item.Description</p>
                                    <div class="mb-2">
                                        <span class="chip"><i class="fa-solid fa-folder ms-1"></i> @item.CategoryName</span>
                                        @if (!item.IsAvailable)
                                        {
                                            <span class="badge bg-danger badge-availability ms-1">ناموجود</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success badge-availability ms-1">موجود</span>
                                        }
                                    </div>
                                    <div class="price-area">
                                        @if (hasDiscount)
                                        {
                                            <span class="price-old">@item.Price.ToString("N0") تومان</span>
                                            <span class="price-new">@item.DiscountPrice.ToString("N0") تومان</span>
                                        }
                                        else
                                        {
                                            <span class="price-new">@item.Price.ToString("N0") تومان</span>
                                        }
                                    </div>
                                </div>
                                <div class="food-footer">
                                    <button class="btn btn-primary add-to-cart-btn"
                                            data-id="@item.FoodItemId"
                                            data-name="@item.Name"
                                            data-price="@(item.DiscountPrice > 0 ? item.DiscountPrice : item.Price)">
                                        افزودن به سفارش
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Desktop cart sidebar -->
        <div class="col-lg-4">
            <div class="cart-sidebar">
                <h4 class="cart-title"><i class="fa-solid fa-cart-shopping ms-1"></i> سفارش جاری</h4>
                <div id="cart-items-container">
                    <div class="empty-cart">سبد خرید خالی است</div>
                </div>
                <div class="mb-3 mt-3">
                    <label class="form-label">انتخاب میز <span class="text-danger">*</span></label>
                    <select id="tableSelect" class="form-select" required>
                        <option value="">-- انتخاب میز --</option>
                    </select>
                    <small class="text-muted" id="tableSeatsInfo"></small>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">مشتری </label>
                    <div class="customer-search-wrapper">
                        <div class="input-group">
                            <input type="text" id="desktopCustomerSearch" class="form-control"
                                   placeholder="شماره موبایل یا نام ..." autocomplete="off">
                            <button class="btn btn-new-customer" type="button"
                                    data-bs-toggle="modal" data-bs-target="#newCustomerModal"
                                    data-context="desktop">
                                <i class="bi bi-person-plus"></i> مشتری جدید
                            </button>
                        </div>
                        <div class="search-spinner" id="desktopSearchSpinner"></div>
                        <div id="desktopCustomerSearchResults" class="customer-search-results"></div>
                    </div>
                    <input type="hidden" id="desktopSelectedCustomerId">
                    <div id="desktopSelectedCustomerInfo" class="mt-2"></div>
                </div>
                <div class="mb-3">
                    <label class="form-label">توضیحات</label>
                    <textarea id="orderDescription" class="form-control" rows="2" placeholder="..."></textarea>
                </div>
                <button id="submitOrderBtn" class="btn btn-primary w-100 py-2">نهایی کردن سفارش</button>
            </div>
        </div>
    </div>
</div>

<!-- Mobile FAB -->
<button class="cart-fab d-lg-none" type="button"
        data-bs-toggle="offcanvas" data-bs-target="#cartOffcanvas">
    <i class="bi bi-bag"></i>
    <span>سبد سفارش</span>
    <span class="badge" id="mobileCartCount">0</span>
    <span id="mobileCartTotal">0</span> تومان
</button>

<!-- Mobile offcanvas -->
<div class="offcanvas offcanvas-end cart-offcanvas" tabindex="-1" id="cartOffcanvas">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title"><i class="fa-solid fa-cart-shopping ms-1"></i> سفارش جاری</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column">
        <div id="offcanvas-cart-items-container">
            <div class="empty-cart">سبد خرید خالی است</div>
        </div>
        <div class="mt-3 mb-3">
            <label class="form-label">انتخاب میز <span class="text-danger">*</span></label>
            <select id="offcanvasTableSelect" class="form-select" required>
                <option value="">-- انتخاب میز --</option>
            </select>
            <small class="text-muted" id="offcanvasTableSeatsInfo"></small>
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">مشتری (اختیاری)</label>
            <div class="customer-search-wrapper">
                <div class="input-group">
                    <input type="text" id="offcanvasCustomerSearch" class="form-control"
                           placeholder="شماره موبایل یا نام ..." autocomplete="off">
                    <button class="btn btn-new-customer" type="button"
                            data-bs-toggle="modal" data-bs-target="#newCustomerModal"
                            data-context="offcanvas">
                        <i class="bi bi-person-plus"></i> مشتری جدید
                    </button>
                </div>
                <div class="search-spinner" id="offcanvasSearchSpinner"></div>
                <div id="offcanvasCustomerSearchResults" class="customer-search-results"></div>
            </div>
            <input type="hidden" id="offcanvasSelectedCustomerId">
            <div id="offcanvasSelectedCustomerInfo" class="mt-2"></div>
        </div>
        <div class="mb-3">
            <label class="form-label">توضیحات (اختیاری)</label>
            <textarea id="offcanvasOrderDescription" class="form-control" rows="2" placeholder="درخواست ویژه..."></textarea>
        </div>
        <button id="offcanvasSubmitOrderBtn" class="btn btn-primary w-100 py-2 mt-auto"><i class="fa-solid fa-circle-check ms-1"></i> نهایی کردن سفارش</button>
    </div>
</div>

<!-- New customer modal -->
<div class="modal fade" id="newCustomerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">ثبت مشتری جدید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">شماره موبایل <span class="text-danger">*</span></label>
                    <input type="tel" id="newCustomerMobile" class="form-control" dir="ltr">
                </div>
                <div class="mb-3">
                    <label class="form-label">نام کامل</label>
                    <input type="text" id="newCustomerFullName" class="form-control">
                </div>
                <div class="mb-3">
                    <label class="form-label">توضیحات (اختیاری)</label>
                    <textarea id="newCustomerDesc" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" id="saveNewCustomerBtn">ذخیره و انتخاب</button>
            </div>
        </div>
    </div>
</div>

<div class="toast-container" id="toastContainer"></div>

@section Scripts {
<script>
    // ══════════════════════════════════════════════════════════
    //  CONSTANTS & STATE (V2 endpoints)
    // ══════════════════════════════════════════════════════════
    var API_BASE      = "/api/v2/UserApi";
    var   restaurantId  = @(ViewBag.RestaurantId ?? 0);

    var cart               = [];
    var selectedCustomerId = null;
    var activeModalContext = 'desktop';
    var isSubmittingOrder  = false;
    var isSubmittingCustomer = false;
    var currentSearchXhr   = null;

    // ══════════════════════════════════════════════════════════
    //  HELPERS
    // ══════════════════════════════════════════════════════════
    function escapeHtml(str) {
        if (!str) return '';
        return String(str).replace(/[&<>"']/g, function(m) {
            return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m];
        });
    }

    function showToast(message, type) {
        type = type || 'success';
        const container = document.getElementById('toastContainer');
        if (!container) return;
        const id    = 'toast-' + Date.now();
        const icons = {
            success: '<i class="fa-solid fa-circle-check"></i>',
            error: '<i class="fa-solid fa-circle-xmark"></i>',
            info: '<i class="fa-solid fa-circle-info"></i>'
        };
        const titles = { success:'موفقیت', error:'خطا', info:'اطلاعیه' };
        container.insertAdjacentHTML('beforeend',
            `<div id="${id}" class="toast custom-toast toast-${type}" role="alert" aria-atomic="true" data-bs-autohide="true" data-bs-delay="4000">
                <div class="toast-header"><strong class="me-auto">${icons[type]||''} ${titles[type]||''}</strong>
                <button type="button" class="btn-close btn-close-dark" data-bs-dismiss="toast"></button></div>
                <div class="toast-body">${escapeHtml(message)}</div>
            </div>`);
        const el = document.getElementById(id);
        new bootstrap.Toast(el, { autohide: true, delay: 4000 }).show();
        el.addEventListener('hidden.bs.toast', () => el.remove());
    }

    // ══════════════════════════════════════════════════════════
    //  CUSTOMER HELPERS  (always sync both sides)
    // ══════════════════════════════════════════════════════════
    var CONTEXTS = {
        desktop: {
            searchId:  '#desktopCustomerSearch',
            hiddenId:  '#desktopSelectedCustomerId',
            infoId:    '#desktopSelectedCustomerInfo',
            resultsId: '#desktopCustomerSearchResults',
            spinnerId: '#desktopSearchSpinner'
        },
        offcanvas: {
            searchId:  '#offcanvasCustomerSearch',
            hiddenId:  '#offcanvasSelectedCustomerId',
            infoId:    '#offcanvasSelectedCustomerInfo',
            resultsId: '#offcanvasCustomerSearchResults',
            spinnerId: '#offcanvasSearchSpinner'
        }
    };

    function selectCustomer(id, mobile, name) {
        selectedCustomerId = id;
        const nameHtml = name ? ` - ${escapeHtml(name)}` : '';
        $.each(CONTEXTS, function(ctx, sel) {
            $(sel.hiddenId).val(id);
            $(sel.infoId).html(
                `<div class="selected-customer-card">
                    <div class="customer-detail">
                        <strong>${escapeHtml(mobile)}</strong>${nameHtml}
                        <div class="small text-muted mt-1"><i class="fa-solid fa-circle-check ms-1"></i> انتخاب شده</div>
                    </div>
                    <button type="button" class="btn-change-customer" data-context="${ctx}">تغییر</button>
                </div>`);
            $(sel.searchId).val(mobile + (name ? ' ' + name : ''));
            $(sel.resultsId).empty().hide();
            $(sel.spinnerId).hide();
        });
    }

    function resetCustomer() {
        selectedCustomerId = null;
        $.each(CONTEXTS, function(ctx, sel) {
            $(sel.hiddenId).val('');
            $(sel.infoId).empty();
            $(sel.searchId).val('');
            $(sel.resultsId).empty().hide();
            $(sel.spinnerId).hide();
        });
    }

    function clearCustomerForContext(context) {
        resetCustomer();
        $(CONTEXTS[context].searchId).focus();
    }

    // ══════════════════════════════════════════════════════════
    //  CUSTOMER SEARCH SETUP (using fetchWithAuth)
    // ══════════════════════════════════════════════════════════
    function setupCustomerSearch(context) {
        var sel = CONTEXTS[context];
        var debounceTimer;
        var ns = '.addOrder' + context;

        $(sel.searchId).off('input' + ns).on('input' + ns, function() {
            clearTimeout(debounceTimer);
            var val = $(this).val();
            if (!val.trim()) {
                $(sel.resultsId).empty().hide();
                $(sel.spinnerId).hide();
                return;
            }
            debounceTimer = setTimeout(function() { doSearch(context, val.trim()); }, 400);
        });

        $(document).off('click' + ns, sel.resultsId + ' .customer-result-item')
            .on('click' + ns, sel.resultsId + ' .customer-result-item', function(e) {
            e.preventDefault();
            selectCustomer(
                $(this).data('id'),
                $(this).data('mobile'),
                $(this).data('name') || ''
            );
        });

        $(document).off('click' + ns + 'Outside').on('click' + ns + 'Outside', function(e) {
            if (!$(e.target).closest(sel.searchId).length &&
                !$(e.target).closest(sel.resultsId).length) {
                $(sel.resultsId).hide();
            }
        });
    }

    // We'll use a simple counter to ignore outdated responses
    var searchCounter = 0;

    async function doSearch(context, query) {
        var sel = CONTEXTS[context];
        // Increment counter to ignore old responses
        const currentSearchId = ++searchCounter;
        $(sel.spinnerId).show();

        try {
            const response = await window.fetchWithAuth(
                `${API_BASE}/getcustomers/${restaurantId}?search=${encodeURIComponent(query)}&page=1&pageSize=8`
            );
            if (!response.ok) {
                throw new Error('Network response was not ok');
            }
            const res = await response.json();
            // Ignore if this response is outdated
            if (currentSearchId !== searchCounter) return;
            $(sel.spinnerId).hide();

            if (res.success && res.data && res.data.length) {
                var html = '';
                res.data.forEach(function(c) {
                    html += `<div class="customer-result-item"
                                  data-id="${c.customerId}"
                                  data-mobile="${escapeHtml(c.mobile)}"
                                  data-name="${escapeHtml(c.fullName || '')}">
                        <div>
                            <div class="customer-mobile"><i class="fa-solid fa-phone ms-1"></i> ${escapeHtml(c.mobile)}</div>
                            ${c.fullName ? `<div class="customer-name">${escapeHtml(c.fullName)}</div>` : ''}
                        </div>
                    </div>`;
                });
                $(sel.resultsId).html(html).show();
            } else {
                $(sel.resultsId).html('<div class="p-3 text-center text-muted">مشتری‌ای یافت نشد</div>').show();
            }
        } catch (error) {
            if (currentSearchId !== searchCounter) return;
            $(sel.spinnerId).hide();
            $(sel.resultsId).html('<div class="p-3 text-center text-danger">خطا در جستجو</div>').show();
        }
    }

    // ── New Customer Modal ──
    async function saveNewCustomer() {
        if (isSubmittingCustomer) return;

        var fullName = $('#newCustomerFullName').val().trim();
        var mobile;
        var description = $('#newCustomerDesc').val().trim();

        if (fullName !== "") {
            mobile = generateAutoMobile();
        } else {
            mobile = $('#newCustomerMobile').val().trim();
            if (!/^09[0-9]{9}$/.test(mobile)) {
                showToast('شماره موبایل معتبر (11 رقم، شروع با 09) وارد کنید', 'error');
                return;
            }
            fullName = "مشتری مهمان";
        }

        var $btn = $('#saveNewCustomerBtn');
        var originalHtml = $btn.html();
        $btn.html('<span class="spinner-border spinner-border-sm me-1"></span> در حال ثبت...').prop('disabled', true);
        isSubmittingCustomer = true;

        try {
            const response = await window.fetchWithAuth(`${API_BASE}/addcustomer`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ restaurantId: restaurantId, mobile: mobile, fullName: fullName, description: description })
            });
            const res = await response.json();
            if (res.success) {
                showToast('مشتری با موفقیت ثبت شد', 'success');

                var modalEl = document.getElementById('newCustomerModal');
                var bsModal = bootstrap.Modal.getInstance(modalEl);
                if (bsModal) bsModal.hide();

                setTimeout(function() {
                    $('.modal-backdrop').remove();
                    $('body').removeClass('modal-open');
                    $('body').css({ overflow: '', paddingRight: '' });
                }, 150);

                selectCustomer(res.customerId, mobile, fullName);
            } else {
                showToast(res.message || 'خطا در ثبت مشتری', 'error');
                $btn.html(originalHtml).prop('disabled', false);
                isSubmittingCustomer = false;
            }
        } catch (error) {
            var msg = 'خطا در ارتباط با سرور';
            if (error.message) msg = error.message;
            showToast(msg, 'error');
            $btn.html(originalHtml).prop('disabled', false);
            isSubmittingCustomer = false;
        }
    }

    function generateAutoMobile() {
        const prefix = '991';
        const timestamp = Date.now().toString();
        const eightDigits = timestamp.slice(2, 10);
        const random = Math.floor(Math.random() * 10);
        return prefix + eightDigits + random;
    }

    // ── Cart rendering ──
    function renderCart() {
        var itemCount  = cart.reduce(function(s,i){ return s + i.quantity; }, 0);
        var cartTotal  = cart.reduce(function(s,i){ return s + i.price * i.quantity; }, 0);

        function buildHtml(container) {
            if (!$(container).length) return;
            if (!cart.length) {
                $(container).html('<div class="empty-cart">سبد خرید خالی است</div>');
                return;
            }
            var html = '<div class="cart-items-list">';
            cart.forEach(function(item, idx) {
                var itemTotal = item.price * item.quantity;
                html += `<div class="cart-item">
                    <div class="cart-item-info">
                        <strong>${escapeHtml(item.name)}</strong>
                        <small>${item.price.toLocaleString()} تومان</small>
                    </div>
                    <div class="cart-item-actions">
                        <input type="number" min="1" value="${item.quantity}" class="cart-qty" data-idx="${idx}">
                        <button class="remove-item-btn" data-idx="${idx}" aria-label="حذف"><i class="fa-solid fa-trash-can"></i></button>
                    </div>
                    <div class="cart-item-total ms-2 fw-bold">${itemTotal.toLocaleString()} تومان</div>
                </div>`;
            });
            html += `<div class="cart-total d-flex justify-content-between">
                        <span>جمع کل:</span>
                        <span>${cartTotal.toLocaleString()} تومان</span>
                     </div>`;
            $(container).html(html);
        }

        buildHtml('#cart-items-container');
        buildHtml('#offcanvas-cart-items-container');
        $('#mobileCartCount').text(itemCount);
        $('#mobileCartTotal').text(cartTotal.toLocaleString());
    }

    function addToCart(id, name, price) {
        var existing = cart.find(function(i){ return i.id === id; });
        if (existing) existing.quantity++;
        else cart.push({ id: id, name: name, price: price, quantity: 1 });
        renderCart();
    }

    // ══════════════════════════════════════════════════════════
    //  TABLES (using fetchWithAuth)
    // ══════════════════════════════════════════════════════════
    async function loadTables() {
        if (!restaurantId) return;
        try {
            const response = await window.fetchWithAuth(`${API_BASE}/gettablesbyrestaurant/${restaurantId}`);
            if (!response.ok) throw new Error('Failed to load tables');
            const data = await response.json();
            var base = '<option value="">-- انتخاب میز --</option>';
            if (data.tables && data.tables.length) {
                var opts = '';
                data.tables.forEach(function(t) {
                    opts += `<option value="${escapeHtml(t.tableName)}" data-seats="${t.seats}">
                                ${escapeHtml(t.tableName)} (${t.seats} صندلی)
                             </option>`;
                });
                $('#tableSelect, #offcanvasTableSelect').html(base + opts);
            } else {
                $('#tableSelect, #offcanvasTableSelect').html(base + '<option disabled>میز فعالی یافت نشد</option>');
            }
        } catch (error) {
            $('#tableSelect, #offcanvasTableSelect').html('<option value="">-- خطا در بارگذاری میزها --</option>');
            showToast('خطا در دریافت لیست میزها', 'error');
        }
    }

    // ══════════════════════════════════════════════════════════
    //  SUBMIT ORDER (using fetchWithAuth)
    // ══════════════════════════════════════════════════════════
    async function submitOrder(tableSelectId, descriptionId, btnElement) {
        if (isSubmittingOrder) return;

        var tableName = $(tableSelectId).val();
        if (!tableName) {
            showToast('لطفاً یک میز را انتخاب کنید.', 'error');
            return;
        }
        if (!cart.length) {
            showToast('هیچ آیتمی به سفارش اضافه نشده است.', 'error');
            return;
        }

        isSubmittingOrder = true;
        var $btn = $(btnElement);
        var originalHtml = $btn.html();
        $btn.html('<span class="spinner-border spinner-border-sm me-1"></span> در حال ثبت...').prop('disabled', true);

        try {
            const response = await window.fetchWithAuth(`${API_BASE}/createOrder`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    restaurantId: restaurantId,
                    tableNumber:  tableName,
                    statusId:     3,
                    description:  $(descriptionId).val().trim(),
                    items:        cart.map(function(i){ return { foodItemId: i.id, quantity: i.quantity }; }),
                    customerId:   selectedCustomerId
                })
            });
            const res = await response.json();
            if (res.success) {
                showToast('سفارش با موفقیت ثبت شد!', 'success');
                cart = [];
                resetCustomer();
                renderCart();
                $('#tableSelect, #offcanvasTableSelect').val('');
                $('#tableSeatsInfo, #offcanvasTableSeatsInfo').text('');
                $('#orderDescription, #offcanvasOrderDescription').val('');
                var oc = bootstrap.Offcanvas.getInstance(document.getElementById('cartOffcanvas'));
                if (oc) oc.hide();
            } else {
                showToast('خطا در ثبت سفارش: ' + (res.message || 'نامشخص'), 'error');
            }
        } catch (error) {
            var msg = 'خطای ارتباط با سرور';
            if (error.status === 401) msg = 'لطفاً ابتدا وارد حساب کاربری خود شوید.';
            else if (error.message) msg = error.message;
            showToast(msg, 'error');
        } finally {
            isSubmittingOrder = false;
            $btn.html(originalHtml).prop('disabled', false);
        }
    }


    // ══════════════════════════════════════════════════════════
    //  FILTER CATEGORIES (using fetchWithAuth)
    // ══════════════════════════════════════════════════════════
    async function populateFilterCategories() {
        try {
            const response = await window.fetchWithAuth(`${API_BASE}/getcategoriesbyrestaurant/${restaurantId}`);
            if (!response.ok) throw new Error('Failed to load categories');
            const data = await response.json();
            var $sel = $('#filterCategory').empty().append('<option value="">همه دسته‌ها</option>');
            (data.categories || []).forEach(function(c) {
                $sel.append(`<option value="${c.categoryId}">${escapeHtml(c.categoryName)}</option>`);
            });
        } catch (error) {
            // fallback: read from DOM
            var seen = new Set();
            $('.food-card-item').each(function() {
                var id = String($(this).data('category'));
                var name = $(this).data('categoryname');
                if (id && !seen.has(id)) {
                    $('#filterCategory').append(`<option value="${id}">${escapeHtml(name)}</option>`);
                    seen.add(id);
                }
            });
        }
    }

    // ── Filter & Sort ──
    function applyFilters() {
        var q    = $('#searchBox').val().trim().toLowerCase();
        var cat  = $('#filterCategory').val();
        var avail = $('#filterAvailability').val();
        var sort = $('#sortBy').val();

        var cards = $('.food-card-item').toArray();
        cards.forEach(function(el) {
            var $el = $(el);
            var name     = ($el.data('name') || '').toString().toLowerCase();
            var desc     = ($el.data('description') || '').toString().toLowerCase();
            var category = String($el.data('category') || '');
            var isAvail  = String($el.data('isavailable')).toLowerCase();
            var ok = true;
            if (q    && !(name.includes(q) || desc.includes(q))) ok = false;
            if (cat  && category !== String(cat))                ok = false;
            if (avail && isAvail !== String(avail))              ok = false;
            $el.toggle(ok);
        });

        var visible = $('.food-card-item:visible').toArray();
        visible.sort(function(a, b) {
            var $a = $(a), $b = $(b);
            var nameA = ($a.data('name') || '').toString();
            var nameB = ($b.data('name') || '').toString();
            var priceA = parseFloat($a.data('price') || 0);
            var priceB = parseFloat($b.data('price') || 0);
            var discA  = parseFloat($a.data('discountprice') || 0);
            var discB  = parseFloat($b.data('discountprice') || 0);
            var finalA = discA > 0 ? discA : priceA;
            var finalB = discB > 0 ? discB : priceB;
            switch (sort) {
                case 'name-asc':      return nameA.localeCompare(nameB, 'fa');
                case 'name-desc':     return nameB.localeCompare(nameA, 'fa');
                case 'price-asc':     return finalA - finalB;
                case 'price-desc':    return finalB - finalA;
                case 'discount-desc': return (priceA - discA) - (priceB - discB);
                default:              return 0;
            }
        });
        var $container = $('#foodList');
        visible.forEach(function(el) { $container.append(el); });
    }

    // ══════════════════════════════════════════════════════════
    //  INIT
    // ══════════════════════════════════════════════════════════
    function bindAddOrderEvents() {
        $('#newCustomerModal')
            .off('show.bs.modal.addOrder hidden.bs.modal.addOrder')
            .on('show.bs.modal.addOrder', function(e) {
                var btn = $(e.relatedTarget);
                activeModalContext = btn.data('context') || 'desktop';
                $('#newCustomerMobile, #newCustomerFullName, #newCustomerDesc').val('');
                isSubmittingCustomer = false;
                $('#saveNewCustomerBtn').prop('disabled', false).html('ذخیره و انتخاب');
            })
            .on('hidden.bs.modal.addOrder', function() {
                $('.modal-backdrop').remove();
                $('body').removeClass('modal-open').css({ overflow: '', paddingRight: '' });
                isSubmittingCustomer = false;
            });

        $('#saveNewCustomerBtn')
            .off('click.addOrder')
            .on('click.addOrder', saveNewCustomer);

        $(document)
            .off('click.addOrder', '.btn-change-customer')
            .on('click.addOrder', '.btn-change-customer', function() {
                clearCustomerForContext($(this).data('context'));
            })
            .off('click.addOrder', '.add-to-cart-btn')
            .on('click.addOrder', '.add-to-cart-btn', function() {
                addToCart(parseInt($(this).data('id')), $(this).data('name'), parseFloat($(this).data('price')));
            })
            .off('change.addOrder', '.cart-qty')
            .on('change.addOrder', '.cart-qty', function() {
                var idx = parseInt($(this).data('idx'));
                var val = parseInt($(this).val());
                if (isNaN(val) || val < 1) cart.splice(idx, 1);
                else cart[idx].quantity = val;
                renderCart();
            })
            .off('click.addOrder', '.remove-item-btn')
            .on('click.addOrder', '.remove-item-btn', function() {
                cart.splice(parseInt($(this).data('idx')), 1);
                renderCart();
            })
            .off('change.addOrder', '#tableSelect')
            .on('change.addOrder', '#tableSelect', function() {
                var seats = $(this).find(':selected').data('seats');
                $('#tableSeatsInfo').text(seats ? 'تعداد صندلی‌ها: ' + seats : '');
            })
            .off('change.addOrder', '#offcanvasTableSelect')
            .on('change.addOrder', '#offcanvasTableSelect', function() {
                var seats = $(this).find(':selected').data('seats');
                $('#offcanvasTableSeatsInfo').text(seats ? 'تعداد صندلی‌ها: ' + seats : '');
            });
    }

    function initAddOrderPage() {
        cart = [];
        selectedCustomerId = null;
        isSubmittingOrder = false;
        isSubmittingCustomer = false;

        $('#filterCategory').find('option:not(:first)').remove();
        $('#searchBox, #filterCategory, #filterAvailability, #sortBy')
            .off('input.addOrder change.addOrder')
            .on('input.addOrder change.addOrder', applyFilters);
        $('#submitOrderBtn').off('click.addOrder').on('click.addOrder', function() { submitOrder('#tableSelect', '#orderDescription', this); });
        $('#offcanvasSubmitOrderBtn').off('click.addOrder').on('click.addOrder', function() { submitOrder('#offcanvasTableSelect', '#offcanvasOrderDescription', this); });

        bindAddOrderEvents();
        populateFilterCategories();
        loadTables();
        renderCart();
        setupCustomerSearch('desktop');
        setupCustomerSearch('offcanvas');
    }

    window.initAddOrderPage = initAddOrderPage;
</script>
}