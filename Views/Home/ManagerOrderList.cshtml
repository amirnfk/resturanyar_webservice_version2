@model resturanyar.Models.OrderListViewModel

@{

    ViewData["Title"] = "مدیریت سفارش‌ها";

     

    string currentPeriod = ViewData["CurrentPeriod"]?.ToString() ?? "";

}

@section Styles {

    <link rel="stylesheet" href="~/css/jalalidatepicker.min.css" />

    <link rel="stylesheet" href="~/css/order-status-tokens.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/manager-order-list.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/brand-scrollbar.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/manager-order-edit.css" asp-append-version="true" />

    <script>document.documentElement.classList.add('hide-support-chat-fab');</script>

}



<div class="container orders-page py-4 mt-2">

    <div class="filter-card p-4 mb-4">

        <form id="filterForm" class="row g-3 align-items-end" method="get" action="@Url.Action("ManagerOrderList","Home")">

            <div class="col-md-2 col-sm-6">

                <label class="form-label">وضعیت</label>

                <select name="statusId" class="form-select">

                    <option value="0" selected="@(Model.FilterStatusId == 0 ? "selected" : null)">انتخاب...</option>

                    <option value="-1" selected="@(Model.FilterStatusId == -1 ? "selected" : null)">همه</option>

                    @foreach (var kv in Model.StatusMap)

                    {

                        <option value="@kv.Key" selected="@(Model.FilterStatusId == kv.Key ? "selected" : null)">@kv.Value</option>

                    }

                </select>

            </div>



            <div class="col-md-2 col-sm-6">

                <label class="form-label">از تاریخ</label>

                <input data-jdp id="fromFa" class="form-control bg-white" placeholder="انتخاب کنید" readonly />

                <input type="hidden" name="from" id="fromIso" value="@(Model.FromDate?.ToString("yyyy-MM-dd") ?? "")" />

                <div id="fromFaErr" class="invalid-feedback d-none">تاریخ معتبر نیست</div>

            </div>

            <div class="col-md-2 col-sm-6">

                <label class="form-label">تا تاریخ</label>

                <input data-jdp id="toFa" class="form-control bg-white" placeholder="انتخاب کنید" readonly />

                <input type="hidden" name="to" id="toIso" value="@(Model.ToDate?.ToString("yyyy-MM-dd") ?? "")" />

                <div id="toFaErr" class="invalid-feedback d-none">تاریخ معتبر نیست</div>

            </div>



            <div class="col-md-2 col-sm-6">

                <label class="form-label">جست‌وجو</label>

                <input type="text" name="search" class="form-control" placeholder="شماره سفارش یا توضیح"

                       value="@(Model.Search ?? "")" />

            </div>



            <div class="col-md-2 col-sm-6">

                <label class="form-label">تعداد در صفحه</label>

                <select name="pageSize" class="form-select">

                    <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10</option>

                    <option value="20" selected="@(Model.PageSize == 20 ? "selected" : null)">20</option>

                    <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50</option>

                </select>

            </div>



            <div class="col-md-2 col-sm-12">

                <label class="form-label d-none d-md-block">&nbsp;</label>

                <div class="filter-actions">

                    <button type="submit" class="btn btn-primary">اعمال</button>

                    <button type="button" id="btnResetFilters" class="btn btn-outline-secondary">

                        <i class="fas fa-undo-alt ms-1"></i> بازنشانی

                    </button>

                </div>

            </div>



            <div class="col-12 pt-3 d-flex flex-wrap gap-2 justify-content-center justify-content-md-start">

                <a href="@Url.Action("ManagerOrderList", "Home", new { period = "today", page = 1 })"

                   class="btn btn-outline-secondary quick-filter-btn @(currentPeriod == "today" ? "active" : "")">امروز</a>

                <a href="@Url.Action("ManagerOrderList", "Home", new { period = "week", page = 1 })"

                   class="btn btn-outline-secondary quick-filter-btn @(currentPeriod == "week" ? "active" : "")">هفته</a>

                <a href="@Url.Action("ManagerOrderList", "Home", new { period = "month", page = 1 })"

                   class="btn btn-outline-secondary quick-filter-btn @(currentPeriod == "month" ? "active" : "")">ماه</a>

                <a href="@Url.Action("ManagerOrderList", "Home", new { period = "quarter", page = 1 })"

                   class="btn btn-outline-secondary quick-filter-btn @(currentPeriod == "quarter" ? "active" : "")">سه‌ماهه</a>

                <a href="@Url.Action("ManagerOrderList", "Home", new { period = "year", page = 1 })"

                   class="btn btn-outline-secondary quick-filter-btn @(currentPeriod == "year" ? "active" : "")">سال</a>

            </div>

        </form>

    </div>



    <div id="ordersContainer" class="orders-scroll" data-restaurant-id="@(ViewBag.RestaurantId)">

        @await Html.PartialAsync("_ManagerOrdersPartial", Model)

    </div>

</div>

<!-- Order edit drawer (outside #ordersContainer so AJAX/SignalR reloads do not destroy it) -->
<div class="offcanvas offcanvas-end moe" tabindex="-1" id="orderEditOffcanvas"
     aria-labelledby="moeDrawerTitle" data-restaurant-id="@(ViewBag.RestaurantId)">

    <header class="moe-head">
        <div class="moe-head__identity">
            <span class="moe-head__icon" aria-hidden="true"><i class="fa-solid fa-pen-to-square"></i></span>
            <div class="moe-head__text">
                <h2 class="moe-head__title" id="moeDrawerTitle">ویرایش سفارش</h2>
                <div class="moe-head__chips">
                    <span class="moe-chip moe-chip--type" title="نوع سفارش پس از ثبت قابل تغییر نیست">
                        <i class="fa-solid fa-lock" aria-hidden="true"></i>
                        <span id="moeOrderTypeBadge">حضوری</span>
                    </span>
                    <span class="moe-chip moe-chip--status" id="moeOrderStatusChip" hidden>
                        <i class="fa-solid fa-circle-dot" aria-hidden="true"></i>
                        <span id="moeOrderStatusBadge"></span>
                    </span>
                    <span class="moe-chip moe-chip--dirty" id="moeDirtyBadge" hidden>
                        <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                        <span>تغییرات ذخیره نشده</span>
                    </span>
                </div>
            </div>
        </div>
        <button type="button" class="moe-head__close" data-bs-dismiss="offcanvas" aria-label="بستن ویرایش">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
    </header>

    <nav class="moe-tabs" role="tablist" aria-label="بخش‌های ویرایش سفارش">
        <button type="button" class="moe-tab is-active" role="tab" aria-selected="true" data-moe-tab="catalog">
            <i class="fa-solid fa-burger" aria-hidden="true"></i> منوی غذا
        </button>
        <button type="button" class="moe-tab" role="tab" aria-selected="false" data-moe-tab="summary">
            <i class="fa-solid fa-receipt" aria-hidden="true"></i> جزئیات سفارش
            <span class="moe-tab__badge" id="moeTabItemCount">۰</span>
        </button>
    </nav>

    <div class="offcanvas-body moe-body">
        <div class="moe-loading" id="moeLoading" hidden aria-live="polite" aria-busy="true">
            <div class="moe-loading__box">
                <span class="moe-spinner" aria-hidden="true"></span>
                <span class="moe-loading__text">در حال بارگذاری سفارش...</span>
            </div>
        </div>

        <div class="moe-layout">
            <section class="moe-pane moe-pane--catalog is-active" data-moe-pane="catalog" aria-label="منوی غذا">
                <div class="moe-toolbar">
                    <div class="moe-search-wrap">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        <input type="text" id="moeFoodSearch" class="form-control" placeholder="جستجوی نام غذا..." autocomplete="off" aria-label="جستجوی غذا" />
                    </div>
                    <select id="moeFoodCategory" class="form-select moe-toolbar__select" aria-label="فیلتر دسته‌بندی">
                        <option value="">همه دسته‌ها</option>
                    </select>
                    <span class="moe-toolbar__count" id="moeFoodResultCount" aria-live="polite"></span>
                </div>
                <div class="moe-food-grid" id="moeFoodGrid">
                    <div class="moe-empty">
                        <span class="moe-empty__icon"><i class="fa-solid fa-utensils" aria-hidden="true"></i></span>
                        <span class="moe-empty__title">در حال بارگذاری غذاها...</span>
                    </div>
                </div>
            </section>

            <aside class="moe-pane moe-pane--summary" data-moe-pane="summary" aria-label="جزئیات سفارش">
                <div class="moe-card">
                    <div class="moe-card__head">
                        <span class="moe-card__title"><i class="fa-solid fa-receipt" aria-hidden="true"></i> اقلام سفارش</span>
                        <span class="moe-badge"><span id="moeItemCount">۰</span> عدد</span>
                    </div>
                    <div class="moe-items" id="moeItems">
                        <div class="moe-empty moe-empty--sm">
                            <span class="moe-empty__icon"><i class="fa-solid fa-basket-shopping" aria-hidden="true"></i></span>
                            <span class="moe-empty__title">هنوز آیتمی به سفارش اضافه نشده است.</span>
                            <span class="moe-empty__hint">از منوی غذا روی یک آیتم بزنید.</span>
                        </div>
                    </div>
                </div>

                <div class="moe-card">
                    <div class="moe-card__head">
                        <span class="moe-card__title"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> اطلاعات سفارش</span>
                    </div>

                    <div class="moe-field d-none" id="moeTableSection">
                        <label class="moe-label" for="moeTableSelect">میز <span class="moe-req">*</span></label>
                        <select id="moeTableSelect" class="form-select">
                            <option value="">انتخاب میز</option>
                        </select>
                    </div>

                    <div class="moe-field">
                        <label class="moe-label" for="moeCustomerSearch">
                            مشتری
                            <span class="moe-req d-none" id="moeCustomerRequired">*</span>
                        </label>
                        <div id="moeCustomerSearchWrap" class="moe-customer-search">
                            <div class="moe-inline-group">
                                <div class="moe-inline-group__field">
                                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                                    <input type="text" id="moeCustomerSearch" class="form-control" placeholder="جستجو با موبایل یا نام..." autocomplete="off" />
                                </div>
                                <button type="button" class="moe-icon-btn moe-icon-btn--primary" id="moeNewCustomerBtn" title="ثبت مشتری جدید" aria-label="ثبت مشتری جدید">
                                    <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="moe-icon-btn" id="moeClearCustomerBtn" title="ثبت به‌عنوان مهمان">
                                    مهمان
                                </button>
                            </div>
                            <div id="moeCustomerResults" class="moe-customer-results d-none" role="listbox"></div>
                        </div>
                        <div id="moeSelectedCustomer" class="moe-entity d-none"></div>
                    </div>

                    <div class="moe-field d-none" id="moeAddressSection">
                        <label class="moe-label">آدرس ارسال <span class="moe-req">*</span></label>
                        <div id="moeAddressPicker">
                            <select id="moeAddressSelect" class="form-select mb-2" aria-label="انتخاب آدرس ذخیره‌شده">
                                <option value="">انتخاب آدرس...</option>
                            </select>
                            <div class="moe-inline-group mb-2">
                                <div class="moe-inline-group__field">
                                    <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                                    <input type="text" id="moeCustomAddressText" class="form-control" placeholder="یا آدرس را دستی وارد کنید..." />
                                </div>
                                <button type="button" class="moe-icon-btn" id="moeUseCustomAddressBtn">اعمال</button>
                            </div>
                            <button type="button" class="moe-ghost-btn" id="moeOpenAddressFormBtn">
                                <i class="fa-solid fa-plus" aria-hidden="true"></i> ثبت آدرس جدید برای مشتری
                            </button>
                        </div>
                        <div id="moeSelectedAddress" class="moe-entity d-none"></div>
                    </div>

                    <div class="moe-field mb-0">
                        <label class="moe-label" for="moeDescription">توضیحات</label>
                        <textarea id="moeDescription" class="form-control" rows="2" placeholder="توضیحات سفارش (اختیاری)..."></textarea>
                    </div>
                </div>
            </aside>
        </div>
    </div>

    <footer class="moe-foot">
        <div class="moe-foot__summary">
            <span class="moe-foot__label">جمع اقلام</span>
            <strong class="moe-foot__total"><span id="moeTotalAmount">۰</span> <small>تومان</small></strong>
        </div>
        <div class="moe-foot__actions">
            <button type="button" class="moe-btn moe-btn--ghost" id="moeCancelBtn">انصراف</button>
            <button type="button" class="moe-btn moe-btn--primary" id="moeSaveBtn">
                <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> ذخیره تغییرات
            </button>
        </div>
    </footer>
</div>

<!-- New customer modal for order edit -->
<div class="modal fade moe-modal" id="moeNewCustomerModal" tabindex="-1" aria-labelledby="moeNewCustomerModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="moeNewCustomerModalTitle">
                    <span class="moe-modal__icon"><i class="fa-solid fa-user-plus" aria-hidden="true"></i></span>
                    ثبت مشتری جدید
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <div class="moe-field">
                    <label class="moe-label" for="moeNewCustomerMobile">شماره موبایل</label>
                    <input type="tel" id="moeNewCustomerMobile" class="form-control" dir="ltr" placeholder="09xxxxxxxxx" />
                </div>
                <div class="moe-field">
                    <label class="moe-label" for="moeNewCustomerName">نام کامل</label>
                    <input type="text" id="moeNewCustomerName" class="form-control" placeholder="نام و نام خانوادگی" />
                </div>
                <div class="moe-field mb-0">
                    <label class="moe-label" for="moeNewCustomerDesc">توضیحات</label>
                    <textarea id="moeNewCustomerDesc" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="moe-btn moe-btn--ghost" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="moe-btn moe-btn--primary" id="moeSaveCustomerBtn">ذخیره و انتخاب</button>
            </div>
        </div>
    </div>
</div>

<!-- New address modal for order edit -->
<div class="modal fade moe-modal" id="moeNewAddressModal" tabindex="-1" aria-labelledby="moeNewAddressModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="moeNewAddressModalTitle">
                    <span class="moe-modal__icon"><i class="fa-solid fa-location-dot" aria-hidden="true"></i></span>
                    ثبت آدرس جدید
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <div class="moe-field">
                    <label class="moe-label" for="moeNewAddrTitle">عنوان آدرس</label>
                    <input type="text" id="moeNewAddrTitle" class="form-control" maxlength="100" placeholder="خانه، محل کار، ..." />
                </div>
                <div class="moe-field">
                    <label class="moe-label" for="moeNewAddrText">متن آدرس <span class="moe-req">*</span></label>
                    <textarea id="moeNewAddrText" class="form-control" rows="3" required></textarea>
                </div>
                <div class="row g-2">
                    <div class="col-4 moe-field">
                        <label class="moe-label" for="moeNewAddrPlate">پلاک</label>
                        <input type="text" id="moeNewAddrPlate" class="form-control" maxlength="10" />
                    </div>
                    <div class="col-4 moe-field">
                        <label class="moe-label" for="moeNewAddrFloor">طبقه</label>
                        <input type="text" id="moeNewAddrFloor" class="form-control" maxlength="10" />
                    </div>
                    <div class="col-4 moe-field">
                        <label class="moe-label" for="moeNewAddrUnit">واحد</label>
                        <input type="text" id="moeNewAddrUnit" class="form-control" maxlength="10" />
                    </div>
                </div>
                <div class="moe-field">
                    <label class="moe-label" for="moeNewAddrDesc">توضیحات</label>
                    <textarea id="moeNewAddrDesc" class="form-control" rows="2"></textarea>
                </div>
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="moeNewAddrDefault" />
                    <label class="form-check-label" for="moeNewAddrDefault">این آدرس پیش‌فرض باشد</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="moe-btn moe-btn--ghost" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="moe-btn moe-btn--primary" id="moeSaveAddressBtn">ذخیره آدرس</button>
            </div>
        </div>
    </div>
</div>

<script src="~/js/manager-order-edit.js" asp-append-version="true"></script>

@section Scripts {

    <script src="~/js/jalalidatepicker.min.js"></script>
    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>

    <script>

        function setSupportChatFabVisible(visible) {
            document.documentElement.classList.toggle('hide-support-chat-fab', !visible);
            if (!visible && window.__rySupportChatInstance) {
                try {
                    if (typeof window.__rySupportChatInstance.minimize === 'function') {
                        window.__rySupportChatInstance.minimize();
                    } else if (typeof window.__rySupportChatInstance.close === 'function') {
                        window.__rySupportChatInstance.close();
                    }
                } catch (e) { /* ignore */ }
            }
        }

        function initManagerOrderListPage() {

            setSupportChatFabVisible(false);

            var ordersContainer = document.getElementById('ordersContainer');

            var filterForm = document.getElementById('filterForm');

            if (!ordersContainer || !filterForm) return;

            if (window._managerOrderListAbortController) {
                window._managerOrderListAbortController.abort();
            }

            window._managerOrderListAbortController = new AbortController();
            var signal = window._managerOrderListAbortController.signal;

            if (window._managerOrderHubReloadTimer) {
                clearTimeout(window._managerOrderHubReloadTimer);
                window._managerOrderHubReloadTimer = null;
            }

            if (window._managerOrderHub) {
                try { window._managerOrderHub.stop(); } catch (e) { /* ignore */ }
                window._managerOrderHub = null;
            }

            var currentOrdersUrl = window.location.pathname + window.location.search;
            var restaurantId = ordersContainer.getAttribute('data-restaurant-id') || '';



            function jalali_to_gregorian(jy, jm, jd) {

                jy -= 979; jm -= 1; jd -= 1;

                var j_day_no = 365 * jy + Math.floor(jy / 33) * 8 + Math.floor(((jy % 33) + 3) / 4);

                var j_days = [31, 31, 31, 31, 31, 31, 30, 30, 30, 30, 30, 29];

                for (var i = 0; i < jm; ++i) j_day_no += j_days[i];

                j_day_no += jd;

                var g_day_no = j_day_no + 79;

                var gy = 1600 + 400 * Math.floor(g_day_no / 146097); g_day_no %= 146097;

                var leap = true;

                if (g_day_no >= 36525) {

                    g_day_no--; gy += 100 * Math.floor(g_day_no / 36524); g_day_no %= 36524;

                    if (g_day_no >= 365) g_day_no++; else leap = false;

                }

                gy += 4 * Math.floor(g_day_no / 1461); g_day_no %= 1461;

                if (g_day_no >= 366) { leap = false; g_day_no--; gy += Math.floor(g_day_no / 365); g_day_no %= 365; }

                var g_days = [31, (leap ? 29 : 28), 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];

                var gm; for (gm = 0; g_day_no >= g_days[gm]; gm++) g_day_no -= g_days[gm];

                return [gy, gm + 1, g_day_no + 1];

            }



            function initializeDatepickers() {

                if (typeof jalaliDatepicker !== 'undefined') {

                    jalaliDatepicker.startWatch({ time: false });

                }

                document.querySelectorAll("input[data-jdp]").forEach(function (input) {

                    var clone = input.cloneNode(true);

                    input.parentNode.replaceChild(clone, input);

                    clone.addEventListener("change", function () {

                        var id = clone.id;

                        var faDate = clone.value;

                        if (!faDate) return;

                        var parts = faDate.split('/').map(Number);

                        var gygm = jalali_to_gregorian(parts[0], parts[1], parts[2]);

                        var iso = gygm[0] + '-' + String(gygm[1]).padStart(2, '0') + '-' + String(gygm[2]).padStart(2, '0');

                        if (id === "fromFa") document.getElementById("fromIso").value = iso;

                        else if (id === "toFa") document.getElementById("toIso").value = iso;

                    });

                });

            }



            function getFormQuery(form) {

                var data = new FormData(form), params = new URLSearchParams();

                for (var pair of data.entries()) if (String(pair[1]).trim() !== "") params.append(pair[0], pair[1]);

                return params.toString();

            }



            async function loadOrders(url) {

                var res = await fetch(url, {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-Orders-Partial': 'true'
                    }
                });
                if (!res.ok) return;
                currentOrdersUrl = url;
                var html = await res.text();
                var doc = new DOMParser().parseFromString(html, 'text/html');
                doc.querySelectorAll('style, link[rel="stylesheet"], script[src]').forEach(function (node) {
                    node.remove();
                });
                ordersContainer.innerHTML = doc.body.innerHTML;

                ordersContainer.querySelectorAll('script:not([src])').forEach(function (oldScript) {
                    var code = oldScript.textContent || '';
                    oldScript.remove();
                    if (!code.trim()) return;
                    var script = document.createElement('script');
                    script.textContent = code;
                    document.body.appendChild(script);
                    script.remove();
                });

                setTimeout(initializeDatepickers, 100);

            }

            window.reloadManagerOrdersList = function () {
                loadOrders(currentOrdersUrl);
            };

            function isBlockingUiOpen() {
                var receipt = document.getElementById('receiptChargeModal');
                if (receipt && receipt.style.display && receipt.style.display !== 'none') {
                    return true;
                }
                if (typeof window.isManagerOrderEditOpen === 'function' && window.isManagerOrderEditOpen()) {
                    return true;
                }
                var editDrawer = document.getElementById('orderEditOffcanvas');
                if (editDrawer && editDrawer.classList.contains('show')) {
                    return true;
                }
                if (document.getElementById('moeNewCustomerModal')?.classList.contains('show')) {
                    return true;
                }
                if (document.getElementById('moeNewAddressModal')?.classList.contains('show')) {
                    return true;
                }
                return !!document.querySelector('.modal.show');
            }

            function scheduleOrdersReload() {
                if (window._managerOrderHubReloadTimer) {
                    clearTimeout(window._managerOrderHubReloadTimer);
                }
                window._managerOrderHubReloadTimer = setTimeout(function () {
                    window._managerOrderHubReloadTimer = null;
                    if (isBlockingUiOpen()) {
                        scheduleOrdersReload();
                        return;
                    }
                    loadOrders(currentOrdersUrl);
                }, 400);
            }

            function connectOrderHub() {
                if (!restaurantId || typeof signalR === 'undefined') return;

                var connection = new signalR.HubConnectionBuilder()
                    .withUrl('/orderHub?restaurantId=' + encodeURIComponent(restaurantId))
                    .withAutomaticReconnect()
                    .build();

                connection.on('ReceiveOrderUpdate', function () {
                    scheduleOrdersReload();
                });

                connection.start()
                    .then(function () {
                        return connection.invoke('JoinRestaurantGroup', String(restaurantId));
                    })
                    .catch(function () { /* keep page usable without live updates */ });

                window._managerOrderHub = connection;
                signal.addEventListener('abort', function () {
                    if (window._managerOrderHubReloadTimer) {
                        clearTimeout(window._managerOrderHubReloadTimer);
                        window._managerOrderHubReloadTimer = null;
                    }
                    try { connection.stop(); } catch (e) { /* ignore */ }
                    if (window._managerOrderHub === connection) {
                        window._managerOrderHub = null;
                    }
                });
            }



            function resetFilters() {

                filterForm.querySelector('[name="statusId"]').value = '0';

                filterForm.querySelector('[name="search"]').value = '';

                filterForm.querySelector('[name="pageSize"]').value = '20';

                document.getElementById('fromIso').value = '';

                document.getElementById('toIso').value = '';

                var fromFa = document.getElementById('fromFa');

                var toFa = document.getElementById('toFa');

                if (fromFa) fromFa.value = '';

                if (toFa) toFa.value = '';

                document.querySelectorAll('.quick-filter-btn').forEach(function (btn) {

                    btn.classList.remove('active');

                });

                loadOrders(filterForm.action + '?page=1&pageSize=20');

                if (typeof showToast === 'function') {

                    showToast('فیلترها بازنشانی شدند', 'info');

                }

            }



            filterForm.addEventListener('submit', function (e) {

                e.preventDefault();

                var query = getFormQuery(filterForm);

                loadOrders(filterForm.action + '?' + query + '&page=1');

            }, { signal: signal });



            var resetBtn = document.getElementById('btnResetFilters');

            if (resetBtn) {

                resetBtn.addEventListener('click', function (e) {

                    e.preventDefault();

                    resetFilters();

                }, { signal: signal });

            }



            document.querySelectorAll('.quick-filter-btn').forEach(function (btn) {

                btn.addEventListener('click', function (e) {

                    e.preventDefault();

                    document.querySelectorAll('.quick-filter-btn').forEach(function (item) {

                        item.classList.remove('active');

                    });

                    btn.classList.add('active');

                    loadOrders(btn.href);

                }, { signal: signal });

            });



            ordersContainer.addEventListener('click', function (e) {

                var link = e.target.closest('.pagination a.page-link');

                if (link) {

                    e.preventDefault();

                    loadOrders(link.href);

                }

            }, { signal: signal });



            initializeDatepickers();

            connectOrderHub();

            if (typeof window.initManagerOrderEdit === 'function') {
                window.initManagerOrderEdit();
            }

        }

        function destroyManagerOrderListPage() {
            if (window._managerOrderListAbortController) {
                window._managerOrderListAbortController.abort();
                window._managerOrderListAbortController = null;
            }
            if (window._managerOrderHubReloadTimer) {
                clearTimeout(window._managerOrderHubReloadTimer);
                window._managerOrderHubReloadTimer = null;
            }
            if (window._managerOrderHub) {
                try { window._managerOrderHub.stop(); } catch (e) { /* ignore */ }
                window._managerOrderHub = null;
            }
            if (typeof window.destroyManagerOrderEdit === 'function') {
                window.destroyManagerOrderEdit();
            }
            window.reloadManagerOrdersList = null;
            setSupportChatFabVisible(true);
        }

        window.initManagerOrderListPage = initManagerOrderListPage;
        window.destroyManagerOrderListPage = destroyManagerOrderListPage;
        setSupportChatFabVisible(false);

    </script>

}


