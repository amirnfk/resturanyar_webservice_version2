@section Scripts {
    <script>
        function openSupportChat() {
            if (window.__rySupportChatInstance && typeof window.__rySupportChatInstance.open === 'function') {
                window.__rySupportChatInstance.open();
            }
        }
        function closeSupportChat() {
            if (window.__rySupportChatInstance && typeof window.__rySupportChatInstance.close === 'function') {
                window.__rySupportChatInstance.close();
            }
        }
        function toggleSupportChat() {
            if (!window.__rySupportChatInstance) return;
            var p = window.__rySupportChatInstance.panel;
            if (p && p.classList.contains('is-open')) window.__rySupportChatInstance.minimize();
            else window.__rySupportChatInstance.open();
        }

        document.addEventListener('DOMContentLoaded', function () {
            var openChat = document.getElementById('open_chat');
            var closeChat = document.getElementById('close_chat');
            var toggleChat = document.getElementById('toggle_chat');
            if (openChat) openChat.addEventListener('click', openSupportChat);
            if (closeChat) closeChat.addEventListener('click', closeSupportChat);
            if (toggleChat) toggleChat.addEventListener('click', toggleSupportChat);
        });
    </script>
}