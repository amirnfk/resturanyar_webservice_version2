@model List<FoodItemViewModel>
@{
    ViewData["Title"] = "لیست آیتم ها";
    var placeholder = Url.Content("~/images/food_placeholder.jpg");
}

@section Styles {
    <link rel="stylesheet" href="~/css/food-list.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/inventory.css" asp-append-version="true" />
}

<div class="container food-page mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <button class="btn btn-primary" onclick="openAddModal()">افزودن غذا</button>
    </div>

    <!-- Filters -->
    <div class="food-toolbar mb-3">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <input id="searchBox" type="text" class="form-control form-control-sm" placeholder="جستجو در نام و توضیحات..." />
            </div>
            <div class="col-6 col-md-3">
                <select id="filterCategory" class="form-select form-select-sm">
                    <option value="">همه دسته‌ها</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select id="filterAvailability" class="form-select form-select-sm">
                    <option value="">همه وضعیت‌ها</option>
                    <option value="true">موجود</option>
                    <option value="false">ناموجود</option>
                </select>
            </div>
            <div class="col-12 col-md-3">
                <select id="sortBy" class="form-select form-select-sm">
                    <option value="newest">جدیدترین</option>
                    <option value="name-asc">نام (الف تا ی)</option>
                    <option value="name-desc">نام (ی تا الف)</option>
                    <option value="price-asc">قیمت (کم به زیاد)</option>
                    <option value="price-desc">قیمت (زیاد به کم)</option>
                    <option value="discount-desc">بیشترین تخفیف</option>
                </select>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">غذایی برای نمایش وجود ندارد.</div>
    }
    else
    {
        <div class="row" id="foodList">
            @foreach (var item in Model)
            {
                var hasDiscount = item.DiscountPrice > 0 && item.DiscountPrice != item.Price;
                var discountPercent = hasDiscount ? (int)Math.Round(((item.Price - item.DiscountPrice) / item.Price) * 100) : 0;
                var unavailableClass = item.IsAvailable ? "" : "is-unavailable";
                <div class="col-6 col-md-4 col-lg-3 mb-3"
                     data-id="@item.FoodItemId"
                     data-name="@item.Name"
                     data-description="@item.Description"
                     data-category="@item.CategoryId"
                     data-categoryname="@item.CategoryName"
                     data-price="@item.Price.ToString("0")"
                     data-discount="@((hasDiscount ? item.Price - item.DiscountPrice : 0).ToString("0"))"
                     data-discountpercent="@discountPercent"
                     data-isavailable="@item.IsAvailable"
                     data-image="@(item.ImageUrl ?? "")">
                    <div class="food-card h-100 @unavailableClass">
                        <div class="food-img-wrap">
                            <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? placeholder : item.ImageUrl)"
                                 class="food-img"
                                 alt="تصویر @item.Name"
                                 loading="lazy"
                                 onerror="this.onerror=null; this.src='@placeholder';" />
                            @if (hasDiscount)
                            {
                                <span class="ribbon">@discountPercent% <span style="font-size: 9px;">تخفیف</span></span>
                            }
                        </div>
                        <div class="food-body">
                            <h5 class="food-title">@item.Name</h5>
                            <p class="food-desc">@item.Description</p>
                            <div class="mb-2">
                                <span class="chip">دسته: @item.CategoryName</span>
                                @if (!item.IsAvailable)
                                {
                                    <span class="badge bg-danger badge-availability">ناموجود</span>
                                }
                                else
                                {
                                    <span class="badge bg-success badge-availability">موجود</span>
                                }
                            </div>
                            <div class="price-area">
                                @if (hasDiscount)
                                {
                                    <span class="price-old">@item.Price.ToString("N0") تومان</span>
                                    <span class="price-new">@item.DiscountPrice.ToString("N0") تومان</span>
                                }
                                else
                                {
                                    <span class="price-new no-discount">@item.Price.ToString("N0") تومان</span>
                                }
                            </div>
                        </div>
                        <div class="food-footer">
                            <button class="btn btn-outline-info btn-sm" type="button"
                                    data-food-id="@item.FoodItemId"
                                    data-food-name="@item.Name"
                                    onclick="openRecipeModal(this)">دستور تهیه</button>
                            <button class="btn btn-warning btn-sm" onclick="openEditModal(@item.FoodItemId)">ویرایش</button>
                            <button class="btn btn-danger btn-sm" onclick="deleteFood(@item.FoodItemId)">حذف</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal -->
<div class="modal fade" id="foodModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div id="errorContainer" class="alert alert-danger d-none m-3"></div>
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">افزودن غذا</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="foodForm" enctype="multipart/form-data">
                    <input type="hidden" id="foodId" name="foodId" />
                    <div class="row g-3">
                        <div class="col-md-7">
                            <div class="mb-3">
                                <label class="form-label">نام غذا <span class="text-danger">*</span></label>
                                <input type="text" id="name" name="name" class="form-control" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">توضیحات</label>
                                <textarea id="description" name="description" class="form-control" rows="3"></textarea>
                            </div>
                            <div class="mb-3">
                                <label for="category" class="form-label">دسته‌بندی <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <select class="form-select" id="category" name="category" required></select>
                                    <button type="button" id="btnAddCategoryModal" class="btn btn-outline-primary">+ افزودن</button>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label">قیمت <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <input type="text" id="price" name="price" class="form-control price-input" inputmode="numeric" dir="ltr" required autocomplete="off" placeholder="مثلاً ۱۵۰٬۰۰۰" />
                                        <span class="input-group-text food-currency">تومان</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">قیمت با تخفیف</label>
                                    <div class="input-group">
                                        <input type="text" id="discountPrice" name="discountPrice" class="form-control price-input" inputmode="numeric" dir="ltr" autocomplete="off" placeholder="مثلاً ۱۲۰٬۰۰۰" />
                                        <span class="input-group-text food-currency">تومان</span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-check mt-3">
                                <input type="checkbox" id="isAvailable" name="isAvailable" class="form-check-input" checked />
                                <label class="form-check-label" for="isAvailable">موجود</label>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">عکس</label>
                            <input type="file" id="image" name="image" class="form-control mb-2" accept="image/*" />
                            <div class="food-image-preview-wrap">
                                <img id="imgPreview" class="img-preview" src="@placeholder" alt="پیش‌نمایش تصویر" />
                                <button type="button" id="btnRemoveImage" class="btn btn-sm btn-danger food-image-remove-btn d-none" title="حذف تصویر">
                                    <i class="fas fa-trash-alt ms-1"></i> حذف تصویر
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button id="btnSaveFood" class="btn btn-primary" onclick="saveFood()">ذخیره</button>
            </div>
        </div>
    </div>
</div>

<!-- Recipe modal -->
<div class="modal fade inventory-modal" id="recipeModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">دستور تهیه: <span id="recipeFoodName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="recipeFoodId" />
                <div id="recipeError" class="alert alert-danger d-none"></div>
                <div id="recipeDisabledHint" class="alert alert-warning d-none">
                    برای تعریف دستور تهیه، ابتدا ماژول <a href="@Url.Action("Inventory", "Home")">انبار</a> را فعال کنید و مواد اولیه را بسازید.
                </div>
                <div id="recipeEditor">
                    <p class="text-muted small">مقدار هر ماده برای <strong>یک واحد</strong> از این غذا — واحد ورود می‌تواند با واحد پایه انبار فرق کند (مثلاً گرم به‌جای کیلو).</p>
                    <div id="recipeLines" class="d-flex flex-column gap-2 mb-3"></div>
                    <button type="button" class="btn btn-outline-primary btn-sm" id="btnAddRecipeLine">+ افزودن ماده</button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" id="btnDeleteRecipe">حذف دستور</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" id="btnSaveRecipe">ذخیره</button>
            </div>
        </div>
    </div>
</div>

<script>
    var restaurantId = @(ViewBag.RestaurantId ?? 0);
    var API_BASE = "/api/v2/UserApi";
    var INV_API = "/api/v2/inventory";
    var inventoryItemsCache = null;
    var inventoryUnitsCache = null;
    var foodsWithRecipe = new Set();
    var compressedImageFile = null;
    var removeImageFlag = false;
    var foodImagePlaceholder = "@placeholder";

    function isFoodPlaceholderImage(src) {
        if (!src) return true;
        return src.indexOf("food_placeholder") !== -1;
    }

    function updateImageControls() {
        var src = document.getElementById("imgPreview")?.src || "";
        var showRemove = !isFoodPlaceholderImage(src);
        $("#btnRemoveImage").toggleClass("d-none", !showRemove);
    }

    function resetFoodImageState() {
        compressedImageFile = null;
        removeImageFlag = false;
        var input = document.getElementById("image");
        if (input) input.value = "";
        $("#imgPreview").attr("src", foodImagePlaceholder);
        updateImageControls();
    }

    async function removeFoodImage() {
        if (!(await showConfirm({ message: "آیا از حذف تصویر مطمئن هستید؟" }))) return;
        removeImageFlag = true;
        compressedImageFile = null;
        var input = document.getElementById("image");
        if (input) input.value = "";
        $("#imgPreview").attr("src", foodImagePlaceholder);
        updateImageControls();
    }

    function normalizePriceDigits(value) {
        var persian = "۰۱۲۳۴۵۶۷۸۹";
        var arabic = "٠١٢٣٤٥٦٧٨٩";
        return String(value || "")
            .replace(/[۰-۹]/g, function (d) { return String(persian.indexOf(d)); })
            .replace(/[٠-٩]/g, function (d) { return String(arabic.indexOf(d)); })
            .replace(/[^\d]/g, "");
    }

    function formatPriceDigits(digits) {
        if (!digits) return "";
        return digits.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    }

    function parsePriceInput(value) {
        var digits = normalizePriceDigits(value);
        if (!digits) return NaN;
        return parseInt(digits, 10);
    }

    function formatPriceInput(value) {
        var digits = typeof value === "number"
            ? String(Math.max(0, Math.round(value)))
            : normalizePriceDigits(value);
        return formatPriceDigits(digits);
    }

    function getPriceCursorAfterDigits(formatted, digitCount) {
        if (!formatted) return 0;
        if (digitCount <= 0) return 0;
        var seen = 0;
        for (var i = 0; i < formatted.length; i++) {
            if (/\d/.test(formatted[i])) {
                seen++;
                if (seen >= digitCount) return i + 1;
            }
        }
        return formatted.length;
    }

    function handlePriceInput(input) {
        if (!input) return;
        var cursor = input.selectionStart || 0;
        var digitsBeforeCursor = normalizePriceDigits(input.value.slice(0, cursor)).length;
        var digits = normalizePriceDigits(input.value);
        if (digits.length > 12) digits = digits.slice(0, 12);

        var formatted = formatPriceDigits(digits);
        input.value = formatted;

        var newCursor = getPriceCursorAfterDigits(formatted, digitsBeforeCursor);
        if (typeof input.setSelectionRange === "function") {
            input.setSelectionRange(newCursor, newCursor);
        }
    }

    function setPriceInput(selector, value) {
        // Avoid treating decimal scale (e.g. "150000.00") as extra digits.
        var num;
        if (typeof value === "number" && isFinite(value)) {
            num = Math.round(value);
        } else {
            var raw = String(value == null ? "" : value).trim();
            raw = raw.replace(/[./٫].*$/, "");
            num = parsePriceInput(raw);
        }
        $(selector).val(isNaN(num) || num <= 0 ? "" : formatPriceDigits(String(Math.round(num))));
    }

    function onFoodImageChange() {
        const input = document.getElementById("image");
        if (!input) return;
        if (input.files && input.files[0]) {
            removeImageFlag = false;
            compressImage(input.files[0], 800, 800, 0.8).then(function (file) {
                compressedImageFile = file;
                document.getElementById("imgPreview").src = URL.createObjectURL(compressedImageFile);
                updateImageControls();
            }).catch(function () {
                compressedImageFile = input.files[0];
                document.getElementById("imgPreview").src = URL.createObjectURL(input.files[0]);
                updateImageControls();
            });
        } else if (!removeImageFlag) {
            resetFoodImageState();
        }
    }

    // -----------------------------------------------------------------
    // Helper: show / clear validation errors
    function showErrors(errors) {
        const c = document.getElementById("errorContainer");
        if (!c) return;
        c.innerHTML = '<strong>لطفاً خطاهای زیر را برطرف کنید:</strong>' +
            errors.map(e => `<div>• ${e}</div>`).join("");
        c.classList.remove("d-none");
        c.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function clearErrors() {
        const c = document.getElementById("errorContainer");
        if (c) { c.classList.add("d-none"); c.innerHTML = ""; }
    }

    // -----------------------------------------------------------------
    // Image compression (unchanged)
    function compressImage(file, maxW, maxH, q) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = e => {
                const img = new Image();
                img.onload = () => {
                    let w = img.width, h = img.height;
                    if (w > maxW || h > maxH) {
                        const r = Math.min(maxW / w, maxH / h);
                        w *= r; h *= r;
                    }
                    const c = document.createElement("canvas");
                    c.width = w; c.height = h;
                    const ctx = c.getContext("2d");
                    ctx.drawImage(img, 0, 0, w, h);
                    c.toBlob(b => b ? resolve(new File([b], file.name, { type: "image/jpeg" })) : reject(new Error("blob error")), "image/jpeg", q);
                };
                img.onerror = reject;
                img.src = e.target.result;
            };
            reader.onerror = reject;
            reader.readAsDataURL(file);
        });
    }

    // -----------------------------------------------------------------
    // SAVE (Add / Update)
    async function saveFood() {
        clearErrors();
        if (restaurantId === 0) {
            showErrors(["شناسه رستوران پیدا نشد."]);
            return;
        }

        const id = $("#foodId").val();
        const name = $("#name").val().trim();
        const categoryId = parseInt($("#category").val());
        const price = parsePriceInput($("#price").val());
        const discountVal = $("#discountPrice").val();
        const discountPrice = discountVal ? parsePriceInput(discountVal) : null;
        const isAvailable = $("#isAvailable").prop("checked");

        // Validation
        let errors = [];
        if (!name) errors.push("نام غذا الزامی است.");
        else if (name.length < 2) errors.push("نام غذا باید حداقل ۲ کاراکتر باشد.");
        if (isNaN(categoryId) || categoryId <= 0) errors.push("لطفاً یک دسته‌بندی معتبر انتخاب کنید.");
        if (isNaN(price) || price <= 0) errors.push("قیمت باید عددی بزرگ‌تر از صفر باشد.");
        if (discountPrice !== null) {
            if (isNaN(discountPrice)) errors.push("قیمت تخفیف باید عددی معتبر باشد.");
            else if (discountPrice >= price) errors.push("قیمت تخفیف باید کمتر از قیمت اصلی باشد.");
        }
        if (errors.length) { showErrors(errors); return; }

        const fd = new FormData();
        fd.append("RestaurantId", restaurantId);
        fd.append("Name", name);
        fd.append("Description", $("#description").val());
        fd.append("CategoryId", categoryId);
        fd.append("Price", price);
        fd.append("DiscountPrice", discountPrice || 0);
        fd.append("IsAvailable", isAvailable);
        if (compressedImageFile) fd.append("Image", compressedImageFile);
        if (id && removeImageFlag && !compressedImageFile) fd.append("RemoveImage", 2);

        let url = `${API_BASE}/addfood`;
        let method = "POST";
        if (id) {
            url = `${API_BASE}/updatefood/${id}`;
            method = "PUT";
        }

        const btn = $("#btnSaveFood"), orig = btn.html();
        btn.html('<span class="spinner-border spinner-border-sm me-1"></span> در حال ذخیره...').prop('disabled', true);

        try {
            const response = await window.fetchWithAuth(url, {
                method: method,
                body: fd,
                // Do NOT set Content-Type – browser sets it for FormData
            });
            const res = await response.json();
            btn.html(orig).prop('disabled', false);
            showToast(res.message || 'عملیات با موفقیت انجام شد', res.success ? 'success' : 'error');
            if (res.success) {
                $('#foodModal').modal('hide');
                setTimeout(() => location.reload(), 500);
            }
        } catch (error) {
            btn.html(orig).prop('disabled', false);
            showToast('خطا در ذخیره غذا: ' + (error.message || 'مشکل در ارتباط با سرور'), 'error');
        }
    }

    // -----------------------------------------------------------------
    // DELETE
    async function deleteFood(id) {
        if (!(await showConfirm({ message: 'آیا از حذف این غذا مطمئن هستید؟' }))) return;
        try {
            const response = await window.fetchWithAuth(`${API_BASE}/deleteFood/${id}`, {
                method: "DELETE"
            });
            const res = await response.json();
            showToast(res.message || 'عملیات با موفقیت انجام شد', res.success ? 'success' : 'error');
            if (res.success) {
                const card = $(`[data-id='${id}']`);
                card.fadeOut(200, function () {
                    $(this).remove();
                    if (!$("#foodList [data-id]").length) {
                        $("#foodList").html('<div class="col-12"><div class="alert alert-warning text-center">غذایی برای نمایش وجود ندارد.</div></div>');
                    }
                });
            }
        } catch (error) {
            showToast('خطا در حذف غذا: ' + (error.message || 'مشکل در ارتباط با سرور'), 'error');
        }
    }

    // -----------------------------------------------------------------
    // LOAD CATEGORIES into modal dropdown
    async function loadCategoriesIntoModal(selectedCategoryId = "", cb) {
        try {
            const response = await window.fetchWithAuth(`${API_BASE}/getcategoriesbyrestaurant/${restaurantId}`);
            const data = await response.json();
            const select = $("#category");
            select.empty().append('<option value="">-- انتخاب دسته‌بندی --</option>');
            (data.categories || []).forEach(cat => {
                select.append(`<option value="${cat.categoryId}">${cat.categoryName}</option>`);
            });
            if (selectedCategoryId) select.val(String(selectedCategoryId));
            if (typeof cb === "function") cb();
        } catch (error) {
            showToast('خطا در بارگذاری دسته\u200cبندی\u200cها: ' + (error.message || 'مشکل در ارتباط با سرور'), 'error');
            if (typeof cb === "function") cb();
        }
    }

    // -----------------------------------------------------------------
    // OPEN ADD MODAL
    function openAddModal() {
        $("#modalTitle").text("افزودن غذا");
        $("#foodForm")[0].reset();
        $("#foodId").val("");
        resetFoodImageState();
        clearErrors();
        loadCategoriesIntoModal("", function () {
            new bootstrap.Modal(document.getElementById("foodModal")).show();
            setTimeout(() => $("#name").trigger("focus"), 200);
        });
    }

    // -----------------------------------------------------------------
    // OPEN EDIT MODAL
    function openEditModal(id) {
        const card = $(`[data-id='${id}']`);
        if (!card.length) { showToast('غذا پیدا نشد!', 'error'); return; }

        $("#modalTitle").text("ویرایش غذا");
        $("#foodId").val(id);
        $("#name").val(card.data("name") || "");
        $("#description").val(card.data("description") || "");
        // Use attr() so values stay exact strings (avoids jQuery .data() coercion quirks).
        setPriceInput("#price", card.attr("data-price"));
        const discount = parseInt(card.attr("data-discount"), 10) || 0;
        const price = parseInt(card.attr("data-price"), 10) || 0;
        setPriceInput("#discountPrice", discount ? price - discount : 0);
        $("#isAvailable").prop("checked",
            card.data("isavailable") === true ||
            card.data("isavailable") === "True" ||
            card.data("isavailable") === "true"
        );
        const img = card.data("image");
        removeImageFlag = false;
        compressedImageFile = null;
        document.getElementById("image").value = "";
        $("#imgPreview").attr("src", img ? img : foodImagePlaceholder);
        updateImageControls();
        clearErrors();

        loadCategoriesIntoModal(card.data("category"), function () {
            new bootstrap.Modal(document.getElementById("foodModal")).show();
        });
    }

    // -----------------------------------------------------------------
    // ADD CATEGORY (via modal button)
    async function addCategory(name) {
        try {
            const response = await window.fetchWithAuth(`${API_BASE}/addcategory`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ restaurantId: restaurantId, categoryName: name })
            });
            const data = await response.json();
            if (data.success) {
                const id = data.category_id || data.categoryId;
                $("#category").append(`<option value="${id}" selected>${name}</option>`);
                showToast(data.message || 'دسته\u200cبندی با موفقیت اضافه شد', 'success');
            } else {
                showToast('خطا: ' + (data.message || 'نامشخص'), 'error');
            }
        } catch (error) {
            showToast('خطا در افزودن دسته\u200cبندی: ' + (error.message || 'مشکل در ارتباط با سرور'), 'error');
        }
    }

    // -----------------------------------------------------------------
    // POPULATE FILTER CATEGORIES (dropdown in toolbar)
    async function populateFilterCategories() {
        try {
            const response = await window.fetchWithAuth(`${API_BASE}/getcategoriesbyrestaurant/${restaurantId}`);
            const data = await response.json();
            const select = $("#filterCategory");
            (data.categories || []).forEach(c => {
                select.append(`<option value="${c.categoryId}">${c.categoryName}</option>`);
            });
        } catch (error) {
            // fallback: read from DOM
            const seen = new Set();
            $("#foodList [data-id]").each(function () {
                const id = String($(this).data("category"));
                const name = $(this).data("categoryname");
                if (id && !seen.has(id)) {
                    $("#filterCategory").append(`<option value="${id}">${name}</option>`);
                    seen.add(id);
                }
            });
        }
    }

    // -----------------------------------------------------------------
    // FILTER & SORT
    function applyFilters() {
        const q = $("#searchBox").val().trim().toLowerCase();
        const cat = $("#filterCategory").val();
        const avail = $("#filterAvailability").val();
        const sort = $("#sortBy").val();
        const cards = $("#foodList > [data-id]").toArray();

        cards.forEach(function (el) {
            const $el = $(el);
            const name = ($el.data("name") || "").toString().toLowerCase();
            const desc = ($el.data("description") || "").toString().toLowerCase();
            const category = String($el.data("category") || "");
            const isAvailable = String($el.data("isavailable")).toLowerCase();
            let ok = true;
            if (q && !(name.includes(q) || desc.includes(q))) ok = false;
            if (cat && category !== String(cat)) ok = false;
            if (avail && isAvailable !== String(avail)) ok = false;
            $el.toggle(ok);
        });

        const visible = $("#foodList > [data-id]:visible").toArray();
        visible.sort(function (a, b) {
            const $a = $(a), $b = $(b);
            const nameA = ($a.data("name") || "").toString();
            const nameB = ($b.data("name") || "").toString();
            const priceA = parseInt($a.data("price") || 0);
            const priceB = parseInt($b.data("price") || 0);
            const discA = parseInt($a.data("discount") || 0);
            const discB = parseInt($b.data("discount") || 0);
            switch (sort) {
                case "name-asc": return nameA.localeCompare(nameB, 'fa');
                case "name-desc": return nameB.localeCompare(nameA, 'fa');
                case "price-asc": return priceA - priceB;
                case "price-desc": return priceB - priceA;
                case "discount-desc": return discB - discA;
                default: return 0;
            }
        });
        const container = $("#foodList");
        visible.forEach(el => container.append(el));
    }

    // -----------------------------------------------------------------
    // RECIPE (inventory BOM)
    function showRecipeError(msg) {
        const el = document.getElementById('recipeError');
        el.textContent = msg;
        el.classList.remove('d-none');
    }

    function clearRecipeError() {
        const el = document.getElementById('recipeError');
        el.classList.add('d-none');
        el.textContent = '';
    }

    async function invApi(url, options) {
        const res = await window.fetchWithAuth(url, Object.assign({
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
        }, options || {}));
        const json = await res.json().catch(() => ({}));
        if (!res.ok || json.success === false) {
            throw new Error(json.message || 'خطا در ارتباط با انبار');
        }
        return json;
    }

    async function loadInventoryItemsForRecipe() {
        if (inventoryItemsCache) return inventoryItemsCache;
        const res = await invApi(`${INV_API}/items?restaurantId=${restaurantId}`);
        inventoryItemsCache = res.data || [];
        return inventoryItemsCache;
    }

    async function loadInventoryUnits() {
        if (inventoryUnitsCache) return inventoryUnitsCache;
        const res = await invApi(`${INV_API}/units`);
        inventoryUnitsCache = res.data || [];
        return inventoryUnitsCache;
    }

    function recipeItemOptions(selectedId) {
        const items = inventoryItemsCache || [];
        return items.map(i =>
            `<option value="${i.inventoryItemId}" ${String(i.inventoryItemId) === String(selectedId) ? 'selected' : ''}>${i.name} (${i.unit})</option>`
        ).join('');
    }

    function unitLabel(u) {
        return `${u.nameFa || u.code} (${u.code})`;
    }

    function compatibleUnitsForItem(item) {
        const all = inventoryUnitsCache || [];
        if (!item) return all;
        return all.filter(u => {
            if (u.unitId === item.baseUnitId) return true;
            if (u.dimension !== (all.find(x => x.unitId === item.baseUnitId)?.dimension)) return false;
            const base = all.find(x => x.unitId === item.baseUnitId);
            if (!base) return false;
            if (!u.allowsCrossUnitConversion || !base.allowsCrossUnitConversion) return false;
            return true;
        });
    }

    function recipeUnitOptions(item, selectedUnitId) {
        const list = compatibleUnitsForItem(item);
        const sel = selectedUnitId || item?.baseUnitId;
        return list.map(u =>
            `<option value="${u.unitId}" ${String(u.unitId) === String(sel) ? 'selected' : ''}>${unitLabel(u)}</option>`
        ).join('');
    }

    function updateRecipeLineHint(row) {
        const hint = row.querySelector('.recipe-hint');
        if (!hint) return;
        const itemId = Number(row.querySelector('.recipe-item').value);
        const unitId = Number(row.querySelector('.recipe-unit').value);
        const qty = Number(row.querySelector('.recipe-qty').value);
        const item = (inventoryItemsCache || []).find(i => i.inventoryItemId === itemId);
        const all = inventoryUnitsCache || [];
        const entry = all.find(u => u.unitId === unitId);
        const base = item ? all.find(u => u.unitId === item.baseUnitId) : null;
        if (!entry || !base || !(qty > 0) || entry.unitId === base.unitId) {
            hint.textContent = base ? `واحد پایه: ${base.code}` : '';
            return;
        }
        if (entry.dimension !== base.dimension || !entry.allowsCrossUnitConversion || !base.allowsCrossUnitConversion) {
            hint.textContent = '';
            return;
        }
        const inBase = qty * (entry.toDimensionBaseFactor / base.toDimensionBaseFactor);
        hint.textContent = `= ${Number(inBase).toLocaleString('fa-IR', { maximumFractionDigits: 3 })} ${base.code}`;
    }

    function bindRecipeLineEvents(row) {
        const itemSel = row.querySelector('.recipe-item');
        const unitSel = row.querySelector('.recipe-unit');
        const qtyInput = row.querySelector('.recipe-qty');

        itemSel.addEventListener('change', () => {
            const item = (inventoryItemsCache || []).find(i => i.inventoryItemId === Number(itemSel.value));
            unitSel.innerHTML = recipeUnitOptions(item, item?.baseUnitId);
            updateRecipeLineHint(row);
        });
        unitSel.addEventListener('change', () => updateRecipeLineHint(row));
        qtyInput.addEventListener('input', () => updateRecipeLineHint(row));
    }

    function addRecipeLineRow(line) {
        const wrap = document.getElementById('recipeLines');
        const row = document.createElement('div');
        row.className = 'recipe-line border-bottom pb-2';
        const item = (inventoryItemsCache || []).find(i => i.inventoryItemId === line?.inventoryItemId)
            || (inventoryItemsCache || [])[0];
        const unitId = line?.unitId || item?.baseUnitId;
        row.innerHTML = `
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <select class="form-select form-select-sm recipe-item">${recipeItemOptions(line?.inventoryItemId || item?.inventoryItemId)}</select>
                </div>
                <div class="col-md-3">
                    <input type="number" class="form-control form-control-sm recipe-qty" min="0.001" step="0.001" value="${line?.quantity ?? ''}" placeholder="مقدار" />
                </div>
                <div class="col-md-2">
                    <select class="form-select form-select-sm recipe-unit">${recipeUnitOptions(item, unitId)}</select>
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-outline-danger btn-sm w-100" onclick="this.closest('.recipe-line').remove()">حذف</button>
                </div>
            </div>
            <div class="form-text recipe-hint small"></div>`;
        wrap.appendChild(row);
        bindRecipeLineEvents(row);
        updateRecipeLineHint(row);
    }

    window.openRecipeModal = async function (btn) {
        clearRecipeError();
        const foodId = btn.getAttribute('data-food-id');
        const foodName = btn.getAttribute('data-food-name') || '';
        document.getElementById('recipeFoodId').value = foodId;
        document.getElementById('recipeFoodName').textContent = foodName;
        document.getElementById('recipeLines').innerHTML = '';
        document.getElementById('recipeDisabledHint').classList.add('d-none');
        document.getElementById('recipeEditor').classList.remove('d-none');
        document.getElementById('btnSaveRecipe').disabled = false;
        document.getElementById('btnDeleteRecipe').disabled = false;

        const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('recipeModal'));
        modal.show();

        try {
            const settings = await invApi(`${INV_API}/settings?restaurantId=${restaurantId}`);
            if (!settings.data?.isEnabled) {
                document.getElementById('recipeDisabledHint').classList.remove('d-none');
                document.getElementById('recipeEditor').classList.add('d-none');
                document.getElementById('btnSaveRecipe').disabled = true;
                document.getElementById('btnDeleteRecipe').disabled = true;
                return;
            }

            inventoryItemsCache = null;
            inventoryUnitsCache = null;
            await Promise.all([loadInventoryItemsForRecipe(), loadInventoryUnits()]);
            if (!inventoryItemsCache.length) {
                showRecipeError('ابتدا از صفحه انبار حداقل یک ماده اولیه بسازید.');
                return;
            }

            const recipe = await invApi(`${INV_API}/foods/${foodId}/recipe?restaurantId=${restaurantId}`);
            const lines = recipe.data?.lines || [];
            if (lines.length) {
                lines.forEach(l => addRecipeLineRow(l));
            } else {
                addRecipeLineRow(null);
            }
        } catch (e) {
            showRecipeError(e.message);
        }
    };

    document.getElementById('btnAddRecipeLine')?.addEventListener('click', () => addRecipeLineRow(null));

    document.getElementById('btnSaveRecipe')?.addEventListener('click', async () => {
        clearRecipeError();
        const foodId = document.getElementById('recipeFoodId').value;
        const lines = [];
        document.querySelectorAll('#recipeLines .recipe-line').forEach(row => {
            const inventoryItemId = Number(row.querySelector('.recipe-item').value);
            const quantity = Number(row.querySelector('.recipe-qty').value);
            const unitId = Number(row.querySelector('.recipe-unit').value);
            if (inventoryItemId && quantity > 0 && unitId > 0) {
                lines.push({ inventoryItemId, quantity, unitId });
            }
        });
        if (!lines.length) {
            showRecipeError('حداقل یک ماده با مقدار و واحد معتبر وارد کنید.');
            return;
        }
        try {
            await invApi(`${INV_API}/foods/${foodId}/recipe`, {
                method: 'PUT',
                body: JSON.stringify({ restaurantId, lines })
            });
            foodsWithRecipe.add(Number(foodId));
            markFoodsWithRecipe();
            bootstrap.Modal.getInstance(document.getElementById('recipeModal'))?.hide();
            if (typeof showToast === 'function') showToast('دستور تهیه ذخیره شد.');
        } catch (e) {
            showRecipeError(e.message);
        }
    });

    document.getElementById('btnDeleteRecipe')?.addEventListener('click', async () => {
        const ok = typeof showConfirm === 'function'
            ? await showConfirm({
                title: 'حذف دستور تهیه',
                message: 'دستور تهیه این غذا حذف شود؟',
                confirmText: 'بله، حذف شود',
                cancelText: 'انصراف',
                iconClass: 'fa-solid fa-trash',
                variant: 'danger'
            })
            : window.confirm('دستور تهیه این غذا حذف شود؟');
        if (!ok) return;
        const foodId = document.getElementById('recipeFoodId').value;
        try {
            await invApi(`${INV_API}/foods/${foodId}/recipe?restaurantId=${restaurantId}`, { method: 'DELETE' });
            foodsWithRecipe.delete(Number(foodId));
            markFoodsWithRecipe();
            bootstrap.Modal.getInstance(document.getElementById('recipeModal'))?.hide();
        } catch (e) {
            showRecipeError(e.message);
        }
    });

    function markFoodsWithRecipe() {
        document.querySelectorAll('[data-food-id]').forEach(btn => {
            if (!btn.classList.contains('btn-outline-info')) return;
            const id = Number(btn.getAttribute('data-food-id'));
            btn.classList.toggle('btn-info', foodsWithRecipe.has(id));
            btn.classList.toggle('btn-outline-info', !foodsWithRecipe.has(id));
        });
    }

    async function loadRecipeBadges() {
        try {
            const settings = await invApi(`${INV_API}/settings?restaurantId=${restaurantId}`);
            if (!settings.data?.isEnabled) return;
            const res = await invApi(`${INV_API}/foods-with-recipes?restaurantId=${restaurantId}`);
            foodsWithRecipe = new Set((res.data || []).map(Number));
            markFoodsWithRecipe();
        } catch (_) { /* inventory off or schema missing */ }
    }

    // -----------------------------------------------------------------
    // INITIALIZATION
    function initFoodListPage() {
        if (!document.getElementById('foodList')) return;

        resetFoodImageState();
        $("#filterCategory").find('option:not(:first)').remove();

        $("#image").off("change.foodList").on("change.foodList", onFoodImageChange);
        $("#btnRemoveImage").off("click.foodList").on("click.foodList", removeFoodImage);
        $("#price, #discountPrice")
            .off("input.foodList")
            .on("input.foodList", function () { handlePriceInput(this); });
        $("#btnAddCategoryModal").off("click.foodList").on("click.foodList", function () {
            const name = prompt("نام دسته‌بندی جدید را وارد کنید:");
            if (name && name.trim() !== "") addCategory(name.trim());
        });
        $("#searchBox, #filterCategory, #filterAvailability, #sortBy")
            .off("input.foodList change.foodList")
            .on("input.foodList change.foodList", applyFilters);

        populateFilterCategories();
        loadRecipeBadges();
    }

    window.initFoodListPage = initFoodListPage;
</script>