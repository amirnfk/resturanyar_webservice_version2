@model resturanyar.Models.ManagerReportViewModel
@{
    ViewData["Title"] = "گزارش‌های مدیریتی";
    string currentPeriod = Model?.Period?.ToLower() ?? (ViewData["CurrentPeriod"]?.ToString() ?? "");
    int filterStatusId = Model?.FilterStatusId ?? -1;
    string fromFaDate = ViewData["FromFaDate"]?.ToString() ?? "";
    string toFaDate = ViewData["ToFaDate"]?.ToString() ?? "";
    int topN = Model?.TopN ?? 8;

    if (ViewData["FilterStatusId"] != null) { filterStatusId = Convert.ToInt32(ViewData["FilterStatusId"]); }
    if (ViewData["TopN"] != null) { topN = Convert.ToInt32(ViewData["TopN"]); }
}

@section Styles {
    <link rel="stylesheet" href="~/css/jalalidatepicker.min.css" />
    <link rel="stylesheet" href="~/css/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/order-status-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/manager_report.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/manager_report_partial.css" asp-append-version="true" />
}

<div class="manager-reports-page">
<div id="exportLoadingOverlay" class="export-loading-overlay" aria-hidden="true">
    <div class="export-loading-content">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="export-loading-text mb-0">در حال آماده‌سازی گزارش...</p>
    </div>
</div>

<div class="filter-card p-4 mb-4 position-relative mr-reveal">
    <div class="filter-card__head">
        <div>
            <h1 class="filter-card__title">گزارش‌های مدیریتی</h1>
            <p class="filter-card__subtitle mb-0">فیلتر بازه و وضعیت را تنظیم کنید، سپس نتیجه را ببینید یا گزارش را دانلود کنید. همه مبالغ به تومان است.</p>
        </div>
        <div class="filter-card__ornament" aria-hidden="true">
            <i class="bi bi-bar-chart-line-fill"></i>
        </div>
    </div>

    <div class="loading-overlay">
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
    </div>

    <form id="reportFilterForm" class="row g-3 align-items-end" method="get" action="@Url.Action("ManagerReports","Home")">
        <div class="col-md-2 col-sm-6">
            <label class="form-label">وضعیت</label>
            <select name="statusId" class="form-select">
                <option value="-1" selected="@(filterStatusId == -1 ? "selected" : null)">همه</option>
                <option value="0" selected="@(filterStatusId == 0 ? "selected" : null)">فعال‌ها</option>
                @if (Model?.StatusMap != null)
                {
                    foreach (var kv in Model.StatusMap)
                    {
                        <option value="@kv.Key" selected="@(filterStatusId == kv.Key ? "selected" : null)">@kv.Value</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-2 col-sm-6">
            <label class="form-label">از تاریخ</label>
            <input data-jdp id="fromFa" class="form-control bg-white" placeholder="انتخاب کنید" value="@(Model?.IsCustomRange == true ? fromFaDate : "")" readonly />
            <input type="hidden" name="from" id="fromIso" value="@(Model?.IsCustomRange == true ? Model?.FromDate?.ToString("yyyy-MM-dd") ?? "" : "")" />
        </div>

        <div class="col-md-2 col-sm-6">
            <label class="form-label">تا تاریخ</label>
            <input data-jdp id="toFa" class="form-control bg-white" placeholder="انتخاب کنید" value="@(Model?.IsCustomRange == true ? toFaDate : "")" readonly />
            <input type="hidden" name="to" id="toIso" value="@(Model?.IsCustomRange == true ? Model?.ToDate?.Date.ToString("yyyy-MM-dd") ?? "" : "")" />
        </div>

        <div class="col-md-2 col-sm-6">
            <label class="form-label">تعداد آیتم‌های برتر</label>
            <select name="topN" class="form-select">
                <option value="5" selected="@(topN == 5 ? "selected" : null)">5</option>
                <option value="8" selected="@(topN == 8 ? "selected" : null)">8</option>
                <option value="10" selected="@(topN == 10 ? "selected" : null)">10</option>
                <option value="15" selected="@(topN == 15 ? "selected" : null)">15</option>
            </select>
        </div>

        <div class="col-md-2 col-sm-6">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-funnel me-1"></i>
                اعمال
            </button>
        </div>

        <div class="col-md-2 col-sm-6">
            <button type="button" id="exportBtn" class="btn btn-success w-100">
                <i class="bi bi-download me-1"></i>
                دانلود گزارش
            </button>
        </div>

        <input type="hidden" name="period" id="periodInput" value="@(Model?.Period ?? "")" />

        <div class="col-12 pt-3">
            <div class="quick-filter-bar d-flex flex-wrap gap-2 justify-content-center justify-content-md-start">
                <span class="quick-filter-bar__label">بازه سریع:</span>
                <a href="@Url.Action("ManagerReports", "Home", new { period = "today" })" data-period="today" class="btn btn-outline-secondary quick-filter-btn @(currentPeriod == "today" ? "active" : "")">امروز</a>
                <a href="@Url.Action("ManagerReports", "Home", new { period = "week" })" data-period="week" class="btn btn-outline-secondary quick-filter-btn @(currentPeriod == "week" ? "active" : "")">هفته</a>
                <a href="@Url.Action("ManagerReports", "Home", new { period = "month" })" data-period="month" class="btn btn-outline-secondary quick-filter-btn @(currentPeriod == "month" ? "active" : "")">ماه</a>
                <a href="@Url.Action("ManagerReports", "Home", new { period = "quarter" })" data-period="quarter" class="btn btn-outline-secondary quick-filter-btn @(currentPeriod == "quarter" ? "active" : "")">سه‌ماهه</a>
                <a href="@Url.Action("ManagerReports", "Home", new { period = "year" })" data-period="year" class="btn btn-outline-secondary quick-filter-btn @(currentPeriod == "year" ? "active" : "")">سال</a>
                <button type="button" id="customRangeBtn" data-period="custom" class="btn btn-outline-secondary quick-filter-btn @(Model?.IsCustomRange == true ? "active" : "")">بازه دلخواه</button>
            </div>
        </div>
    </form>
</div>

<div id="reportsContainer" class="reports-container">
    @await Html.PartialAsync("_ManagerReportsPartial", Model)
</div>
</div>

<div class="modal fade" id="exportFormatModal" tabindex="-1" aria-labelledby="exportFormatModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content export-format-modal" dir="rtl">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" id="exportFormatModalLabel">نوع گزارش</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body pt-2">
                <p class="text-center text-muted mb-3">فرمت دانلود گزارش را انتخاب کنید. مبالغ در هر دو فایل به تومان است.</p>
                <div class="export-format-options d-grid gap-2">
                    <button type="button" id="exportFormatExcel" class="export-format-option export-format-option--excel">
                        <span class="export-format-option__icon"><i class="bi bi-file-earmark-excel-fill"></i></span>
                        <span class="export-format-option__text">
                            <strong>اکسل</strong>
                            <small>جدول کامل مالی به تومان (.xlsx)</small>
                        </span>
                    </button>
                    <button type="button" id="exportFormatPdf" class="export-format-option export-format-option--pdf">
                        <span class="export-format-option__icon"><i class="bi bi-file-earmark-pdf-fill"></i></span>
                        <span class="export-format-option__text">
                            <strong>PDF</strong>
                            <small>گزارش چاپی به تومان (.pdf)</small>
                        </span>
                    </button>
                    <button type="button" class="btn btn-light export-format-cancel" data-bs-dismiss="modal">انصراف</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="exportNoOrdersModal" tabindex="-1" aria-labelledby="exportNoOrdersModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" dir="rtl">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" id="exportNoOrdersModalLabel">توجه</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body pt-2">
                <p id="exportNoOrdersMessage" class="mb-0 text-center">هیچ سفارشی در این بازه زمانی یافت نشد.</p>
            </div>
            <div class="modal-footer border-0 pt-0 justify-content-center">
                <button type="button" class="btn btn-primary px-4" data-bs-dismiss="modal">متوجه شدم</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/chart.umd.min.js"></script>
    <script src="~/js/jalalidatepicker.min.js"></script>
    <script>
        window.__exportExcelUrl = "@Url.Action("ExportOrdersToExcel", "Home")";
        window.__exportPdfUrl = "@Url.Action("ExportOrdersToPdf", "Home")";
    </script>
    <script src="~/js/manager_report_partial.js" asp-append-version="true"></script>
    <script src="~/js/manager_report.js" asp-append-version="true"></script>
}
