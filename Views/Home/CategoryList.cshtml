@model List<CategoryViewModel>

@{
    ViewData["Title"] = "مدیریت دسته‌بندی‌ها";
}
<style>
    :root {
        --primary: #ff7a00;
        --primary-hover: #e66900;
        --primary-light: rgba(255,122,0,0.08);
        --bg-page: #f6f8fc;
        --card-bg: #ffffff;
        --card-border: #e9eef5;
        --shadow-sm: 0 4px 12px rgba(15,23,42,0.04);
        --shadow-md: 0 8px 24px rgba(15,23,42,0.06);
        --shadow-lg: 0 16px 40px rgba(15,23,42,0.08);
        --text-dark: #1e293b;
        --text-muted: #64748b;
        --radius-sm: 10px;
        --radius-md: 16px;
        --radius-lg: 20px;
        --radius-pill: 999px;
        --transition: 0.2s ease;
    }

    .category-page {
        direction: rtl;
        font-family: 'IRANYekan', 'IRANSans', system-ui, -apple-system, sans-serif;
        color: var(--text-dark);
    }

    h2 {
        font-weight: 600;
    }

    .card {
        border-radius: 1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        border: none;
        transition: box-shadow 0.2s;
        position: relative;
    }

    .category-order-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-width: 720px;
        margin: 0 auto;
    }

    .category-order-item {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm);
        padding: 12px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        transition: box-shadow var(--transition), border-color var(--transition), transform var(--transition);
    }

        .category-order-item.is-dragging {
            opacity: 0.55;
            box-shadow: var(--shadow-lg);
        }

        .category-order-item.sortable-chosen {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-light);
        }

    .category-order-main {
        display: flex;
        align-items: center;
        gap: 12px;
        flex: 1;
        min-width: 0;
    }

    .category-drag-handle {
        flex-shrink: 0;
        width: 36px;
        height: 36px;
        border: 1px dashed #cbd5e1;
        border-radius: 10px;
        background: #f8fafc;
        color: #64748b;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: grab;
        touch-action: none;
        transition: var(--transition);
    }

        .category-drag-handle:hover {
            border-color: var(--primary);
            color: var(--primary);
            background: var(--primary-light);
        }

        .category-drag-handle:active {
            cursor: grabbing;
        }

    .category-order-num {
        flex-shrink: 0;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--primary-light);
        color: var(--primary);
        font-weight: 800;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .category-order-name {
        flex: 1;
        min-width: 0;
        margin: 0;
        font-size: 1rem;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .category-move-btns {
        display: inline-flex;
        flex-direction: column;
        gap: 4px;
        flex-shrink: 0;
    }

        .category-move-btns .btn {
            width: 34px;
            height: 28px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }

        .category-move-btns .btn:disabled {
            opacity: 0.35;
        }

    .category-actions {
        display: inline-flex;
        gap: 6px;
        flex-shrink: 0;
    }

    .category-order-save-bar {
        position: fixed;
        left: 50%;
        bottom: 24px;
        transform: translateX(-50%);
        z-index: 1050;
        background: #fff;
        border: 1px solid var(--card-border);
        border-radius: var(--radius-pill);
        box-shadow: 0 12px 40px rgba(15, 23, 42, 0.18);
        padding: 10px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        max-width: calc(100vw - 24px);
    }

        .category-order-save-bar .save-bar-text {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-dark);
            white-space: nowrap;
        }

    @@media (max-width: 576px) {
        .category-order-item {
            flex-direction: column;
            align-items: stretch;
        }

        .category-order-main {
            width: 100%;
        }

        .category-actions {
            justify-content: flex-end;
        }

        .category-order-save-bar {
            flex-direction: column;
            align-items: stretch;
            border-radius: var(--radius-md);
            bottom: 12px;
        }

            .category-order-save-bar .btn {
                width: 100%;
            }
    }

    .sortable-drag {
        opacity: 0.85;
    }

    .sortable-ghost {
        opacity: 0.35;
        background: var(--primary-light);
        border-style: dashed;
    }

    /* legacy drag handle - unused */
    .drag-handle {
        display: none;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--primary), #f97316);
        border: none;
        border-radius: var(--radius-sm);
        font-weight: 700;
        padding: 8px 20px;
        box-shadow: 0 6px 16px rgba(255,122,0,0.25);
        transition: all var(--transition);
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #f97316, var(--primary-hover));
            transform: translateY(-2px);
        }

    .btn-outline-primary {
        border-color: var(--primary);
        color: var(--primary);
    }

        .btn-outline-primary:hover {
            background: var(--primary);
            border-color: var(--primary);
            color: white;
        }

    .order-badge {
        display: none;
    }

    /* هشدار راهنما */
    .drag-hint {
        background: var(--primary-light);
        border-right: 4px solid var(--primary);
        border-radius: 12px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: 0.88rem;
        color: #1e2a3a;
        max-width: 720px;
        margin-left: auto;
        margin-right: auto;
    }

        .drag-hint i {
            font-size: 1.1rem;
            margin-left: 8px;
            color: var(--primary);
        }
</style>

<div class="container category-page mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2></h2>
        <div>
            <button class="btn btn-primary" onclick="openAddCategoryModal()">افزودن دسته‌بندی</button>
        </div>
    </div>

    <div id="dragHint" class="drag-hint">
        <i class="fas fa-sort"></i>
        <strong>ترتیب منو:</strong>
        با دکمه‌های <i class="fas fa-chevron-up"></i> و <i class="fas fa-chevron-down"></i> هر دسته را یک پله جابه‌جا کنید،
        یا آیکون <i class="fas fa-grip-vertical"></i> را بکشید. در پایان «ذخیره ترتیب منو» را بزنید.
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">هیچ دسته‌بندی وجود ندارد.</div>
    }
    else
    {
        <!-- لیست عمودی برای تغییر ترتیب -->
        <div id="sortable-list" class="category-order-list">
            @foreach (var cat in Model.OrderBy(c => c.DisplayOrder))
            {
                <div class="category-order-item" data-id="@cat.CategoryId">
                    <div class="category-order-main">
                        <button type="button" class="category-drag-handle" title="کشیدن برای جابجایی" aria-label="کشیدن برای جابجایی">
                            <i class="fas fa-grip-vertical"></i>
                        </button>
                        <span class="category-order-num">@cat.DisplayOrder</span>
                        <h5 class="category-order-name">@cat.CategoryName</h5>
                        <div class="category-move-btns">
                            <button type="button" class="btn btn-sm btn-outline-secondary category-move-up" title="انتقال به بالا" aria-label="انتقال به بالا">
                                <i class="fas fa-chevron-up"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary category-move-down" title="انتقال به پایین" aria-label="انتقال به پایین">
                                <i class="fas fa-chevron-down"></i>
                            </button>
                        </div>
                    </div>
                    <div class="category-actions">
                        <button type="button" class="btn btn-sm btn-warning" onclick="openEditCategoryModal(@cat.CategoryId)">ویرایش</button>
                        <button type="button" class="btn btn-sm btn-danger" onclick="deleteCategory(@cat.CategoryId)">حذف</button>
                    </div>
                </div>
            }
        </div>

        <div id="orderSaveBar" class="category-order-save-bar d-none">
            <span class="save-bar-text"><i class="fas fa-exclamation-circle text-warning ms-1"></i> ترتیب منو تغییر کرد</span>
            <button type="button" class="btn btn-primary btn-sm" id="saveOrderBtn">ذخیره ترتیب منو</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="cancelOrderBtn">انصراف</button>
        </div>
    }
</div>

 
<div class="modal fade" id="categoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div id="errorContainer" class="alert alert-danger d-none"></div>
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">افزودن دسته‌بندی</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="categoryForm">
                    <input type="hidden" id="categoryId" />
                    <div class="mb-3">
                        <label>نام دسته‌بندی <span class="text-danger">*</span></label>
                        <input type="text" id="categoryName" class="form-control" required />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
                <button class="btn btn-primary" onclick="saveCategory()">ذخیره</button>
            </div>
        </div>
    </div>
</div>

 
@Html.AntiForgeryToken()

@section Scripts {
<script src="~/js/Sortable.min.js" asp-append-version="true"></script>
<script>
    var API_BASE = "/api/v2/UserApi";
    var restaurantId = @(ViewBag.RestaurantId ?? 0);
    var sortableContainer = null;
    var sortable = null;
    var initialCategoryOrder = [];

    function getCategoryItems() {
        return $('#sortable-list .category-order-item');
    }

    function updateOrderNumbers() {
        getCategoryItems().each(function (index) {
            $(this).find('.category-order-num').text(index + 1);
        });
    }

    function updateMoveButtons() {
        var $items = getCategoryItems();
        $items.each(function (index) {
            var $item = $(this);
            $item.find('.category-move-up').prop('disabled', index === 0);
            $item.find('.category-move-down').prop('disabled', index === $items.length - 1);
        });
    }

    function getCurrentCategoryOrder() {
        return getCategoryItems().map(function () {
            return parseInt($(this).attr('data-id'), 10);
        }).get();
    }

    function isOrderChanged() {
        var current = getCurrentCategoryOrder();
        if (current.length !== initialCategoryOrder.length) return true;
        for (var i = 0; i < current.length; i++) {
            if (current[i] !== initialCategoryOrder[i]) return true;
        }
        return false;
    }

    function markOrderDirty() {
        updateOrderNumbers();
        updateMoveButtons();
        if (isOrderChanged()) {
            $('#orderSaveBar').removeClass('d-none');
        } else {
            $('#orderSaveBar').addClass('d-none');
        }
    }

    function moveCategoryItem($item, direction) {
        if (!$item || !$item.length) return;
        if (direction === 'up') {
            var $prev = $item.prev('.category-order-item');
            if ($prev.length) $item.insertBefore($prev);
        } else {
            var $next = $item.next('.category-order-item');
            if ($next.length) $item.insertAfter($next);
        }
        markOrderDirty();
    }

    function saveCategoryOrder() {
        var items = [];
        getCategoryItems().each(function (index) {
            var categoryId = parseInt($(this).attr('data-id'), 10);
            if (!categoryId) return;
            items.push({
                categoryId: categoryId,
                displayOrder: index + 1
            });
        });

        if (!items.length) {
            showToast('دسته\u200cبندی\u200cای برای ذخیره ترتیب یافت نشد', 'error');
            return;
        }

        var $btn = $('#saveOrderBtn');
        var originalHtml = $btn.html();
        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm ms-1"></span> در حال ذخیره...');

        $.ajax({
            url: '@Url.Action("UpdateCategoriesOrder", "Home")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(items),
            headers: {
                'RequestVerificationToken': getAntiForgeryToken()
            },
            success: function (res) {
                $btn.prop('disabled', false).html(originalHtml);
                if (res.success) {
                    showToast('ترتیب منو با موفقیت ذخیره شد', 'success');
                    initialCategoryOrder = getCurrentCategoryOrder();
                    $('#orderSaveBar').addClass('d-none');
                } else {
                    showToast('خطا در ذخیره ترتیب: ' + (res.message || 'خطای ناشناخته'), 'error');
                }
            },
            error: function (xhr) {
                $btn.prop('disabled', false).html(originalHtml);
                var msg = 'خطا در ارتباط با سرور';
                if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                showToast(msg, 'error');
            }
        });
    }

    function getAntiForgeryToken() {
        var input = document.querySelector('input[name="__RequestVerificationToken"]');
        return input ? input.value : '';
    }

    function openAddCategoryModal() {
        $("#modalTitle").text("افزودن دسته‌بندی");
        $("#categoryId").val("");
        $("#categoryName").val("");
        clearErrors();
        new bootstrap.Modal(document.getElementById('categoryModal')).show();
    }

    // ============================================================
    // OPEN EDIT CATEGORY MODAL
    // ============================================================
    function openEditCategoryModal(id) {
        const cardDiv = $(`[data-id='${id}']`);
        const name = cardDiv.find('.category-order-name').text();
        $("#categoryId").val(id);
        $("#categoryName").val(name);
        $("#modalTitle").text("ویرایش دسته‌بندی");
        clearErrors();
        new bootstrap.Modal(document.getElementById('categoryModal')).show();
    }

    // ============================================================
    // SAVE CATEGORY (Add or Edit) - V2 API
    // ============================================================
    async function saveCategory() {
        clearErrors();
        const id = $("#categoryId").val();
        const name = $("#categoryName").val().trim();

        if (!name) {
            showErrors(["نام دسته‌بندی الزامی است."]);
            return;
        }

        // Prepare request data
        const data = {
            restaurantId: restaurantId,
            categoryName: name
        };

        let url = `${API_BASE}/addcategory`;
        let method = "POST";

        if (id) {
            url = `${API_BASE}/editcategory`;
            data.categoryId = parseInt(id);
            method = "PUT"; // Fixed: EditCategory uses HttpPut
        }

        try {
            const response = await window.fetchWithAuth(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const res = await response.json();
            if (res.success) {
                showToast(res.message || 'عملیات موفق', 'success');
                setTimeout(() => location.reload(), 1000);
            } else {
                showErrors([res.message || "خطا در ذخیره"]);
            }
        } catch (error) {
            showErrors([error.message || "خطا در ارتباط با سرور"]);
        }
    }

    async function deleteCategory(id) {
        if (!(await showConfirm({ message: 'آیا از حذف این دسته\u200cبندی مطمئن هستید؟' }))) return;

        try {
            const response = await window.fetchWithAuth(`${API_BASE}/deletecategory`, {
                method: "DELETE",
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    restaurantId: restaurantId,
                    categoryId: id
                })
            });
            const res = await response.json();
            showToast(res.message || 'عملیات موفق', res.success ? 'success' : 'error');
            if (res.success) {
                setTimeout(() => location.reload(), 1000);
            }
        } catch (error) {
            showToast('خطا در ارتباط با سرور', 'error');
        }
    }

    // ============================================================
    // HELPER: Show errors in modal
    // ============================================================
    function showErrors(errors) {
        const errorBox = $("#errorContainer");
        errorBox.html(errors.map(e => `<div>• ${e}</div>`).join(""));
        errorBox.removeClass("d-none");
    }

    function clearErrors() {
        $("#errorContainer").addClass("d-none").html("");
    }

    function initCategoryListPage() {
        if (!document.getElementById('sortable-list')) return;

        if (sortable) {
            sortable.destroy();
            sortable = null;
        }

        sortableContainer = document.getElementById('sortable-list');
        initialCategoryOrder = getCurrentCategoryOrder();
        updateOrderNumbers();
        updateMoveButtons();
        $('#orderSaveBar').addClass('d-none');

        if (sortableContainer) {
            sortable = new Sortable(sortableContainer, {
                animation: 180,
                handle: '.category-drag-handle',
                draggable: '.category-order-item',
                ghostClass: 'sortable-ghost',
                chosenClass: 'sortable-chosen',
                dragClass: 'is-dragging',
                forceFallback: true,
                fallbackTolerance: 3,
                onEnd: function () {
                    markOrderDirty();
                }
            });
        }

        $('#sortable-list')
            .off('click.categoryList', '.category-move-up')
            .on('click.categoryList', '.category-move-up', function () {
                moveCategoryItem($(this).closest('.category-order-item'), 'up');
            })
            .off('click.categoryList', '.category-move-down')
            .on('click.categoryList', '.category-move-down', function () {
                moveCategoryItem($(this).closest('.category-order-item'), 'down');
            });

        $('#saveOrderBtn').off('click.categoryList').on('click.categoryList', saveCategoryOrder);

        $('#cancelOrderBtn').off('click.categoryList').on('click.categoryList', function () {
            location.reload();
        });
    }

    window.initCategoryListPage = initCategoryListPage;
</script>
}
</script>
</script>
</script>