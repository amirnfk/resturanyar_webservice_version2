@model List<CategoryViewModel>

@{
    ViewData["Title"] = "مدیریت دسته‌بندی‌ها";
}

<link href="~/css/bootstrap_rtl_min.css" rel="stylesheet" />
<style>
    :root {
        --primary: #ff7a00;
        --primary-hover: #e66900;
        --primary-light: rgba(255,122,0,0.08);
        --bg-page: #f6f8fc;
        --card-bg: #ffffff;
        --card-border: #e9eef5;
        --shadow-sm: 0 4px 12px rgba(15,23,42,0.04);
        --shadow-md: 0 8px 24px rgba(15,23,42,0.06);
        --shadow-lg: 0 16px 40px rgba(15,23,42,0.08);
        --text-dark: #1e293b;
        --text-muted: #64748b;
        --radius-sm: 10px;
        --radius-md: 16px;
        --radius-lg: 20px;
        --radius-pill: 999px;
        --transition: 0.2s ease;
    }

    body {
        background: var(--bg-page);
        direction: rtl;
        font-family: 'IRANYekan', 'IRANSans', system-ui, -apple-system, sans-serif;
        color: var(--text-dark);
    }

    h2 {
        font-weight: 600;
    }

    .card {
        border-radius: 1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        border: none;
        cursor: grab;
        transition: box-shadow 0.2s;
        position: relative;
    }

        .card:active {
            cursor: grabbing;
        }

    /* آیکون کشیدن در کارت */
    .drag-handle {
        position: absolute;
        top: 12px;
        left: 12px;
        cursor: grab;
        color: #adb5bd;
        font-size: 1.2rem;
        line-height: 1;
        user-select: none;
    }

        .drag-handle:active {
            cursor: grabbing;
        }

    .sortable-drag {
        opacity: 0.5;
        cursor: grabbing;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--primary), #f97316);
        border: none;
        border-radius: var(--radius-sm);
        font-weight: 700;
        padding: 8px 20px;
        box-shadow: 0 6px 16px rgba(255,122,0,0.25);
        transition: all var(--transition);
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #f97316, var(--primary-hover));
            transform: translateY(-2px);
        }

    .btn-outline-primary {
        border-color: var(--primary);
        color: var(--primary);
    }

        .btn-outline-primary:hover {
            background: var(--primary);
            border-color: var(--primary);
            color: white;
        }

    .order-badge {
        background-color: #e9ecef;
        border-radius: 20px;
        padding: 4px 12px;
        font-size: 0.8rem;
        font-weight: 500;
        color: #495057;
    }

    /* هشدار راهنما */
    .drag-hint {
        background: #e9f0ff;
        border-right: 4px solid var(--primary);
        border-radius: 12px;
        padding: 10px 15px;
        margin-bottom: 20px;
        font-size: 0.85rem;
        color: #1e2a3a;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }

        .drag-hint i {
            font-size: 1.2rem;
            margin-left: 8px;
            color: var(--primary);
        }

    .close-hint {
        background: transparent;
        border: none;
        color: #6c757d;
        font-size: 1.2rem;
        cursor: pointer;
        padding: 0 5px;
    }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2></h2>
        <div>
            <button class="btn btn-primary me-2" onclick="openAddCategoryModal()">افزودن دسته‌بندی</button>
            <button class="btn btn-outline-primary" id="saveOrderBtn" style="display:none;">ذخیره ترتیب</button>
        </div>
    </div>

    <!-- هینت راهنما (قابل بستن) -->
    <div id="dragHint" class="drag-hint" style="display: none;">
        <div>
            <i class="bi bi-arrows-move"></i>
            <strong>تغییر ترتیب دسته‌بندی‌ها:</strong> کافیست هر دسته‌بندی را با کشیدن ماوس (درگ کردن) جابه‌جا کنید، سپس دکمه «ذخیره ترتیب» را بزنید. این کار باعث تغییر ترتیب نمایش دسته بندی های منو شما می شود..
        </div>
        
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">هیچ دسته‌بندی وجود ندارد.</div>
    }
    else
    {
        <!-- wrapper برای Sortable -->
        <div id="sortable-list" class="row">
            @foreach (var cat in Model.OrderBy(c => c.DisplayOrder))
            {
                <div class="col-12 col-md-6 col-lg-4 mb-3" data-id="@cat.CategoryId">
                    <div class="card p-3 h-100">
                        <!-- آیکون کشیدن (دسته) -->
                        <div class="drag-handle">⋮⋮</div>
                        <div class="d-flex justify-content-between align-items-start">
                            <h5 class="mb-0">@cat.CategoryName</h5>
                            <span class="order-badge">ترتیب: @cat.DisplayOrder</span>
                        </div>
                        <div class="mt-3 d-flex justify-content-between">
                            <button class="btn btn-sm btn-warning" onclick="openEditCategoryModal(@cat.CategoryId)">ویرایش</button>
                            <button class="btn btn-sm btn-danger" onclick="deleteCategory(@cat.CategoryId)">حذف</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

 
<div class="modal fade" id="categoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div id="errorContainer" class="alert alert-danger d-none"></div>
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">افزودن دسته‌بندی</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="categoryForm">
                    <input type="hidden" id="categoryId" />
                    <div class="mb-3">
                        <label>نام دسته‌بندی <span class="text-danger">*</span></label>
                        <input type="text" id="categoryName" class="form-control" required />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
                <button class="btn btn-primary" onclick="saveCategory()">ذخیره</button>
            </div>
        </div>
    </div>
</div>

 
@Html.AntiForgeryToken()

<!-- CategoryList.cshtml - Updated JavaScript Section -->
<script src="~/js/jquery_3.6.0.min.js"></script>
<script src="~/js/bootstrap.bundle.min.js"></script>
<script src="~/js/Sortable.min.js" asp-append-version="true"></script>

<!-- Import the interceptor and expose it globally -->
<script type="module">
    import { fetchWithAuth } from '/js/authentication/apiinterceptor.js';
    window.fetchWithAuth = fetchWithAuth;
</script>

<script>
    const API_BASE = "/api/v2/UserApi";
    var restaurantId = @(ViewBag.RestaurantId ?? 0);
    var token = $('input[name="__RequestVerificationToken"]').val();

    // ============================================================
    // SORTABLE - Drag & Drop reordering
    // ============================================================
    var sortableContainer = document.getElementById('sortable-list');
    var sortable = null;
    if (sortableContainer) {
        sortable = new Sortable(sortableContainer, {
            animation: 300,
            handle: '.card',
            ghostClass: 'sortable-drag',
            onEnd: function() {
                $('#saveOrderBtn').show();
            }
        });
    }

    // Show hint once
    function showHintOnce() {
        $('#dragHint').slideDown(300);
    }

    // ============================================================
    // SAVE ORDER - Keep using the existing Home controller action
    // ============================================================
    $('#saveOrderBtn').click(function() {
        var items = [];
        $('#sortable-list .col-12').each(function(index) {
            var categoryId = $(this).data('id');
            items.push({
                categoryId: categoryId,
                displayOrder: index + 1
            });
        });

        $.ajax({
            url: '@Url.Action("UpdateCategoriesOrder", "Home")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(items),
            headers: {
                'RequestVerificationToken': token
            },
            success: function(res) {
                if (res.success) {
                    showToast('ترتیب دسته‌بندی‌ها با موفقیت ذخیره شد', 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast('خطا در ذخیره ترتیب: ' + (res.message || 'خطای ناشناخته'), 'error');
                }
            },
            error: function(xhr) {
                let msg = 'خطا در ارتباط با سرور';
                if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                showToast(msg, 'error');
            }
        });
    });

    // ============================================================
    // OPEN ADD CATEGORY MODAL
    // ============================================================
    function openAddCategoryModal() {
        $("#modalTitle").text("افزودن دسته‌بندی");
        $("#categoryId").val("");
        $("#categoryName").val("");
        clearErrors();
        new bootstrap.Modal(document.getElementById('categoryModal')).show();
    }

    // ============================================================
    // OPEN EDIT CATEGORY MODAL
    // ============================================================
    function openEditCategoryModal(id) {
        const cardDiv = $(`[data-id='${id}']`);
        const name = cardDiv.find('h5').text();
        $("#categoryId").val(id);
        $("#categoryName").val(name);
        $("#modalTitle").text("ویرایش دسته‌بندی");
        clearErrors();
        new bootstrap.Modal(document.getElementById('categoryModal')).show();
    }

    // ============================================================
    // SAVE CATEGORY (Add or Edit) - V2 API
    // ============================================================
    async function saveCategory() {
        clearErrors();
        const id = $("#categoryId").val();
        const name = $("#categoryName").val().trim();

        if (!name) {
            showErrors(["نام دسته‌بندی الزامی است."]);
            return;
        }

        // Prepare request data
        const data = {
            restaurantId: restaurantId,
            categoryName: name
        };

        let url = `${API_BASE}/addcategory`;
        let method = "POST";

        if (id) {
            url = `${API_BASE}/editcategory`;
            data.categoryId = parseInt(id);
            method = "PUT"; // Fixed: EditCategory uses HttpPut
        }

        try {
            const response = await window.fetchWithAuth(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const res = await response.json();
            if (res.success) {
                showToast(res.message || 'عملیات موفق', 'success');
                setTimeout(() => location.reload(), 1000);
            } else {
                showErrors([res.message || "خطا در ذخیره"]);
            }
        } catch (error) {
            showErrors([error.message || "خطا در ارتباط با سرور"]);
        }
    }

    async function deleteCategory(id) {
        if (!(await showConfirm({ message: 'آیا از حذف این دسته\u200cبندی مطمئن هستید؟' }))) return;

        try {
            const response = await window.fetchWithAuth(`${API_BASE}/deletecategory`, {
                method: "DELETE",
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    restaurantId: restaurantId,
                    categoryId: id
                })
            });
            const res = await response.json();
            showToast(res.message || 'عملیات موفق', res.success ? 'success' : 'error');
            if (res.success) {
                setTimeout(() => location.reload(), 1000);
            }
        } catch (error) {
            showToast('خطا در ارتباط با سرور', 'error');
        }
    }

    // ============================================================
    // HELPER: Show errors in modal
    // ============================================================
    function showErrors(errors) {
        const errorBox = $("#errorContainer");
        errorBox.html(errors.map(e => `<div>• ${e}</div>`).join(""));
        errorBox.removeClass("d-none");
    }

    function clearErrors() {
        $("#errorContainer").addClass("d-none").html("");
    }

    // ============================================================
    // INITIALIZATION
    // ============================================================
    $(document).ready(function() {
        showHintOnce();
    });
</script>