@{
    Layout = "_SimpleLayout";
}

@using resturanyar.Utility
@model AddRestaurantRequest
@{
    ViewData["Title"] = "انتخاب یا افزودن کافه یا رستوران";
    var restaurants = ViewBag.Restaurants as List<Restaurant>;
    var restaurantBackgrounds = ViewBag.RestaurantBackgrounds as IReadOnlyDictionary<int, string>
        ?? new Dictionary<int, string>();
    var backgroundImageUrl = ViewBag.BackgroundImageUrl as string ?? RestaurantBackgroundOptions.DefaultUrl;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/bootstrap_rtl_min.css" rel="stylesheet">
    <link href="~/css/all.min.css" rel="stylesheet">
    <link href="~/css/chooserestaurant.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/simple_share.css" rel="stylesheet" asp-append-version="true">
    <style>
        :root { --page-background-image: url('@backgroundImageUrl'); }
        .login-bg-wrapper { background-image: var(--page-background-image) !important; }
    </style>
    <script src="~/js/restaurant-background-cache.js" asp-append-version="true"></script>
</head>
<body class="bg-light">

    <div class="login-bg-wrapper">
        <div class="login-overlay"></div>
    </div>

    <div class="main-login-container">
        <div class="login-card shadow-lg rounded-4">

            <div class="text-center mb-4">
                <img src="~/images/logo.png" alt="لوگو" class="logo-img mb-3 shadow-sm" />
                <h5 class="fw-bold text-dark">انتخاب کافه | رستوران</h5>
            </div>

            @if (restaurants != null && restaurants.Count > 0)
            {
                <form asp-action="SelectRestaurant" method="post" id="selectRestaurantForm">
                    <div class="d-flex align-items-center gap-2 mb-4">
                        <button type="button" id="btnShowAdd" class="btn btn-orange rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px; padding: 0;" title="افزودن رستوران جدید">
                            <i class="fa-solid fa-plus"></i>
                        </button>

                        <select name="restaurantId" id="restaurantSelect" class="form-select custom-input flex-grow-1" style="height: 48px;">
                            @foreach (var r in restaurants)
                            {
                                var optionBackground = restaurantBackgrounds.TryGetValue(r.restaurant_id, out var savedBackground)
                                    ? savedBackground
                                    : RestaurantBackgroundOptions.DefaultUrl;
                                <option value="@r.restaurant_id" data-background-url="@optionBackground">@r.name</option>
                            }
                        </select>
                    </div>

                    <div class="d-grid mt-2">
                        <button type="submit" class="btn btn-orange btn-lg fw-bold rounded-pill">ورود</button>
                    </div>
                </form>
            }
            else
            {
                <div class="alert alert-info mt-3 text-center small rounded-3 border-0 bg-opacity-10 text-orange fw-bold">
                    هیچ کافه یا رستورانی ثبت نشده است.
                </div>
                <div class="d-grid mt-4">
                    <button type="button" id="btnShowAdd" class="btn btn-orange btn-lg fw-bold rounded-pill">
                        <i class="fa-solid fa-plus ms-1"></i> افزودن کافه | رستوران
                    </button>
                </div>
            }

            <form id="addRestaurantForm" class="mt-4 text-start" style="display:none;">
                <hr class="text-muted mb-4 border-opacity-25" />
                <div class="mb-3">
                    <label class="form-label fw-bold small text-dark">نام کافه | رستوران جدید</label>
                    <input type="text" id="restaurantName" dir="rtl" class="form-control form-control-lg custom-input text-start" placeholder="مثلاً: کافه لوتوس" />
                    <div id="nameError" class="text-danger small mt-2" style="display:none;"></div>
                </div>
                <div class="d-grid mt-4">
                    <button type="button" id="btnAddRestaurant" class="btn btn-orange btn-lg fw-bold rounded-pill">افزودن و ورود</button>
                </div>
            </form>

        </div>
    </div>

 
    <script>
       
        (function() {
          const html = document.documentElement;
          const storageKey = "ry-theme";
          try {
            const saved = localStorage.getItem(storageKey);
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (saved) {
              html.setAttribute('data-theme', saved);
            } else if (prefersDark) {
              html.setAttribute('data-theme', 'dark');
            }
          } catch(e) {}
        })();
    </script>
    <script src="~/js/jquery_3.6.0.min.js"></script>
    <script type="module">
        import { fetchWithAuth, refreshAccessToken } from '/js/authentication/apiinterceptor.js';
        window.fetchWithAuth = fetchWithAuth;

        async function ensureValidJwtSession() {
            let token = localStorage.getItem('accessToken');
            const phone = localStorage.getItem('phone');
            const refreshToken = localStorage.getItem('refreshToken');

            if (!token && refreshToken && phone) {
                try {
                    token = await refreshAccessToken();
                } catch { /* fall through */ }
            }

            if (!token) {
                localStorage.removeItem('accessToken');
                localStorage.removeItem('refreshToken');
                localStorage.removeItem('phone');
                window.location.href = '/Home/Logout';
                return false;
            }
            return true;
        }

        document.addEventListener('DOMContentLoaded', () => ensureValidJwtSession());
    </script>
    <script src="~/js/chooserestaurant.js" asp-append-version="true"></script>
</body>
</html>