@model List<resturanyar.Models.ViewModels.Admin.AdminMessageListViewModel>
@using resturanyar.Models.AdminMessage
@{
    ViewData["Title"] = "پیام‌های ارسالی";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div dir="rtl" class="admin-msg-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="admin-msg-header">
        <h1><i class="fas fa-envelope"></i> پیام‌های ارسالی</h1>
        <a href="@Url.Action("SendMessage")" class="btn btn-primary">
            <i class="fas fa-plus"></i> پیام جدید
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>عنوان</th>
                    <th>نوع</th>
                    <th>گیرندگان</th>
                    <th>تاریخ</th>
                    <th>وضعیت</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted">پیامی ارسال نشده است.</td></tr>
                }
                @foreach (var msg in Model)
                {
                    <tr>
                        <td>@msg.Title</td>
                        <td>
                            @if (msg.MessageType == AdminMessageType.Public)
                            {
                                <span class="badge bg-info">عمومی</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">خصوصی</span>
                            }
                        </td>
                        <td>@(msg.MessageType == AdminMessageType.Public ? "همه رستوران‌ها" : $"{msg.RecipientCount} رستوران")</td>
                        <td>@msg.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                        <td>
                            @if (msg.IsActive)
                            {
                                <span class="badge bg-success">فعال</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">غیرفعال</span>
                            }
                        </td>
                        <td>
                            @if (msg.IsActive)
                            {
                                <form asp-action="DeactivateMessage" method="post" class="d-inline"
                                      data-confirm="این پیام غیرفعال شود؟"
                                      data-confirm-title="غیرفعال کردن پیام">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@msg.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">غیرفعال</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .admin-msg-page { padding: 1rem; }
    .admin-msg-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    .admin-msg-header h1 { font-size: 1.5rem; margin: 0; }
</style>
