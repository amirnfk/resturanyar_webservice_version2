@model resturanyar.Models.ViewModels.Admin.AdminDashboardViewModel
@using DNTPersianUtils.Core
@{
    ViewData["Title"] = "داشبورد مدیریت";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<!-- DataTables CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<style>
    :root {
        --bg-page: #f1f5f9;
        --bg-card: #ffffff;
        --text-heading: #0f172a;
        --text-body: #334155;
        --text-muted: #94a3b8;
        --border: #e2e8f0;
        --border-light: #f1f5f9;
        --shadow-card: 0 1px 3px rgba(0,0,0,0.03), 0 4px 16px rgba(0,0,0,0.05);
        --shadow-hover: 0 8px 30px rgba(0,0,0,0.09);
        --shadow-lift: 0 20px 44px rgba(0,0,0,0.11);
        --r-sm: 8px;
        --r-md: 14px;
        --r-lg: 18px;
        --r-xl: 22px;
        --c-indigo: #4f46e5;
        --c-violet: #7c3aed;
        --c-cyan: #0891b2;
        --c-emerald: #059669;
        --c-amber: #d97706;
        --c-rose: #e11d48;
        --c-slate: #475569;
        --scrollbar-size: 7px;
        --scrollbar-track: rgba(148,163,184,0.08);
        --scrollbar-thumb: rgba(148,163,184,0.35);
        --scrollbar-thumb-hover: rgba(100,116,139,0.55);
    }

    * {
        box-sizing: border-box;
    }

    body {
        background: var(--bg-page);
        font-family: 'Vazir', 'Segoe UI', Tahoma, sans-serif;
        direction: rtl;
        margin: 0;
        padding: 0;
        color: var(--text-body);
    }

    /* ── Dashboard Wrapper ── */
    .dashboard-wrapper {
        position: relative;
        padding: 30px 28px 48px;
        max-width: 1480px;
        margin: 0 auto;
    }

        .dashboard-wrapper::before,
        .dashboard-wrapper::after {
            content: '';
            position: fixed;
            border-radius: 50%;
            pointer-events: none;
            z-index: 0;
        }

        .dashboard-wrapper::before {
            top: -220px;
            right: -120px;
            width: 560px;
            height: 560px;
            background: radial-gradient(circle, rgba(79,70,229,0.07) 0%, transparent 65%);
        }

        .dashboard-wrapper::after {
            bottom: -140px;
            left: -80px;
            width: 440px;
            height: 440px;
            background: radial-gradient(circle, rgba(8,145,178,0.06) 0%, transparent 65%);
        }

        .dashboard-wrapper > * {
            position: relative;
            z-index: 1;
        }

    /* ── Page Title ── */
    .page-title {
        font-size: 1.7rem;
        font-weight: 800;
        color: var(--text-heading);
        margin-bottom: 26px;
        display: flex;
        align-items: center;
        gap: 14px;
        letter-spacing: -0.3px;
    }

        .page-title .title-badge {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--c-indigo), var(--c-violet));
            border-radius: var(--r-md);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 1.15rem;
            box-shadow: 0 6px 18px rgba(79,70,229,0.32);
            flex-shrink: 0;
        }

    /* ── Animations ── */
    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pulseRing {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(217,119,6,0.35);
        }

        50% {
            box-shadow: 0 0 0 7px rgba(217,119,6,0);
        }
    }

    .anim {
        opacity: 0;
        animation: fadeUp .6s cubic-bezier(.22,1,.36,1) forwards;
    }

    .d1 {
        animation-delay: .04s
    }

    .d2 {
        animation-delay: .08s
    }

    .d3 {
        animation-delay: .12s
    }

    .d4 {
        animation-delay: .16s
    }

    .d5 {
        animation-delay: .20s
    }

    .d6 {
        animation-delay: .26s
    }

    .d7 {
        animation-delay: .32s
    }

    .d8 {
        animation-delay: .38s
    }

    /* ════════════════════════════════════════════════
           ── Custom Scrollbar — حرفه‌ای و مدرن ──
           ════════════════════════════════════════════════ */
    .table-scroll {
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 0 2px;
        scrollbar-width: thin;
        scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
        /* انتقال نرم برای مواقعی که مرورگر پشتیبانی می‌کند */
        scroll-behavior: smooth;
    }

        /* ── WebKit (Chrome, Edge, Safari) ── */
        .table-scroll::-webkit-scrollbar {
            width: var(--scrollbar-size);
        }

        .table-scroll::-webkit-scrollbar-track {
            background: transparent;
            border-radius: 20px;
            margin: 6px 2px;
        }

        .table-scroll::-webkit-scrollbar-thumb {
            background: var(--scrollbar-thumb);
            border-radius: 20px;
            border: 2px solid transparent;
            background-clip: content-box;
            transition: background .25s ease, border-color .25s ease, width .25s ease;
        }

            .table-scroll::-webkit-scrollbar-thumb:hover {
                background: var(--scrollbar-thumb-hover);
                border-color: transparent;
                background-clip: content-box;
            }

        /* ── افکت نمایش اسکرول‌بار هنگام هاور روی کانتینر ── */
        .table-scroll::-webkit-scrollbar-track {
            background: transparent;
            transition: background .3s ease;
        }

    .dash-card:hover .table-scroll::-webkit-scrollbar-track,
    .stat-card:hover .table-scroll::-webkit-scrollbar-track {
        background: var(--scrollbar-track);
    }

    /* ── ساید Indicator نازک در لبه چپ (RTL = لبه چپ) ── */
    .table-scroll::after {
        content: '';
        position: sticky;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background: transparent;
        border-radius: 0 3px 3px 0;
        pointer-events: none;
        z-index: 5;
        transition: background .3s ease;
    }

    .table-scroll.is-scrolling::after {
        background: linear-gradient(to bottom, transparent, rgba(79,70,229,0.25), transparent);
    }

    /* ── سایه‌های بالا و پایین برای نشان‌دادن محتوای بیشتر ── */
    .scroll-wrapper {
        position: relative;
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

        .scroll-wrapper .shadow-top,
        .scroll-wrapper .shadow-bottom {
            position: absolute;
            left: 0;
            right: 0;
            height: 28px;
            pointer-events: none;
            z-index: 3;
            opacity: 0;
            transition: opacity .3s ease;
        }

        .scroll-wrapper .shadow-top {
            top: 0;
            background: linear-gradient(to bottom, rgba(255,255,255,0.95), transparent);
        }

        .scroll-wrapper .shadow-bottom {
            bottom: 0;
            background: linear-gradient(to top, rgba(255,255,255,0.95), transparent);
        }

        .scroll-wrapper.scrolled-top .shadow-top {
            opacity: 1;
        }

        .scroll-wrapper.scrolled-bottom .shadow-bottom {
            opacity: 1;
        }

    /* ── جدول داخلی ── */
    .table-scroll table {
        width: 100%;
        font-size: .84rem;
        border-collapse: collapse;
    }

    .table-scroll thead th {
        background: linear-gradient(to bottom, #f8fafc, #f3f6fa);
        color: var(--c-slate);
        font-weight: 600;
        padding: 10px 10px;
        border-bottom: 2px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 2;
        white-space: nowrap;
        font-size: .78rem;
    }

    .table-scroll tbody td {
        padding: 9px 10px;
        border-bottom: 1px solid var(--border-light);
        vertical-align: middle;
    }

    .table-scroll tbody tr {
        transition: background .15s;
    }

        .table-scroll tbody tr:hover td {
            background: #f8fafc;
        }

        .table-scroll tbody tr:last-child td {
            border-bottom: none;
        }

    /* ── Stat Cards ── */
    .stat-card {
        background: var(--bg-card);
        border-radius: var(--r-lg);
        padding: 24px 18px 20px;
        position: relative;
        overflow: hidden;
        transition: all .35s cubic-bezier(.22,1,.36,1);
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        border: 1px solid var(--border);
        cursor: default;
    }

        .stat-card:hover {
            transform: translateY(-7px);
            box-shadow: var(--shadow-lift);
            border-color: transparent;
        }

        .stat-card .strip {
            position: absolute;
            top: 0;
            right: 0;
            left: 0;
            height: 4px;
            border-radius: var(--r-lg) var(--r-lg) 0 0;
        }

        .stat-card .watermark {
            position: absolute;
            bottom: -6px;
            left: -8px;
            font-size: 3.2rem;
            opacity: .045;
            color: var(--text-heading);
            transition: opacity .3s;
            pointer-events: none;
        }

        .stat-card:hover .watermark {
            opacity: .08;
        }

        .stat-card .icon-circle {
            width: 50px;
            height: 50px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            color: #fff;
            margin-bottom: 14px;
            box-shadow: 0 4px 14px rgba(0,0,0,0.12);
            flex-shrink: 0;
        }

        .stat-card .stat-number {
            font-size: 2rem;
            font-weight: 800;
            color: var(--text-heading);
            line-height: 1.1;
            margin-bottom: 5px;
        }

        .stat-card .stat-label {
            color: var(--text-muted);
            font-size: .82rem;
            font-weight: 500;
        }

    /* ── Shared Card ── */
    .dash-card {
        background: var(--bg-card);
        border-radius: var(--r-lg);
        box-shadow: var(--shadow-card);
        border: 1px solid var(--border);
        transition: box-shadow .3s ease;
    }

        .dash-card:hover {
            box-shadow: var(--shadow-hover);
        }

        .dash-card .card-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 20px 14px;
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }

            .dash-card .card-head h5 {
                margin: 0;
                font-weight: 700;
                font-size: .93rem;
                color: var(--text-heading);
                display: flex;
                align-items: center;
                gap: 9px;
            }

                .dash-card .card-head h5 i {
                    font-size: .88rem;
                    opacity: .55;
                }

            .dash-card .card-head .cnt {
                background: #f1f5f9;
                border-radius: 20px;
                padding: 4px 14px;
                font-size: .74rem;
                font-weight: 600;
                color: var(--c-slate);
                white-space: nowrap;
            }

    /* ── Table Cards با ارتفاع ثابت ── */
    .table-card {
        height: 340px;
        display: flex;
        flex-direction: column;
    }

    /* ── رستوران لیست: ارتفاع بیشتر چون فیلتر هم دارد ── */
    .table-card-tall {
        height: 440px;
        display: flex;
        flex-direction: column;
    }

    /* ── Badges ── */
    .badge-active {
        background: #ecfdf5;
        color: #059669;
        padding: 4px 14px;
        border-radius: 20px;
        font-size: .72rem;
        font-weight: 600;
        white-space: nowrap;
        display: inline-block;
    }

    .badge-expired {
        background: #fef2f2;
        color: #dc2626;
        padding: 4px 14px;
        border-radius: 20px;
        font-size: .72rem;
        font-weight: 600;
        white-space: nowrap;
        display: inline-block;
    }

    .badge-none {
        background: #f1f5f9;
        color: #64748b;
        padding: 4px 14px;
        border-radius: 20px;
        font-size: .72rem;
        font-weight: 600;
        white-space: nowrap;
        display: inline-block;
    }

    .expiring-warning td {
        background: #fffbeb !important;
        border-right: 3px solid var(--c-amber);
    }

    .expiring-warning:hover td {
        background: #fef3c7 !important;
    }

    .pulse-amber {
        animation: pulseRing 2s infinite;
        border-radius: 20px;
    }

    /* ── Chart Cards ── */
    .chart-card {
        height: 340px;
        display: flex;
        flex-direction: column;
    }

        .chart-card .chart-body {
            flex: 1;
            min-height: 0;
            position: relative;
            padding: 6px 14px 14px;
        }

            .chart-card .chart-body canvas {
                width: 100% !important;
                height: 100% !important;
            }

    /* ── Filter Bar ── */
    .filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        padding: 14px 20px;
        background: #f8fafc;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
    }

        .filter-bar .form-control,
        .filter-bar .form-select {
            border: 1px solid var(--border);
            border-radius: var(--r-sm);
            padding: 8px 14px;
            font-size: .84rem;
            transition: border-color .2s, box-shadow .2s;
            font-family: inherit;
            background: #fff;
        }

            .filter-bar .form-control:focus,
            .filter-bar .form-select:focus {
                border-color: var(--c-indigo);
                box-shadow: 0 0 0 3px rgba(79,70,229,0.1);
                outline: none;
            }

        .filter-bar .btn-outline-secondary {
            border-radius: var(--r-sm);
            padding: 8px 18px;
            font-size: .82rem;
            font-weight: 500;
            transition: all .2s;
            border-color: var(--border);
            color: var(--c-slate);
        }

            .filter-bar .btn-outline-secondary:hover {
                background: var(--c-indigo);
                border-color: var(--c-indigo);
                color: #fff;
            }

    /* ── Empty State ── */
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 36px 16px;
        color: var(--text-muted);
        gap: 8px;
    }

        .empty-state i {
            font-size: 1.8rem;
            opacity: .35;
        }

        .empty-state span {
            font-size: .85rem;
        }

    /* ── DataTables Overrides ── */
    .dataTables_wrapper {
        direction: rtl;
        font-family: 'Vazir','Segoe UI',Tahoma,sans-serif;
    }

        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter,
        .dataTables_wrapper .dataTables_info,
        .dataTables_wrapper .dataTables_paginate {
            padding: 10px 0 !important;
            font-size: .82rem;
            color: var(--c-slate);
        }

            .dataTables_wrapper .dataTables_filter input {
                border: 1px solid var(--border) !important;
                border-radius: var(--r-sm) !important;
                padding: 6px 12px !important;
                margin-right: 8px !important;
                font-family: inherit !important;
                font-size: .84rem;
            }

                .dataTables_wrapper .dataTables_filter input:focus {
                    border-color: var(--c-indigo) !important;
                    outline: none !important;
                    box-shadow: 0 0 0 3px rgba(79,70,229,0.1) !important;
                }

            .dataTables_wrapper .dataTables_length select {
                border: 1px solid var(--border) !important;
                border-radius: var(--r-sm) !important;
                padding: 4px 8px !important;
                font-family: inherit !important;
                margin: 0 4px;
            }

            .dataTables_wrapper .dataTables_paginate .paginate_button {
                border: 1px solid var(--border) !important;
                border-radius: var(--r-sm) !important;
                margin: 0 2px !important;
                padding: 4px 12px !important;
                color: var(--c-slate) !important;
                background: #fff !important;
                font-size: .82rem;
                transition: all .2s;
            }

                .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
                    background: #f1f5f9 !important;
                    color: var(--c-indigo) !important;
                    border-color: var(--c-indigo) !important;
                }

                .dataTables_wrapper .dataTables_paginate .paginate_button.current {
                    background: var(--c-indigo) !important;
                    color: #fff !important;
                    border-color: var(--c-indigo) !important;
                    box-shadow: 0 2px 8px rgba(79,70,229,0.3) !important;
                }

                .dataTables_wrapper .dataTables_paginate .paginate_button.disabled {
                    opacity: .35 !important;
                    background: #f8fafc !important;
                }

    table.dataTable thead th {
        border-bottom: 2px solid var(--border) !important;
        font-size: .78rem;
        background: linear-gradient(to bottom, #f8fafc, #f3f6fa) !important;
    }

    table.dataTable tbody td {
        font-size: .84rem;
        padding: 10px 10px !important;
    }

    table.dataTable tbody tr:hover {
        background: #f8fafc !important;
    }

    /* ── اسکرول‌بار اختصاصی برای کانتینر DataTable ── */
    .activity-scroll {
        overflow-x: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
    }

        .activity-scroll::-webkit-scrollbar {
            height: 6px;
            width: 6px;
        }

        .activity-scroll::-webkit-scrollbar-track {
            background: transparent;
            border-radius: 20px;
            margin: 0 4px;
        }

        .activity-scroll::-webkit-scrollbar-thumb {
            background: var(--scrollbar-thumb);
            border-radius: 20px;
            border: 2px solid transparent;
            background-clip: content-box;
            transition: background .25s ease;
        }

            .activity-scroll::-webkit-scrollbar-thumb:hover {
                background: var(--scrollbar-thumb-hover);
                background-clip: content-box;
            }

    /* ── Responsive ── */
    @@media (max-width: 992px) {
        .dashboard-wrapper {
            padding: 20px 16px 40px;
        }
    }

    @@media (max-width: 768px) {
        .table-card, .chart-card {
            height: 300px;
        }

        .table-card-tall {
            height: 380px;
        }

        .stat-number {
            font-size: 1.5rem;
        }

        .page-title {
            font-size: 1.3rem;
        }

            .page-title .title-badge {
                width: 42px;
                height: 42px;
                font-size: 1rem;
            }

        .stat-card .watermark {
            display: none;
        }
    }

    @@media (max-width: 576px) {
        .table-card, .chart-card {
            height: 260px;
        }

        .table-card-tall {
            height: 320px;
        }

        .table-scroll table {
            font-size: .72rem;
        }

        .table-scroll thead th,
        .table-scroll tbody td {
            padding: 6px 5px;
        }

        .stat-card {
            padding: 16px 10px 14px;
        }

            .stat-card .stat-number {
                font-size: 1.25rem;
            }

            .stat-card .icon-circle {
                width: 42px;
                height: 42px;
                font-size: 1rem;
                border-radius: 11px;
            }

        .filter-bar {
            padding: 10px 12px;
            gap: 8px;
        }

            .filter-bar .form-control,
            .filter-bar .form-select {
                font-size: .78rem;
                padding: 6px 10px;
            }
    }

    @@media (prefers-reduced-motion: reduce) {
        .anim {
            animation: none;
            opacity: 1;
        }

        .stat-card {
            transition: none;
        }

        .pulse-amber {
            animation: none;
        }

        .table-scroll {
            scroll-behavior: auto;
        }
    }
</style>

<div class="dashboard-wrapper">

    <!-- عنوان صفحه -->
    <div class="page-title anim d1">
        <span class="title-badge"><i class="fas fa-chart-pie"></i></span>
        داشبورد مدیریت
    </div>

    <!-- ===== ردیف آمار کلی ===== -->
    <!-- جایگزین کنید بخش چارت وضعیت اشتراک‌ها با این کد -->
    <!-- ===== ردیف نمودارهای اشتراک ===== -->
    <div class="row g-3 mb-4">
        <div class="col-lg-6 col-md-12 anim d5">
            <div class="dash-card chart-card">
                <div class="card-head">
                    <h5><i class="fas fa-chart-pie"></i> توزیع اشتراک‌ها بر اساس پلن و روش پرداخت</h5>
                    <span class="cnt" id="pieChartCount">بارگذاری...</span>
                </div>
                <div class="chart-body">
                    <canvas id="subscriptionPieChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-6 col-md-12 anim d6">
            <div class="dash-card chart-card">
                <div class="card-head">
                    <h5><i class="fas fa-chart-bar"></i> تعداد اشتراک‌ها به تفکیک</h5>
                    <span class="cnt" id="barChartCount">بارگذاری...</span>
                </div>
                <div class="chart-body">
                    <canvas id="subscriptionBarChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== جدول جزئیات اشتراک‌ها (اختیاری) ===== -->
    <div class="row g-3 mb-4">
        <div class="col-12 anim d7">
            <div class="dash-card" style="height:auto;min-height:300px;">
                <div class="card-head">
                    <h5><i class="fas fa-table"></i> جزئیات اشتراک‌های فعال</h5>
                    <span class="cnt" id="subscriptionStatsCount">بارگذاری...</span>
                </div>
                <div class="activity-scroll" style="max-height:400px;overflow-y:auto;overflow-x:auto;">
                    <table id="subscriptionStatsTable" class="table table-hover display" style="width:100%">
                        <thead>
                            <tr>
                                <th>پلن</th>
                                <th>روش پرداخت</th>
                                <th>تعداد اشتراک</th>
                                <th>درآمد کل (تومان)</th>
