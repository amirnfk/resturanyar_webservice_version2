@model resturanyar.Models.ViewModels.Admin.AdminDashboardViewModel
@using resturanyar.Utility
@{
    ViewData["Title"] = "داشبورد مدیریت";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    string FormatMoney(decimal value) => value.ToString("N0");
    string StatusFa(string status) => status switch
    {
        "Active" => "فعال",
        "Expired" => "منقضی",
        _ => "بدون اشتراک"
    };
    string StatusCss(string status) => status switch
    {
        "Active" => "ap-status--active",
        "Expired" => "ap-status--expired",
        _ => "ap-status--none"
    };
    string GrowthText = Model.RevenueGrowthPercent.HasValue
        ? (Model.RevenueGrowthPercent.Value >= 0
            ? $"+{Model.RevenueGrowthPercent.Value:0.#}٪ نسبت به ماه قبل"
            : $"{Model.RevenueGrowthPercent.Value:0.#}٪ نسبت به ماه قبل")
        : "بدون مبنای مقایسه";
    string GrowthClass = Model.RevenueGrowthPercent.HasValue
        ? (Model.RevenueGrowthPercent.Value >= 0 ? "up" : "down")
        : "";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="~/css/admin-panel.css" asp-append-version="true" />
}

<div class="ap-dash" id="adminDashboard">
    <header class="ap-header">
        <div class="ap-header__title-wrap">
            <div class="ap-header__icon"><i class="fas fa-chart-line"></i></div>
            <div>
                <h1 class="ap-header__title">داشبورد مدیریت</h1>
                <p class="ap-header__subtitle">نمای کلی فروش، اشتراک‌ها و وضعیت رستوران‌ها برای تصمیم‌گیری</p>
            </div>
        </div>
        <div class="ap-header__meta">
            <span class="ap-chip ap-chip--live">زنده</span>
            <span class="ap-chip"><i class="fas fa-calendar-alt"></i> @DateTime.Now.ToPersianDate()</span>
        </div>
    </header>

    @* ===== KPI ===== *@
    <section class="ap-kpi-grid">
        <article class="ap-kpi ap-kpi--orange">
            <div class="ap-kpi__top">
                <p class="ap-kpi__label">اکانت فروخته‌شده</p>
                <span class="ap-kpi__icon"><i class="fas fa-receipt"></i></span>
            </div>
            <p class="ap-kpi__value">@Model.PaidSubscriptionsCount.ToString("N0")</p>
            <p class="ap-kpi__hint">این ماه: @Model.ThisMonthNewPaid.ToString("N0") خرید پرداخت‌شده</p>
        </article>

        <article class="ap-kpi ap-kpi--emerald">
            <div class="ap-kpi__top">
                <p class="ap-kpi__label">اشتراک فعال</p>
                <span class="ap-kpi__icon"><i class="fas fa-bolt"></i></span>
            </div>
            <p class="ap-kpi__value">@Model.ActiveSubscriptions.ToString("N0")</p>
            <p class="ap-kpi__hint">فری‌ترایال فعال: @Model.FreeTrialActiveCount.ToString("N0")</p>
        </article>

        <article class="ap-kpi ap-kpi--sky">
            <div class="ap-kpi__top">
                <p class="ap-kpi__label">درآمد کل</p>
                <span class="ap-kpi__icon"><i class="fas fa-coins"></i></span>
            </div>
            <p class="ap-kpi__value">@FormatMoney(Model.TotalRevenue)</p>
            <p class="ap-kpi__hint">تومان · از اشتراک‌های پرداخت‌شده</p>
        </article>

        <article class="ap-kpi ap-kpi--amber">
            <div class="ap-kpi__top">
                <p class="ap-kpi__label">درآمد این ماه</p>
                <span class="ap-kpi__icon"><i class="fas fa-chart-area"></i></span>
            </div>
            <p class="ap-kpi__value">@FormatMoney(Model.ThisMonthRevenue)</p>
            <p class="ap-kpi__hint"><span class="@GrowthClass">@GrowthText</span></p>
        </article>

        <article class="ap-kpi ap-kpi--slate">
            <div class="ap-kpi__top">
                <p class="ap-kpi__label">رستوران‌ها</p>
                <span class="ap-kpi__icon"><i class="fas fa-store"></i></span>
            </div>
            <p class="ap-kpi__value">@Model.TotalRestaurants.ToString("N0")</p>
            <p class="ap-kpi__hint">فعال: @Model.ActiveRestaurantsCount · منقضی: @Model.ExpiredRestaurantsCount</p>
        </article>

        <article class="ap-kpi ap-kpi--slate">
            <div class="ap-kpi__top">
                <p class="ap-kpi__label">صاحبان رستوران</p>
                <span class="ap-kpi__icon"><i class="fas fa-users"></i></span>
            </div>
            <p class="ap-kpi__value">@Model.TotalOwners.ToString("N0")</p>
            <p class="ap-kpi__hint">بدون اشتراک: @Model.NoSubscriptionCount رستوران</p>
        </article>

        <article class="ap-kpi ap-kpi--rose">
            <div class="ap-kpi__top">
                <p class="ap-kpi__label">در حال انقضا</p>
                <span class="ap-kpi__icon"><i class="fas fa-hourglass-half"></i></span>
            </div>
            <p class="ap-kpi__value">@Model.ExpiringSubscriptions.Count.ToString("N0")</p>
            <p class="ap-kpi__hint">کمتر از ۷ روز تا پایان اشتراک</p>
        </article>

        <article class="ap-kpi ap-kpi--orange">
            <div class="ap-kpi__top">
                <p class="ap-kpi__label">کل اشتراک‌ها</p>
                <span class="ap-kpi__icon"><i class="fas fa-layer-group"></i></span>
            </div>
            <p class="ap-kpi__value">@Model.TotalSubscriptions.ToString("N0")</p>
            <p class="ap-kpi__hint">شامل پرداخت‌شده و آزمایشی</p>
        </article>
    </section>

    @* ===== Charts ===== *@
    <section class="ap-row ap-row--2">
        <div class="ap-card">
            <div class="ap-card__head">
                <h2 class="ap-card__title"><i class="fas fa-chart-line"></i> روند فروش ۶ ماه شمسی اخیر</h2>
                <span class="ap-card__badge">تقویم جلالی</span>
            </div>
            <div class="ap-card__body">
                <div class="ap-chart-wrap">
                    <canvas id="monthlyRevenueChart"></canvas>
                </div>
            </div>
        </div>
        <div class="ap-card">
            <div class="ap-card__head">
                <h2 class="ap-card__title"><i class="fas fa-triangle-exclamation"></i> در حال انقضا</h2>
                <span class="ap-card__badge ap-card__badge--warn">@Model.ExpiringSubscriptions.Count مورد</span>
            </div>
            <div class="ap-card__body">
                @if (Model.ExpiringSubscriptions.Any())
                {
                    <div class="ap-alert-list">
                        @foreach (var item in Model.ExpiringSubscriptions)
                        {
                            <div class="ap-alert-item">
                                <div>
                                    <div class="ap-alert-item__name">@item.RestaurantName</div>
                                    <div class="ap-alert-item__meta">
                                        @item.OwnerName · @item.PlanName
                                        @if (!string.IsNullOrEmpty(item.PaymentMethod))
                                        {
                                            <text> · @item.PaymentMethod</text>
                                        }
                                    </div>
                                </div>
                                <span class="ap-alert-item__days">@item.DaysLeft روز</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="ap-empty">
                        <i class="fas fa-circle-check"></i>
                        <span>اشتراک در حال انقضایی وجود ندارد</span>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="ap-row ap-row--3">
        <div class="ap-card">
            <div class="ap-card__head">
                <h2 class="ap-card__title"><i class="fas fa-chart-pie"></i> توزیع پلن فعال</h2>
                <span class="ap-card__badge" id="planChartBadge">بارگذاری...</span>
            </div>
            <div class="ap-card__body">
                <div class="ap-chart-wrap ap-chart-wrap--sm">
                    <canvas id="planDistributionChart"></canvas>
                </div>
            </div>
        </div>
        <div class="ap-card">
            <div class="ap-card__head">
                <h2 class="ap-card__title"><i class="fas fa-credit-card"></i> روش پرداخت</h2>
                <span class="ap-card__badge">فعال</span>
            </div>
            <div class="ap-card__body">
                <div class="ap-chart-wrap ap-chart-wrap--sm">
                    <canvas id="paymentMethodChart"></canvas>
                </div>
            </div>
        </div>
        <div class="ap-card">
            <div class="ap-card__head">
                <h2 class="ap-card__title"><i class="fas fa-store"></i> وضعیت رستوران‌ها</h2>
                <span class="ap-card__badge">@Model.TotalRestaurants مجموع</span>
            </div>
            <div class="ap-card__body">
                <div class="ap-chart-wrap ap-chart-wrap--sm">
                    <canvas id="subscriptionStatusChart"></canvas>
                </div>
            </div>
        </div>
    </section>

    @* ===== Data tabs ===== *@
    <section class="ap-tabs">
        <nav class="ap-tabs__nav" role="tablist">
            <button type="button" class="ap-tab-btn is-active" data-tab="restaurants">
                رستوران‌ها <span class="count">@Model.Restaurants.Count</span>
            </button>
            <button type="button" class="ap-tab-btn" data-tab="owners">
                صاحبان <span class="count">@Model.Owners.Count</span>
            </button>
            <button type="button" class="ap-tab-btn" data-tab="recent">
                خریدهای اخیر <span class="count">@Model.RecentSubscriptions.Count</span>
            </button>
            <button type="button" class="ap-tab-btn" data-tab="plans">
                جزئیات پلن
            </button>
            <button type="button" class="ap-tab-btn" data-tab="activity">
                فعالیت سفارش <span class="count" id="activityCount">...</span>
            </button>
        </nav>

        @* Restaurants *@
        <div class="ap-tab-panel is-active" id="tab-restaurants">
            <div class="ap-toolbar">
                <input type="text" id="restaurantSearch" class="form-control ap-search" placeholder="جستجو: نام رستوران، مالک، تماس..." />
                <select id="statusFilter" class="form-select" style="width:auto;min-width:150px;">
                    <option value="">همه وضعیت‌ها</option>
                    <option value="Active">فعال</option>
                    <option value="Expired">منقضی</option>
                    <option value="None">بدون اشتراک</option>
                </select>
                <select id="planFilter" class="form-select" style="width:auto;min-width:150px;">
                    <option value="">همه طرح‌ها</option>
                    @foreach (var plan in Model.Restaurants.Select(r => r.PlanName).Where(p => !string.IsNullOrEmpty(p)).Distinct().OrderBy(p => p))
                    {
                        <option value="@plan">@plan</option>
                    }
                </select>
            </div>
            <div class="ap-table-wrap">
                <table class="ap-table" id="restaurantsTable">
                    <thead>
                        <tr>
                            <th>رستوران</th>
                            <th>مالک</th>
                            <th>تماس</th>
                            <th>وضعیت</th>
                            <th>پلن</th>
                            <th>پایان اشتراک</th>
                            <th>خریدها</th>
                            <th>سفارش‌ها</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Restaurants.OrderByDescending(r => r.TotalSubscriptions).ThenBy(r => r.Name))
                        {
                            var searchText = $"{item.Name} {item.OwnerName} {item.OwnerPhone}";
                            <tr data-status="@item.SubscriptionStatus"
                                data-plan="@(item.PlanName ?? "")"
                                data-search="@searchText">
                                <td><strong>@item.Name</strong></td>
                                <td>@item.OwnerName</td>
                                <td class="ap-money">@(item.OwnerPhone ?? "-")</td>
                                <td><span class="ap-status @StatusCss(item.SubscriptionStatus)">@StatusFa(item.SubscriptionStatus)</span></td>
                                <td>@(item.PlanName ?? "-")</td>
                                <td>@(item.SubscriptionEndDate.HasValue ? item.SubscriptionEndDate.Value.ToPersianDate() : "-")</td>
                                <td>@item.TotalSubscriptions.ToString("N0")</td>
                                <td>@item.TotalOrders.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Owners *@
        <div class="ap-tab-panel" id="tab-owners">
            <div class="ap-toolbar">
                <input type="text" id="ownerSearch" class="form-control ap-search" placeholder="جستجو: نام یا شماره تماس..." />
            </div>
            <div class="ap-table-wrap">
                <table class="ap-table" id="ownersTable">
                    <thead>
                        <tr>
                            <th>نام</th>
                            <th>تماس</th>
                            <th>رستوران‌ها</th>
                            <th>اشتراک فعال</th>
                            <th>مجموع خرید</th>
                            <th>آخرین خرید</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Owners.OrderByDescending(o => o.TotalSpent).ThenBy(o => o.Name))
                        {
                            var searchText = $"{item.Name} {item.Phone}";
                            <tr data-search="@searchText">
                                <td><strong>@item.Name</strong></td>
                                <td class="ap-money">@(item.Phone ?? "-")</td>
                                <td>@item.RestaurantCount.ToString("N0")</td>
                                <td>@item.ActiveSubscriptionCount.ToString("N0")</td>
                                <td class="ap-money">@FormatMoney(item.TotalSpent)</td>
                                <td>@(item.LastPurchaseDate.HasValue ? item.LastPurchaseDate.Value.ToPersianDate() : "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Recent purchases *@
        <div class="ap-tab-panel" id="tab-recent">
            <div class="ap-toolbar">
                <input type="text" id="recentSearch" class="form-control ap-search" placeholder="جستجو در خریدهای اخیر..." />
            </div>
            <div class="ap-table-wrap">
                <table class="ap-table" id="recentTable">
                    <thead>
                        <tr>
                            <th>رستوران</th>
                            <th>مالک</th>
                            <th>پلن</th>
                            <th>مبلغ</th>
                            <th>روش پرداخت</th>
                            <th>وضعیت</th>
                            <th>تاریخ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.RecentSubscriptions)
                        {
                            var searchText = $"{item.RestaurantName} {item.OwnerName} {item.PlanName} {item.PaymentMethod}";
                            <tr data-search="@searchText">
                                <td><strong>@item.RestaurantName</strong></td>
                                <td>@item.OwnerName</td>
                                <td>@item.PlanName</td>
                                <td class="ap-money">@FormatMoney(item.PricePaid)</td>
                                <td>@(string.IsNullOrEmpty(item.PaymentMethod) ? "-" : item.PaymentMethod)</td>
                                <td>@item.Status</td>
                                <td>@item.PurchaseDate.ToPersianDate()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Plan details *@
        <div class="ap-tab-panel" id="tab-plans">
            <div class="ap-table-wrap">
                <table class="ap-table" id="subscriptionStatsTable">
                    <thead>
                        <tr>
                            <th>پلن</th>
                            <th>روش پرداخت</th>
                            <th>تعداد</th>
                            <th>درآمد (تومان)</th>
                            <th>درصد</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td colspan="5" style="text-align:center;color:#94a3b8;">در حال بارگذاری...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        @* Activity *@
        <div class="ap-tab-panel" id="tab-activity">
            <div class="ap-table-wrap" style="max-height:none;overflow:visible;">
                <table class="ap-table display" id="activityTable" style="width:100%">
                    <thead>
                        <tr>
                            <th>نام رستوران</th>
                            <th>سفارش ۱ روز</th>
                            <th>سفارش ۷ روز</th>
                            <th>سفارش ۳۰ روز</th>
                            <th>غذا ۱ روز</th>
                            <th>غذا ۷ روز</th>
                            <th>غذا ۳۰ روز</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="~/js/admin-panel.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            AdminPanelDash.init({
                monthlyStats: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    (Model.MonthlyStats ?? new List<resturanyar.Models.ViewModels.Admin.MonthlyStatsViewModel>())
                        .Select(m => new { label = m.Label, revenue = m.Revenue, newSubscriptions = m.NewSubscriptions }))),
                activeRestaurants: @Model.ActiveRestaurantsCount,
                expiredRestaurants: @Model.ExpiredRestaurantsCount,
                noSubscription: @Model.NoSubscriptionCount
            });
        });
    </script>
}
