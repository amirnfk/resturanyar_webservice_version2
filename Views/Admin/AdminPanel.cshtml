@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        // ===== 0. سیستم اسکرول‌بار هوشمند (سایه بالا/پایین + indicator) =====
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('[data-scroll-indicator]').forEach(function (wrapper) {
                var scrollEl = wrapper.querySelector('.table-scroll');
                if (!scrollEl) return;

                function updateShadows() {
                    var top = scrollEl.scrollTop > 4;
                    var bottom = (scrollEl.scrollTop + scrollEl.clientHeight) < (scrollEl.scrollHeight - 4);
                    wrapper.classList.toggle('scrolled-top', top);
                    wrapper.classList.toggle('scrolled-bottom', bottom);
                    scrollEl.classList.toggle('is-scrolling', top || bottom);
                }

                scrollEl.addEventListener('scroll', updateShadows, { passive: true });
                // بررسی اولیه بعد از رندر
                requestAnimationFrame(function () {
                    updateShadows();
                });
                // بروزرسانی بعد از تغییر اندازه پنجره
                window.addEventListener('resize', updateShadows, { passive: true });
            });
        });

        // ===== 1. چارت‌ها =====
        document.addEventListener('DOMContentLoaded', function () {

            // چارت وضعیت اشتراک‌ها
            var ctx1 = document.getElementById('subscriptionStatusChart').getContext('2d');

            var barGrad1 = ctx1.createLinearGradient(0, 0, 0, 280);
            barGrad1.addColorStop(0, '#34d399');
            barGrad1.addColorStop(1, '#059669');

            var barGrad2 = ctx1.createLinearGradient(0, 0, 0, 280);
            barGrad2.addColorStop(0, '#f87171');
            barGrad2.addColorStop(1, '#dc2626');

            var barGrad3 = ctx1.createLinearGradient(0, 0, 0, 280);
            barGrad3.addColorStop(0, '#cbd5e1');
            barGrad3.addColorStop(1, '#94a3b8');

            new Chart(ctx1, {
                type: 'bar',
                data: {
                    labels: ['فعال', 'منقضی', 'بدون اشتراک'],
                    datasets: [{
                        label: 'تعداد',
                        data: [
                            @Model.ActiveSubscriptions,
                            @(Model.TotalSubscriptions - Model.ActiveSubscriptions),
                            0
                        ],
                        backgroundColor: [barGrad1, barGrad2, barGrad3],
                        borderRadius: 8,
                        barPercentage: 0.55,
                        borderSkipped: false,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            titleFont: { family: 'Vazir' },
                            bodyFont: { family: 'Vazir' },
                            cornerRadius: 8,
                            padding: 10,
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0,0,0,0.04)', drawBorder: false },
                            ticks: { stepSize: 1, font: { family: 'Vazir', size: 11 } },
                            border: { display: false }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { family: 'Vazir', size: 11 } },
                            border: { display: false }
                        }
                    }
                }
            });

            // چارت درآمد ماهانه
            var ctx2 = document.getElementById('monthlyRevenueChart').getContext('2d');
            var monthlyLabels = [];
            var monthlyData = [];
            @if (Model.MonthlyStats != null)
            {
                        foreach (var item in Model.MonthlyStats)
                        {
                                    @:monthlyLabels.push('@item.Label');
                                    @:monthlyData.push(@item.Revenue);
                        }
            }

            function gregorianToJalali(gy, gm, gd) {
                var g_d_m = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
                var jy = (gy <= 1600) ? 0 : 979;
                gy -= (gy <= 1600) ? 0 : 1600;
                var gy2 = (gm > 2) ? (gy + 1) : gy;
                var days = (365 * gy) + (parseInt((gy2 + 3) / 4)) - (parseInt((gy2 + 99) / 100)) + (parseInt((gy2 + 399) / 400)) - 80 + gd + g_d_m[gm - 1];
                jy += 33 * (parseInt(days / 12053));
                days %= 12053;
                jy += 4 * (parseInt(days / 1461));
                days %= 1461;
                jy += parseInt((days - 1) / 365);
                if (days > 365) days = (days - 1) % 365;
                var jm = (days < 186) ? 1 + parseInt(days / 31) : 7 + parseInt((days - 186) / 30);
                var jd = 1 + ((days < 186) ? (days % 31) : ((days - 186) % 30));
                return [jy, jm, jd];
            }
            var persianMonths = ['فروردین','اردیبهشت','خرداد','تیر','مرداد','شهریور','مهر','آبان','آذر','دی','بهمن','اسفند'];
            var persianLabels = monthlyLabels.map(function (label) {
                if (label.indexOf('/') !== -1 || label.indexOf('-') !== -1) {
                    var parts = label.split(/[\/\-]/);
                    if (parts.length >= 2) {
                        var year = parseInt(parts[0]);
                        var month = parseInt(parts[1]);
                        var jalali = gregorianToJalali(year, month, 1);
                        return persianMonths[jalali[1] - 1] + ' ' + jalali[0];
                    }
                }
                return label;
            });

            var lineGrad = ctx2.createLinearGradient(0, 0, 0, 280);
            lineGrad.addColorStop(0, 'rgba(79,70,229,0.15)');
            lineGrad.addColorStop(1, 'rgba(79,70,229,0.01)');

            new Chart(ctx2, {
                type: 'line',
                data: {
                    labels: persianLabels,
                    datasets: [{
                        label: 'درآمد (تومان)',
                        data: monthlyData,
                        borderColor: '#4f46e5',
                        backgroundColor: lineGrad,
                        borderWidth: 3,
                        pointBackgroundColor: '#4f46e5',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        tension: 0.35,
                        fill: true,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            titleFont: { family: 'Vazir' },
                            bodyFont: { family: 'Vazir' },
                            cornerRadius: 8,
                            padding: 10,
                            callbacks: {
                                label: function(context) {
                                    return context.parsed.y.toLocaleString() + ' تومان';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0,0,0,0.04)', drawBorder: false },
                            border: { display: false },
                            ticks: {
                                font: { family: 'Vazir', size: 11 },
                                callback: function(value) {
                                    if (value >= 1000000) return (value / 1000000).toFixed(1) + 'M';
                                    else if (value >= 1000) return (value / 1000).toFixed(0) + 'K';
                                    return value;
                                }
                            }
                        },
                        x: {
                            grid: { display: false },
                            border: { display: false },
                            ticks: { font: { family: 'Vazir', size: 11 } }
                        }
                    },
                    interaction: { intersect: false, mode: 'index' }
                }
            });
        });

        // ===== 2. فیلترهای جدول رستوران‌ها =====
        function filterTable() {
            var searchText = document.getElementById('restaurantSearch').value.toLowerCase().trim();
            var statusFilter = document.getElementById('statusFilter').value;
            var planFilter = document.getElementById('planFilter').value;
            var rows = document.querySelectorAll('#restaurantsTable tbody tr');
            rows.forEach(function (row) {
                var name = row.cells[0].textContent.toLowerCase();
                var owner = row.cells[1].textContent.toLowerCase();
                var phone = row.cells[2].textContent.toLowerCase();
                var status = row.getAttribute('data-status');
                var plan = row.getAttribute('data-plan') || '';
                var matchesSearch = !searchText || name.includes(searchText) || owner.includes(searchText) || phone.includes(searchText);
                var matchesStatus = !statusFilter || status === statusFilter;
                var matchesPlan = !planFilter || plan === planFilter;
                row.style.display = (matchesSearch && matchesStatus && matchesPlan) ? '' : 'none';
            });
        }
        function resetFilters() {
            document.getElementById('restaurantSearch').value = '';
            document.getElementById('statusFilter').value = '';
            document.getElementById('planFilter').value = '';
            filterTable();
        }
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('restaurantSearch').addEventListener('input', filterTable);
            document.getElementById('statusFilter').addEventListener('change', filterTable);
            document.getElementById('planFilter').addEventListener('change', filterTable);
        });

        // ===== 3. DataTable برای جدول آمار فعالیت =====
        $(document).ready(function () {
            $.ajax({
                url: '@Url.Action("GetRestaurantActivityStatsDetailed", "Admin")',
                type: 'GET',
                dataType: 'json',
                success: function (response) {
                    if (response.success) {
                        var data = response.data;
                        document.getElementById('activityCount').textContent = data.length + ' رستوران';
                        $('#activityTable').DataTable({
                            data: data,
                            columns: [
                                { data: 'restaurantName' },
                                { data: 'orders1Day' },
                                { data: 'orders7Day' },
                                { data: 'orders30Day' },
                                { data: 'foodItems1Day' },
                                { data: 'foodItems7Day' },
                                { data: 'foodItems30Day' }
                            ],
                            language: {
                                url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/fa.json'
                            },
                            order: [[1, 'desc']],
                            pageLength: 10,
                            responsive: true,
                            columnDefs: [
                                { targets: [1,2,3,4,5,6], className: 'text-center' }
                            ]
                        });
                    } else {
                        showToast('خطا: ' + response.message, 'error');
                    }
                },
                error: function () {
                    showToast('خطا در ارتباط با سرور', 'error');
                }
            });
        });


                // اضافه کنید به بخش Scripts در AdminPanel.cshtml

        // اضافه کنید به بخش Scripts در AdminPanel.cshtml

        // ===== 4. نمودارهای آمار اشتراک‌ها =====
        $(document).ready(function () {
            // ... کدهای قبلی ...

            // بارگذاری آمار اشتراک‌ها
            $.ajax({
                url: '@Url.Action("GetSubscriptionStats", "Admin")',
                type: 'GET',
                dataType: 'json',
                success: function (response) {
                    if (response.success) {
                        var data = response.data;
                        var summary = response.summary;

                        // به‌روزرسانی شمارنده‌ها
                        $('#pieChartCount').text(summary.totalActiveSubscriptions + ' اشتراک');
                        $('#barChartCount').text(summary.totalActiveSubscriptions + ' اشتراک');
                        $('#subscriptionStatsCount').text(summary.totalActiveSubscriptions + ' اشتراک');

                        // ===== 4.1. نمودار دایره‌ای =====
                        createPieChart(data, summary.totalActiveSubscriptions);

                        // ===== 4.2. نمودار میله‌ای =====
                        createBarChart(data);

                        // ===== 4.3. جدول جزئیات =====
                        createStatsTable(data, summary);

                    } else {
                        showToast('خطا: ' + response.message, 'error');
                    }
                },
                error: function () {
                    showToast('خطا در ارتباط با سرور برای دریافت آمار اشتراک\u200cها', 'error');
                }
            });
        });

        // ===== تابع ایجاد نمودار دایره‌ای =====
        function createPieChart(data, total) {
            var ctx = document.getElementById('subscriptionPieChart').getContext('2d');

            // مرتب‌سازی داده‌ها بر اساس پلن
            var planOrder = { 'رایگان': 1, 'برنزی': 2, 'نقره‌ای': 3, 'طلایی': 4 };
            data.sort(function(a, b) {
                return (planOrder[a.planName] || 999) - (planOrder[b.planName] || 999);
            });

            var labels = data.map(item => item.displayName);
            var values = data.map(item => item.count);
            var colors = data.map(item => item.color);
            var revenues = data.map(item => item.totalRevenue);

            // ایجاد گرادیانت برای رنگ‌ها (افکت حرفه‌ای‌تر)
            var colorMap = {
                '#94a3b8': '#cbd5e1', // رایگان
                '#cd7f32': '#e8a87c', // برنزی
                '#c0c0c0': '#e2e8f0', // نقره‌ای
                '#ffd700': '#fbbf24'  // طلایی
            };

            var gradientColors = colors.map(color => {
                if (colorMap[color]) {
                    var grad = ctx.createRadialGradient(0, 0, 0, 0, 0, 100);
                    grad.addColorStop(0, colorMap[color]);
                    grad.addColorStop(1, color);
                    return grad;
                }
                return color;
            });

            // حذف نمودار قبلی اگر وجود دارد
            if (window.pieChart) {
                window.pieChart.destroy();
            }

            window.pieChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: values,
                        backgroundColor: colors,
                        borderColor: '#ffffff',
                        borderWidth: 2,
                        hoverOffset: 15
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '60%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            rtl: true,
                            labels: {
                                font: {
                                    family: 'Vazir',
                                    size: 11
                                },
                                padding: 12,
                                usePointStyle: true,
                                pointStyle: 'circle'
                            }
                        },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            titleFont: { family: 'Vazir', size: 13 },
                            bodyFont: { family: 'Vazir', size: 12 },
                            cornerRadius: 8,
                            padding: 12,
                            callbacks: {
                                label: function(context) {
                                    var total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    var percentage = ((context.parsed / total) * 100).toFixed(1);
                                    var revenue = revenues[context.dataIndex];
                                    return [
                                        `${context.label}: ${context.parsed} اشتراک (${percentage}%)`,
                                        `درآمد: ${revenue.toLocaleString()} تومان`
                                    ];
                                }
                            }
                        }
                    },
                    animation: {
                        animateRotate: true,
                        duration: 1500
                    }
                }
            });
        }

        // ===== تابع ایجاد نمودار میله‌ای =====
        function createBarChart(data) {
            var ctx = document.getElementById('subscriptionBarChart').getContext('2d');

            // گروه‌بندی بر اساس پلن
            var planOrder = ['رایگان', 'برنزی', 'نقره‌ای', 'طلایی'];
            var paymentMethods = ['فری‌ترایال', 'کافه‌بازار', 'زرین‌پال', 'نامشخص'];

            // ایجاد داده‌های گروه‌بندی شده
            var groupedData = {};
            planOrder.forEach(plan => {
                groupedData[plan] = {};
                paymentMethods.forEach(method => {
                    groupedData[plan][method] = 0;
                });
            });

            data.forEach(item => {
                var method = item.paymentMethod;
                if (method === 'FreeTrial') method = 'فری‌ترایال';
                else if (method === 'CafeBazar') method = 'کافه‌بازار';
                else if (method === 'Zarinpal') method = 'زرین‌پال';
                else method = 'نامشخص';

                if (groupedData[item.planName] && groupedData[item.planName][method] !== undefined) {
                    groupedData[item.planName][method] = item.count;
                }
            });

            // رنگ‌ها برای هر روش پرداخت
            var methodColors = {
                'فری‌ترایال': 'rgba(52, 211, 153, 0.8)',
                'کافه‌بازار': 'rgba(96, 165, 250, 0.8)',
                'زرین‌پال': 'rgba(251, 191, 36, 0.8)',
                'نامشخص': 'rgba(148, 163, 184, 0.8)'
            };

            var methodBorderColors = {
                'فری‌ترایال': '#059669',
                'کافه‌بازار': '#2563eb',
                'زرین‌پال': '#d97706',
                'نامشخص': '#94a3b8'
            };

            var datasets = paymentMethods.map(method => {
                return {
                    label: method,
                    data: planOrder.map(plan => groupedData[plan][method] || 0),
                    backgroundColor: methodColors[method] || 'rgba(148, 163, 184, 0.8)',
                    borderColor: methodBorderColors[method] || '#94a3b8',
                    borderWidth: 2,
                    borderRadius: 4,
                    barPercentage: 0.8,
                    categoryPercentage: 0.7
                };
            });

            // حذف نمودار قبلی اگر وجود دارد
            if (window.barChart) {
                window.barChart.destroy();
            }

            window.barChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: planOrder,
                    datasets: datasets
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'top',
                            rtl: true,
                            labels: {
                                font: {
                                    family: 'Vazir',
                                    size: 11
                                },
                                padding: 12,
                                usePointStyle: true,
                                pointStyle: 'circle'
                            }
                        },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            titleFont: { family: 'Vazir', size: 13 },
                            bodyFont: { family: 'Vazir', size: 12 },
                            cornerRadius: 8,
                            padding: 12,
                            callbacks: {
                                label: function(context) {
                                    return `${context.dataset.label}: ${context.parsed.y} اشتراک`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: {
                                font: { family: 'Vazir', size: 12 }
                            }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0,0,0,0.05)' },
                            ticks: {
                                font: { family: 'Vazir', size: 11 },
                                stepSize: 1
                            }
                        }
                    },
                    animation: {
                        duration: 1200,
                        easing: 'easeInOutQuart'
                    }
                }
            });
        }

        // ===== تابع ایجاد جدول جزئیات =====
        function createStatsTable(data, summary) {
            var tbody = $('#subscriptionStatsTable tbody');
            tbody.empty();

            // مرتب‌سازی بر اساس پلن
            var planOrder = { 'رایگان': 1, 'برنزی': 2, 'نقره‌ای': 3, 'طلایی': 4 };
            data.sort(function(a, b) {
                return (planOrder[a.planName] || 999) - (planOrder[b.planName] || 999);
            });

            var totalCount = summary.totalActiveSubscriptions;
            var totalRevenue = summary.totalRevenue;
            var totalCountSum = 0;
            var totalRevenueSum = 0;

            $.each(data, function(index, item) {
                var percentage = totalCount > 0 ? ((item.count / totalCount) * 100).toFixed(1) : 0;

                var row = `<tr>
                    <td><strong>${item.planName}</strong></td>
                    <td>${item.displayName}</td>
                    <td class="text-center">${item.count}</td>
                    <td class="text-center">${item.totalRevenue.toLocaleString()}</td>
                    <td class="text-center">${percentage}%</td>
                </tr>`;
                tbody.append(row);

                totalCountSum += item.count;
                totalRevenueSum += item.totalRevenue;
            });

            $('#totalCountFoot').text(totalCountSum);
            $('#totalRevenueFoot').text(totalRevenueSum);

            // اگر داده‌ای وجود نداشت
            if (data.length === 0) {
                tbody.append(`<tr><td colspan="5" class="text-center text-muted">هیچ اشتراک فعالی یافت نشد</td></tr>`);
            }
        }
    </script>
}