@model resturanyar.Models.ViewModels.ArticleListViewModel
@{
    Layout = "~/Views/Shared/_IndexLayout.cshtml";
    ViewData["Title"] = "مقالات رستورانیار";
}

@section Styles {
    @await Html.PartialAsync("_ArticleStyles")
}

<section class="article-hero">
    <div class="container">
        <h1>مقالات و راهنمای مدیریت رستوران</h1>
        <p class="lead mt-3" style="color: var(--muted);">
            آموزش نرم‌افزار مدیریت رستوران، منوی دیجیتال، POS، باشگاه مشتریان و گزارش‌گیری
        </p>
    </div>
</section>

<section class="article-content">
    <div class="container">
        @if (Model.Articles.Count == 0)
        {
            <p>هنوز مقاله‌ای منتشر نشده است.</p>
        }
        else
        {
            <div class="row g-4">
                @foreach (var article in Model.Articles)
                {
                    <div class="col-md-6 col-lg-4">
                        <article class="article-card">
                            @if (!string.IsNullOrWhiteSpace(article.FeaturedImageUrl))
                            {
                                <a href="/articles/@article.Slug">
                                    <img src="@article.FeaturedImageUrl" alt="@article.Title" loading="lazy">
                                </a>
                            }
                            <div class="article-card-body">
                                <p class="article-meta mb-2">
                                    <i class="fa-regular fa-calendar ms-1"></i>
                                    @article.PublishedAt.ToString("yyyy/MM/dd")
                                </p>
                                <h2><a href="/articles/@article.Slug">@article.Title</a></h2>
                                <p>@article.MetaDescription</p>
                                <a href="/articles/@article.Slug" class="text-decoration-none" style="color: var(--primary); font-weight: 700;">
                                    ادامه مطلب <i class="fa-solid fa-arrow-left me-1"></i>
                                </a>
                            </div>
                        </article>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="mt-5" aria-label="صفحه‌بندی مقالات">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="/articles?page=@(Model.CurrentPage - 1)">قبلی</a>
                        </li>
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="/articles@(i == 1 ? "" : "?page=" + i)">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="/articles?page=@(Model.CurrentPage + 1)">بعدی</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</section>

@section StructuredData {
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "BreadcrumbList",
          "itemListElement": [
            { "@@type": "ListItem", "position": 1, "name": "خانه", "item": "https://resturanyar.ir/" },
            { "@@type": "ListItem", "position": 2, "name": "مقالات", "item": "https://resturanyar.ir/articles" }
          ]
        }
    </script>
}
