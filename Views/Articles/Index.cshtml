@model resturanyar.Models.ViewModels.ArticleListViewModel
@{
    Layout = "~/Views/Shared/_IndexLayout.cshtml";
    ViewData["Title"] = "مقالات رستورانیار";
}

@section Styles {
    @await Html.PartialAsync("_ArticleStyles")
}

<div class="articles-page">
    <section class="articles-hero">
        <div class="container">
            <div class="articles-hero-inner">
                <span class="articles-badge">
                    <i class="fa-solid fa-sparkles"></i>
                    وبلاگ رستورانیار
                </span>
                <h1>مقالات و راهنمای مدیریت رستوران</h1>
                <p class="articles-lead">
                    آموزش نرم‌افزار مدیریت رستوران، منوی دیجیتال، POS، باشگاه مشتریان و گزارش‌گیری —
                    محتوای کاربردی برای رشد کسب‌وکار شما
                </p>
            </div>
        </div>
    </section>

    <section class="articles-grid-section">
        <div class="container">
            @if (Model.Articles.Count == 0)
            {
                <div class="articles-empty">
                    <div class="articles-empty-icon">
                        <i class="fa-regular fa-newspaper"></i>
                    </div>
                    <h3>هنوز مقاله‌ای منتشر نشده</h3>
                    <p>به‌زودی مطالب جدید در این بخش قرار می‌گیرد.</p>
                </div>
            }
            else
            {
                <div class="articles-grid">
                    @foreach (var article in Model.Articles)
                    {
                        <article class="article-card-modern">
                            <a class="article-card-media" href="/articles/@article.Slug">
                                @if (!string.IsNullOrWhiteSpace(article.FeaturedImageUrl))
                                {
                                    <img src="@article.FeaturedImageUrl" alt="@article.Title" loading="lazy">
                                    <div class="article-card-media-overlay"></div>
                                }
                                else
                                {
                                    <div class="article-card-media-placeholder">
                                        <i class="fa-regular fa-image"></i>
                                    </div>
                                }
                            </a>
                            <div class="article-card-body">
                                <div class="article-card-meta">
                                    <span><i class="fa-regular fa-calendar"></i> @article.PublishedAt.ToString("yyyy/MM/dd")</span>
                                </div>
                                <h2><a href="/articles/@article.Slug">@article.Title</a></h2>
                                <p class="article-card-excerpt">@article.MetaDescription</p>
                                <a href="/articles/@article.Slug" class="article-read-more">
                                    ادامه مطلب
                                    <i class="fa-solid fa-arrow-left"></i>
                                </a>
                            </div>
                        </article>
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="articles-pagination" aria-label="صفحه‌بندی مقالات">
                        @if (Model.CurrentPage <= 1)
                        {
                            <span class="page-disabled">قبلی</span>
                        }
                        else
                        {
                            <a href="/articles?page=@(Model.CurrentPage - 1)">قبلی</a>
                        }

                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == Model.CurrentPage)
                            {
                                <span class="page-active">@i</span>
                            }
                            else
                            {
                                <a href="/articles@(i == 1 ? "" : "?page=" + i)">@i</a>
                            }
                        }

                        @if (Model.CurrentPage >= Model.TotalPages)
                        {
                            <span class="page-disabled">بعدی</span>
                        }
                        else
                        {
                            <a href="/articles?page=@(Model.CurrentPage + 1)">بعدی</a>
                        }
                    </nav>
                }
            }
        </div>
    </section>
</div>

@section StructuredData {
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "BreadcrumbList",
          "itemListElement": [
            { "@@type": "ListItem", "position": 1, "name": "خانه", "item": "https://resturanyar.ir/" },
            { "@@type": "ListItem", "position": 2, "name": "مقالات", "item": "https://resturanyar.ir/articles" }
          ]
        }
    </script>
}
