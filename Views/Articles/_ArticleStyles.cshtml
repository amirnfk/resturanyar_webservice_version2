<style>
    .article-hero {
        background: var(--bg);
        padding: 60px 0 40px;
        border-bottom: 1px solid rgba(0,0,0,.05);
    }

    [data-theme="dark"] .article-hero {
        border-bottom-color: rgba(255,255,255,.06);
    }

    .article-hero h1 {
        font-size: 2.4rem;
        font-weight: 900;
        line-height: 1.3;
        color: var(--text);
    }

    .article-content {
        background: var(--bg);
        padding: 40px 0 60px;
    }

    .article-content h2 {
        font-weight: 800;
        margin-top: 2.8rem;
        margin-bottom: 1rem;
        padding-bottom: 0.4rem;
        border-bottom: 3px solid var(--primary);
        display: inline-block;
        color: var(--text);
    }

    .article-content p,
    .article-content li {
        line-height: 2;
        color: var(--muted);
    }

    .article-content ul,
    .article-content ol {
        padding-right: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .highlight-box {
        background: rgba(255,122,26,.08);
        border-right: 5px solid var(--primary);
        padding: 20px 25px;
        border-radius: 12px;
        margin: 30px 0;
        color: var(--text);
    }

    .article-card {
        background: var(--card);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--shadow);
        border: 1px solid rgba(0,0,0,.06);
        height: 100%;
        transition: transform .2s;
    }

    .article-card:hover {
        transform: translateY(-4px);
    }

    .article-card img {
        width: 100%;
        height: 180px;
        object-fit: cover;
    }

    .article-card-body {
        padding: 1.25rem;
    }

    .article-card-body h2 {
        font-size: 1.1rem;
        font-weight: 800;
        margin-bottom: .75rem;
        line-height: 1.5;
    }

    .article-card-body h2 a {
        color: var(--text);
        text-decoration: none;
    }

    .article-card-body p {
        font-size: .9rem;
        color: var(--muted);
        margin-bottom: .75rem;
    }

    .article-meta {
        font-size: .85rem;
        color: var(--muted);
    }

    .breadcrumb-nav {
        font-size: .9rem;
        margin-bottom: 1rem;
    }

    .breadcrumb-nav a {
        color: var(--primary);
        text-decoration: none;
    }

    .cta-box {
        background: linear-gradient(135deg, var(--primary), #e0661a);
        border-radius: 24px;
        padding: 40px 30px;
        color: #fff;
        text-align: center;
        margin: 40px 0;
    }

    @@media (max-width: 768px) {
        .article-hero h1 {
            font-size: 1.8rem;
        }
    }
</style>
