@{
    Layout = "~/Views/Shared/_IndexLayout.cshtml";
    ViewData["Title"] = "باشگاه مشتریان رستوران و کافه | رستورانیار دلاویتا";
}

@section Styles {
    <style>
        /* استایل‌های اختصاصی با پشتیبانی از دارک‌مود */
        .article-hero {
            background: var(--bg);
            padding: 60px 0 40px;
            border-bottom: 1px solid rgba(0,0,0,.05);
            transition: background 0.3s;
        }

        [data-theme="dark"] .article-hero {
            border-bottom-color: rgba(255,255,255,.06);
        }

        .article-hero h1 {
            font-size: 2.6rem;
            font-weight: 900;
            line-height: 1.3;
            color: var(--text);
        }

        .article-content {
            background: var(--bg);
            padding: 40px 0 60px;
        }

            .article-content h2 {
                font-weight: 800;
                margin-top: 2.8rem;
                margin-bottom: 1rem;
                padding-bottom: 0.4rem;
                border-bottom: 3px solid var(--primary);
                display: inline-block;
                color: var(--text);
            }

            .article-content h3 {
                font-weight: 700;
                margin-top: 2rem;
                color: var(--text);
            }

            .article-content p {
                line-height: 2;
                margin-bottom: 1.2rem;
                color: var(--muted);
            }

            .article-content ul, .article-content ol {
                padding-right: 1.5rem;
                margin-bottom: 1.5rem;
                color: var(--muted);
            }

            .article-content li {
                margin-bottom: 0.6rem;
                line-height: 1.9;
            }

        .highlight-box {
            background: rgba(255,122,26,.08);
            border-right: 5px solid var(--primary);
            padding: 20px 25px;
            border-radius: 12px;
            margin: 30px 0;
            color: var(--text);
        }

        [data-theme="dark"] .highlight-box {
            background: rgba(255,122,26,.15);
        }

        .feature-grid-article {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin: 30px 0;
        }

        .feature-card-article {
            background: var(--card);
            border-radius: 16px;
            padding: 20px 15px;
            box-shadow: var(--shadow);
            border: 1px solid rgba(0,0,0,.06);
            text-align: center;
            transition: .3s;
            color: var(--text);
        }

        [data-theme="dark"] .feature-card-article {
            border-color: rgba(255,255,255,.06);
        }

        .feature-card-article:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,.12);
        }

        .feature-card-article i {
            font-size: 2.2rem;
            color: var(--primary);
            margin-bottom: 12px;
        }

        .feature-card-article h6 {
            font-weight: 700;
            margin-bottom: 6px;
        }

        .feature-card-article p {
            font-size: .9rem;
            color: var(--muted);
            margin: 0;
        }

        .cta-box {
            background: linear-gradient(135deg, var(--primary), #e0661a);
            border-radius: 30px;
            padding: 50px 30px;
            color: #ffffff;
            text-align: center;
            margin: 40px 0;
        }

            .cta-box h3,
            .cta-box p,
            .cta-box span,
            .cta-box div {
                color: #ffffff;
            }

            .cta-box a:not(.btn) {
                color: #ffe6d5;
                text-decoration: underline;
                text-underline-offset: 2px;
            }

                .cta-box a:not(.btn):hover {
                    color: #ffffff;
                }

            .cta-box .btn-light {
                background: #ffffff;
                color: #1a1a1a;
                font-weight: 700;
                border: 0;
                transition: .3s;
            }

                .cta-box .btn-light:hover {
                    background: #f0f0f0;
                    color: #1a1a1a;
                    transform: scale(1.02);
                }

            .cta-box .btn-cta-outline {
                background: transparent;
                color: #ffffff;
                border: 2px solid #ffffff;
            }

                .cta-box .btn-cta-outline:hover {
                    background: #ffffff;
                    color: var(--primary);
                }

            .cta-box .fa-circle-check {
                color: #b3ffb3;
            }

        .badge-free {
            background: #28a745;
            color: #fff;
            padding: 4px 14px;
            border-radius: 30px;
            font-size: .85rem;
            font-weight: 700;
            display: inline-block;
        }

        .badge-trial {
            background: var(--primary);
            color: #fff;
            padding: 4px 14px;
            border-radius: 30px;
            font-size: .85rem;
            font-weight: 700;
            display: inline-block;
        }

        @@media (max-width: 768px) {
            .article-hero h1 {
                font-size: 2rem;
            }

            .feature-grid-article {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 480px) {
            .feature-grid-article {
                grid-template-columns: 1fr;
            }
        }

        /* استایل مخصوص دموی باشگاه مشتریان */
        .customer-club-badge {
            background: rgba(255,122,26,.12);
            border-radius: 50px;
            padding: 8px 18px;
            display: inline-block;
            font-weight: 700;
            color: var(--primary);
            font-size: 0.85rem;
        }

        .stat-circle {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary-light), rgba(255,122,26,.2));
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            font-weight: 900;
            color: var(--primary);
        }
    </style>
}

    <!-- ===== هیرو مقاله (ویژه باشگاه مشتریان) ===== -->
    <section class="article-hero">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <div class="customer-club-badge mb-3">
                        <i class="fas fa-crown ms-1"></i> باشگاه مشتریان هوشمند
                    </div>
                    <h1>باشگاه مشتریان رستوران و کافه؛ مدیریت هوشمند مشتریان وفادار</h1>
                    <p class="lead mt-3" style="color: var(--muted);">
                        با <strong>باشگاه مشتریان رستورانیار دلاویتا</strong>، تمام مشتریان خود را بشناسید، رفتار خرید آنها را تحلیل کنید و نرخ بازگشت را افزایش دهید.
                        <strong>ثبت خودکار مشتریان هنگام سفارش</strong> توسط گارسون، رتبه‌بندی و تحلیل پیشرفته.
                    </p>
                    <div class="mt-4">
                        <a href="/Home/ManagerLogin" class="btn btn-cta px-5 py-2">شروع کنید</a>
                    </div>
                </div>
                <div class="col-lg-4 text-center mt-4 mt-lg-0">
                    <img src="~/images/customer_club.png" alt="باشگاه مشتریان رستورانیار دلاویتا" class="img-fluid rounded-4 shadow" style="max-height:320px; object-fit: cover; width:auto;">
                </div>
            </div>
        </div>
    </section>

    <!-- ===== محتوای اصلی مقاله ===== -->
    <section class="article-content">
        <div class="container">

            <p>
                در صنعت رستوران‌داری و کافه‌داری، <strong>مشتریان وفادار</strong> ارزش‌مندترین دارایی یک کسب‌وکار هستند. اما چگونه می‌توان مشتریان را شناخت، رفتار آنها را تحلیل کرد و نرخ بازگشت را افزایش داد؟ <strong>باشگاه مشتریان رستورانیار دلاویتا</strong> پاسخی جامع به این سوال است. این سیستم هوشمند، تمام اطلاعات مشتریان شما را ثبت، تحلیل و رتبه‌بندی می‌کند تا بتوانید بهترین تصمیمات را برای جذب و نگهداشت مشتریان بگیرید.
            </p>

            <h2> باشگاه مشتریان چیست و چرا به آن نیاز داریم؟</h2>
            <p>
                <strong>باشگاه مشتریان</strong> یا <strong>سیستم مدیریت مشتریان (CRM)</strong>، یک ابزار قدرتمند برای ثبت، پیگیری و تحلیل اطلاعات مشتریان است. در رستورانیار دلاویتا، این سیستم به صورت یکپارچه با فرآیند ثبت سفارش ترکیب شده و به شما امکان می‌دهد:
            </p>
            <ul>
                <li><strong>همه مشتریان را بشناسید:</strong> اطلاعات کامل (نام، شماره موبایل، تاریخ عضویت، تعداد سفارش‌ها و مبلغ خرید) هر مشتری در یک پروفایل جامع ثبت می‌شود.</li>
                <li><strong>رفتار خرید را تحلیل کنید:</strong> میانگین خرید، تعداد روزهای حضور، آخرین تاریخ مراجعه و موارد مشابه به شما کمک می‌کند الگوهای رفتاری مشتریان را درک کنید.</li>
                <li><strong>نرخ بازگشت را اندازه‌گیری کنید:</strong> متوجه شوید چند درصد از مشتریان شما حداقل ۲ بار، ۳ بار یا ۵ بار به رستوران شما بازگشته‌اند.</li>
                <li><strong>مشتریان ویژه را شناسایی کنید:</strong> بهترین مشتریان از نظر مبلغ خرید، تعداد سفارش و تعداد روزهای حضور را رتبه‌بندی کنید.</li>
                <li><strong>استراتژی‌های بازاریابی هدفمند طراحی کنید:</strong> با شناخت سلیقه و رفتار مشتریان، پیشنهادات ویژه و تخفیف‌های شخصی‌سازی‌شده ارائه دهید.</li>
            </ul>
            <div class="highlight-box">
                 در رستورانیار دلاویتا، <strong>ثبت مشتریان جدید توسط گارسون</strong> هنگام دریافت سفارش انجام می‌شود. این یعنی بدون نیاز به اقدام جداگانه، تمام مشتریان شما به صورت خودکار در باشگاه مشتریان ثبت می‌شوند!
            </div>

            <h2>  قابلیت‌های باشگاه مشتریان رستورانیار دلاویتا</h2>
            <p>
                باشگاه مشتریان رستورانیار فراتر از یک سیستم ثبت اطلاعات ساده است. مهم‌ترین قابلیت‌های آن عبارتند از:
            </p>

            <h3>  ثبت خودکار مشتریان هنگام سفارش</h3>
            <p>
                گارسون‌ها هنگام ثبت سفارش مشتری، می‌توانند به راحتی اطلاعات مشتری را وارد کنند. اگر مشتری قبلاً ثبت شده باشد، سیستم به صورت خودکار او را شناسایی کرده و اطلاعات جدید را به پروفایل او اضافه می‌کند. این فرآیند <strong>بدون نیاز به اقدام جداگانه</strong> و به صورت یکپارچه با فرآیند سفارش‌گیری انجام می‌شود.
            </p>

            <h3>  داشبورد تحلیلی پیشرفته</h3>
            <p>
                در صفحه مدیریت مشتریان، یک داشبورد جامع با اطلاعات کلیدی در اختیار شما قرار می‌گیرد:
            </p>
            <ul>
                <li><strong>کل مشتریان فعال:</strong> تعداد کل مشتریانی که حداقل یک سفارش ثبت کرده‌اند.</li>
                <li><strong>مشتری ویژه ماه:</strong> مشتری با بیشترین مبلغ خرید در ماه جاری.</li>
                <li><strong>رشد مشتریان جدید:</strong> لیست مشتریانی که در ۷ روز اخیر ثبت شده‌اند.</li>
                <li><strong>نرخ بازگشت مشتری:</strong> درصد مشتریانی که حداقل ۲، ۳ یا ۵ بار به رستوران بازگشته‌اند.</li>
                <li><strong>بهترین مشتریان:</strong> رتبه‌بندی مشتریان بر اساس مبلغ کل خرید.</li>
            </ul>

            <h3>  نمودار روند فروش و جذب مشتری</h3>
            <p>
                نمودار تعاملی هفتگی، به شما نشان می‌دهد که در ۷ روز اخیر، چه تعداد مشتری جدید جذب شده‌اند و میزان فروش شما چقدر بوده است. این داده‌ها به شما کمک می‌کند تا تاثیر کمپین‌های بازاریابی و رویدادهای خاص را بر جذب مشتری اندازه‌گیری کنید.
            </p>

            <h3>  فیلتر و جستجوی پیشرفته</h3>
            <p>
                با استفاده از ابزارهای جستجو و فیلتر، می‌توانید مشتریان را بر اساس:
            </p>
            <ul>
                <li><strong>بازه زمانی</strong> (همه زمان‌ها، امروز، هفته گذشته، ماه جاری، سال گذشته)</li>
                <li><strong>رتبه‌بندی</strong> (بیشترین مبلغ خرید، بیشترین تعداد سفارش، بیشترین روزهای حضور)</li>
                <li><strong>جستجوی عمومی</strong> (نام، شماره موبایل)</li>
            </ul>
            <p>جستجو و مرتب‌سازی کنید و دقیقاً مشتریانی را که می‌خواهید ببینید.</p>

            <h3>  مدیریت کامل پروفایل مشتریان</h3>
            <p>
                شما می‌توانید اطلاعات هر مشتری را:
            </p>
            <ul>
                <li><strong>مشاهده کنید:</strong> نام، شماره موبایل، تاریخ عضویت، تعداد سفارش‌ها، مبلغ کل خرید، میانگین خرید، آخرین تاریخ مراجعه و توضیحات.</li>
                <li><strong>ویرایش کنید:</strong> اطلاعات مشتری را به‌روزرسانی کنید.</li>
                <li><strong>حذف کنید:</strong> در صورت نیاز، مشتری و تمام تاریخچه او را حذف نمایید.</li>
            </ul>

            <div class="feature-grid-article">
                <div class="feature-card-article">
                    <i class="fa-solid fa-user-plus"></i>
                    <h6>ثبت خودکار</h6>
                    <p>ثبت مشتری هنگام سفارش توسط گارسون</p>
                </div>
                <div class="feature-card-article">
                    <i class="fa-solid fa-chart-pie"></i>
                    <h6>تحلیل پیشرفته</h6>
                    <p>رفتار خرید، نرخ بازگشت و رتبه‌بندی</p>
                </div>
                <div class="feature-card-article">
                    <i class="fa-solid fa-chart-line"></i>
                    <h6>روند جذب</h6>
                    <p>نمودار هفتگی فروش و مشتریان جدید</p>
                </div>
                <div class="feature-card-article">
                    <i class="fa-solid fa-filter"></i>
                    <h6>فیلتر و جستجو</h6>
                    <p>جستجوی پیشرفته بر اساس بازه و رتبه</p>
                </div>
                <div class="feature-card-article">
                    <i class="fa-solid fa-crown"></i>
                    <h6>شناسایی ویژه‌ها</h6>
                    <p>مشتریان وفادار  را پیدا کنید</p>
                </div>
               
            </div>

            <h2> مزایای استفاده از باشگاه مشتریان رستورانیار</h2>
            <ul>
                <li><strong>افزایش وفاداری مشتریان:</strong> با شناخت مشتریان، می‌توانید پیشنهادات ویژه و تخفیف‌های شخصی‌سازی‌شده ارائه دهید.</li>
                <li><strong>بهبود استراتژی بازاریابی:</strong> با تحلیل داده‌ها، کمپین‌های موثرتری طراحی کنید.</li>
                <li><strong>افزایش فروش:</strong> مشتریان وفادار به طور میانگین ۶۷ درصد بیشتر از مشتریان جدید هزینه می‌کنند.</li>
                <li><strong>کاهش هزینه‌های جذب مشتری:</strong> نگهداشت مشتریان موجود به مراتب ارزان‌تر از جذب مشتری جدید است.</li>
                <li><strong>تصمیم‌گیری مبتنی بر داده:</strong> دیگر نیازی به حدس و گمان نیست؛ همه تصمیمات بر اساس داده‌های واقعی گرفته می‌شوند.</li>
            </ul>

            <h2>چگونه باشگاه مشتریان رستورانیار را راه‌اندازی کنیم؟</h2>
            <p>
                راه‌اندازی باشگاه مشتریان با رستورانیار بسیار ساده و سریع است:
            </p>
            <ol>
                <li><strong>ثبت‌نام در رستورانیار</strong> و ایجاد حساب کاربری.</li>
                <li><strong>گارسون‌ها  و صندوقدار، هنگام ثبت سفارش، اطلاعات مشتری را وارد می‌کنند.</strong> سیستم به صورت خودکار مشتری را ثبت می‌کند.</li>
                <li><strong>داشبورد مدیریت</strong> را باز کنید و اطلاعات تحلیلی را مشاهده نمایید.</li>
                <li><strong>از فیلترها و جستجو</strong> برای یافتن مشتریان خاص استفاده کنید.</li>
                <li><strong>بر اساس داده‌ها، استراتژی‌های بازاریابی خود را طراحی کنید.</strong></li>
            </ol>
            <p>
                تمام این مراحل در محیطی ساده و کاربرپسند انجام می‌شود و تیم پشتیبانی رستورانیار در تمام مسیر همراه شماست.
            </p>

            <!-- ===== باکس CTA ===== -->
            <div class="cta-box">
                <h3 class="fw-bold">همین حالا باشگاه مشتریان خود را راه‌اندازی کنید</h3>
                <p style="color: #fff; opacity: 0.9;">با اشتراک تستی رایگان، باشگاه مشتریان هوشمند رستورانیار را امتحان کنید و مشتریان خود را بهتر بشناسید.</p>
                <a href="/Home/ManagerLogin" class="btn btn-light btn-lg px-5">شروع کنید</a>
                <div class="d-flex justify-content-center gap-4 mt-4 flex-wrap">
                    <span><i class="fa-regular fa-circle-check ms-1"></i> تست رایگان</span>
                    <span><i class="fa-regular fa-circle-check ms-1"></i> ثبت خودکار مشتری</span>
                    <span><i class="fa-regular fa-circle-check ms-1"></i> تحلیل پیشرفته</span>
                </div>
            </div>

        </div>
    </section>

