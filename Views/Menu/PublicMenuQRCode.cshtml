@{
    ViewData["Title"] = "QR Code منوی عمومی";
}

@section Styles {
    <link rel="stylesheet" href="~/css/public-menu-qrcode.css" asp-append-version="true" />
}

<div class="container d-flex justify-content-center align-items-center public-qr-page px-3">
    <div class="qr-card text-center shadow-lg p-4 rounded-4 bg-white w-100">
        <h2 class="fw-bold mb-3">منوی عمومی @ViewBag.RestaurantName</h2>
        <p class="text-muted mb-4">برای مشاهده منو، این QR Code را اسکن کنید:</p>

        <div class="qr-wrapper mb-4">
            <img id="qrImage"
                 src="data:image/png;base64,@ViewBag.QRCodeImage"
                 alt="QR Code منوی عمومی"
                 class="img-fluid" />
        </div>

        @* <p class="text-muted">یا این لینک را باز کنید:</p> *@
        @* <a href="@ViewBag.MenuUrl" target="_blank" class="d-block mb-4">@ViewBag.MenuUrl</a> *@
        <span/>
        <span/>
        <div class="action-buttons d-flex flex-column flex-md-row gap-2 justify-content-center">
            <button onclick="window.print()" class="btn btn-primary py-2 flex-fill">
                <i class="fa-solid fa-print ms-1"></i> چاپ
            </button>
            <button onclick="window.downloadQR()" class="btn btn-outline-secondary py-2 flex-fill">
                <i class="fa-solid fa-download ms-1"></i> دانلود QR
            </button>
            <a href="@ViewBag.MenuUrl" target="_blank" class="btn btn-success py-2 flex-fill">
                <i class="fa-solid fa-globe ms-1"></i> مشاهده منو
            </a>
        </div>
    </div>
</div>

<script>
    window.downloadQR = function () {
        var qrImg = document.getElementById("qrImage");
        var link = document.createElement("a");
        link.href = qrImg.src;
        link.download = "QRCode_Menu.png";
        link.click();
    };

    function initPublicMenuQRCodePage() {
        window.downloadQR = window.downloadQR;
    }

    window.initPublicMenuQRCodePage = initPublicMenuQRCodePage;
</script>
